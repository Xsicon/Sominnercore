@using System.Text
@using KobNeti.Services.Support
@using Microsoft.JSInterop
@inject SupportApiClient SupportApi
@inject IJSRuntime JS

<div class="kn-s3-page">
    <div class="kn-s3-head">
        <div>
            <p class="kn-s3-eyebrow">People Ops</p>
            <h2>Payroll Runs</h2>
            <p>Approved time only · @SupportApi.DisplayName</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(msg))
    {
        <p class="kn-s3-alert">@msg</p>
    }

    @if (SupportApi.IsPlatformAdmin)
    {
        <div class="kn-s4-admin-panel">
            <h4>Pay rates</h4>
            <div class="kn-s4-create-bar" style="margin-bottom:0.75rem;">
                <input class="kn-s3-field__select" style="width:6rem;" type="number" step="0.01" @bind="rateAmount" disabled="@busy" />
                <input class="kn-s3-field__select" style="width:10rem;" placeholder="Role (e.g. engineer)" @bind="rateRole" disabled="@busy" />
                <button type="button" class="kn-btn kn-btn--primary kn-btn--sm" disabled="@busy" @onclick="SaveRate">Save rate</button>
            </div>
            @if (rates.Count > 0)
            {
                <ul class="kn-s3-hint" style="margin:0;padding-left:1.1rem;">
                    @foreach (var r in rates)
                    {
                        <li>@r.HourlyRate @r.Currency · @(r.Role ?? r.UserId?.ToString() ?? "default")</li>
                    }
                </ul>
            }
        </div>

        <div class="kn-s4-admin-panel">
            <h4>New pay period</h4>
            <div class="kn-s4-create-bar" style="margin-bottom:0;">
                <input class="kn-s3-field__select" placeholder="Label" @bind="periodLabel" disabled="@busy" />
                <input class="kn-s3-field__select" type="date" @bind="periodStart" disabled="@busy" />
                <input class="kn-s3-field__select" type="date" @bind="periodEnd" disabled="@busy" />
                <button type="button" class="kn-btn kn-btn--primary kn-btn--sm" disabled="@busy" @onclick="CreatePeriod">Create period</button>
            </div>
        </div>
    }

    @if (loading)
    {
        <div class="kn-s3-loading-block" role="status" aria-busy="true">
            <span class="kn-s3-spinner" aria-hidden="true"></span>
            <p>Loading pay periods…</p>
        </div>
    }
    else if (periods.Count == 0)
    {
        <p class="kn-s3-empty">No pay periods yet.</p>
    }
    else
    {
        <div class="kn-s3-summary-row">
            <div class="kn-s3-summary kn-s3-summary--warn">
                <div class="kn-s3-metric__label">Open</div>
                <div class="kn-s3-metric__value">@periods.Count(p => p.Status is "open" or "calculated")</div>
            </div>
            <div class="kn-s3-summary">
                <div class="kn-s3-metric__label">Approved</div>
                <div class="kn-s3-metric__value">@periods.Count(p => p.Status is "approved" or "exported")</div>
            </div>
        </div>

        @foreach (var p in periods.OrderByDescending(x => x.EndsOn))
        {
            var statusStyle = GetStatusStyle(p.Status);
            <article class="kn-s4-pay-period">
                <div class="kn-s4-pay-period__head">
                    <strong>@p.Label</strong>
                    <span class="kn-chip" style="background:@statusStyle.Bg;color:@statusStyle.Text">@p.Status</span>
                    <span class="kn-chip kn-chip--neutral">@p.StartsOn → @p.EndsOn</span>
                    <span class="kn-chip kn-chip--neutral">@p.TotalMinutes min · @p.TotalAmount @p.Currency</span>
                </div>
                <div class="kn-s3-actions">
                    @if (SupportApi.IsPlatformAdmin)
                    {
                        @if (p.Status is "open" or "calculated")
                        {
                            <button type="button" class="kn-btn kn-btn--outline kn-btn--sm" disabled="@busy" @onclick="() => Calculate(p.Id)">Calculate</button>
                        }
                        @if (p.Status == "calculated")
                        {
                            <button type="button" class="kn-btn kn-btn--primary kn-btn--sm" disabled="@busy" @onclick="() => Submit(p.Id)">Submit for approval</button>
                        }
                    }
                    @if (p.Status is "approved" or "exported")
                    {
                        <button type="button" class="kn-btn kn-btn--outline kn-btn--sm" disabled="@busy" @onclick="() => Export(p)">Export CSV</button>
                    }
                </div>
            </article>
        }
    }
</div>

@code {
    private bool loading = true;
    private bool busy;
    private string? msg;
    private List<PayRateDto> rates = [];
    private List<PayPeriodDto> periods = [];
    private decimal rateAmount = 50;
    private string rateRole = "engineer";
    private string periodLabel = "";
    private DateTime? periodStart = DateTime.UtcNow.Date.AddDays(-14);
    private DateTime? periodEnd = DateTime.UtcNow.Date;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        loading = true;
        var r = await SupportApi.GetPayRatesAsync();
        var p = await SupportApi.GetPayPeriodsAsync();
        rates = r.Success ? r.Data ?? [] : [];
        periods = p.Success ? p.Data ?? [] : [];
        loading = false;
    }

    private async Task SaveRate()
    {
        busy = true;
        var result = await SupportApi.SavePayRateAsync(rateAmount, rateRole);
        msg = result.Success ? "Rate saved" : result.Message;
        await Load();
        busy = false;
    }

    private async Task CreatePeriod()
    {
        if (string.IsNullOrWhiteSpace(periodLabel) || periodStart is null || periodEnd is null) return;
        busy = true;
        var result = await SupportApi.CreatePayPeriodAsync(
            periodLabel.Trim(),
            DateOnly.FromDateTime(periodStart.Value),
            DateOnly.FromDateTime(periodEnd.Value));
        msg = result.Success ? "Period created" : result.Message;
        if (result.Success) periodLabel = "";
        await Load();
        busy = false;
    }

    private async Task Calculate(Guid id)
    {
        busy = true;
        var result = await SupportApi.CalculatePayPeriodAsync(id);
        msg = result.Success ? $"Calculated {result.Data?.TotalAmount}" : result.Message;
        await Load();
        busy = false;
    }

    private async Task Submit(Guid id)
    {
        busy = true;
        var result = await SupportApi.SubmitPayPeriodAsync(id);
        msg = result.Success ? "Submitted for approval" : result.Message;
        await Load();
        busy = false;
    }

    private async Task Export(PayPeriodDto p)
    {
        busy = true;
        var (ok, csv, message) = await SupportApi.DownloadPayPeriodCsvAsync(p.Id);
        if (!ok || csv is null)
        {
            msg = message;
        }
        else
        {
            var b64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(csv));
            await JS.InvokeVoidAsync(
                "eval",
                $"(function(){{const b=atob('{b64}');const u=new Uint8Array(b.length);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([u],{{type:'text/csv'}}));a.download='payroll-{p.Id:N}.csv';a.click();}})();");
            msg = "CSV downloaded";
            await Load();
        }
        busy = false;
    }

    private static (string Bg, string Text) GetStatusStyle(string status) => status switch
    {
        "calculated" => ("#DBEAFE", "#1E3A8A"),
        "approved" or "exported" => ("#D1FAE5", "#065F46"),
        "submitted" => ("#FEF3C7", "#92400E"),
        _ => ("#F3F4F6", "#374151")
    };
}
