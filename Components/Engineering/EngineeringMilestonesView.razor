@using KobNeti.Services.Support
@inject SupportApiClient SupportApi

<div class="kn-s3-page">
    <div class="kn-s3-head">
        <div>
            <p class="kn-s3-eyebrow">Engineering</p>
            <h2>Project Roadmap</h2>
            <p>Milestones and calendar targets for @SupportApi.DisplayName</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <p class="kn-s3-alert">@error</p>
    }

    @if (loading)
    {
        <div class="kn-s3-loading-block" role="status" aria-busy="true">
            <span class="kn-s3-spinner" aria-hidden="true"></span>
            <p>Loading milestones…</p>
        </div>
    }
    else
    {
        <div class="kn-s4-create-bar">
            <input class="kn-s3-field__select kn-s4-create-bar__title"
                   placeholder="Milestone title…"
                   @bind="newTitle"
                   @bind:event="oninput"
                   disabled="@saving" />
            <input class="kn-s3-field__select" type="date" @bind="newTarget" disabled="@saving" />
            <button type="button"
                    class="kn-btn kn-btn--primary kn-btn--sm"
                    disabled="@(saving || string.IsNullOrWhiteSpace(newTitle))"
                    @onclick="CreateAsync">
                Add milestone
            </button>
        </div>

        <div class="kn-s3-summary-row">
            <div class="kn-s3-summary">
                <div class="kn-s3-metric__label">Planned</div>
                <div class="kn-s3-metric__value">@milestones.Count(m => m.Status == "planned")</div>
            </div>
            <div class="kn-s3-summary kn-s3-summary--warn">
                <div class="kn-s3-metric__label">In progress</div>
                <div class="kn-s3-metric__value">@milestones.Count(m => m.Status is "in_progress" or "active")</div>
            </div>
            <div class="kn-s3-summary">
                <div class="kn-s3-metric__label">Completed</div>
                <div class="kn-s3-metric__value">@milestones.Count(m => m.Status is "done" or "completed")</div>
            </div>
        </div>

        <h3 class="kn-s3-section-title">Roadmap</h3>
        @if (milestones.Count == 0)
        {
            <p class="kn-s3-empty">No milestones yet. Add one with a target date to sync to the calendar.</p>
        }
        else
        {
            <div class="kn-s4-milestone-list">
                @foreach (var m in milestones.OrderBy(x => x.TargetDate).ThenBy(x => x.SortOrder))
                {
                    var statusStyle = GetStatusStyle(m.Status);
                    <article class="kn-s4-milestone-card">
                        <div class="kn-s4-milestone-card__head">
                            <span class="kn-s4-milestone-card__title">@m.Title</span>
                            <div class="kn-s4-milestone-card__chips">
                                <span class="kn-chip" style="background:@statusStyle.Bg;color:@statusStyle.Text">@GetStatusLabel(m.Status)</span>
                                <span class="kn-chip kn-chip--neutral">@(m.TargetDate?.ToString("MMM d, yyyy") ?? "No date")</span>
                                <span class="kn-chip kn-chip--neutral">@m.TaskCount tasks</span>
                                @if (m.CalendarEventId.HasValue)
                                {
                                    <span class="kn-chip kn-chip--neutral">On calendar</span>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(m.Description))
                        {
                            <p class="kn-s3-hint">@m.Description</p>
                        }
                    </article>
                }
            </div>
        }

        <h3 class="kn-s3-section-title">Calendar events</h3>
        @if (events.Count == 0)
        {
            <p class="kn-s3-empty kn-s3-empty--compact">No calendar events from milestones yet.</p>
        }
        else
        {
            <div class="kn-s3-table-wrap">
                <table class="kn-s3-table">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in events.OrderBy(x => x.StartsAt))
                        {
                            <tr>
                                <td class="kn-s3-table__subject">@e.Title</td>
                                <td>@e.StartsAt.ToLocalTime().ToString("g")</td>
                                <td>@e.EventType</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private bool loading = true;
    private bool saving;
    private string? error;
    private List<MilestoneDto> milestones = [];
    private List<CalendarEventDto> events = [];
    private string newTitle = "";
    private DateTime? newTarget;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            var ms = await SupportApi.GetMilestonesAsync();
            var cal = await SupportApi.GetCalendarEventsAsync();
            if (!ms.Success) { error = ms.Message; milestones = []; }
            else milestones = ms.Data ?? [];
            events = cal.Success ? cal.Data ?? [] : [];
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;
        saving = true;
        try
        {
            DateOnly? target = newTarget.HasValue ? DateOnly.FromDateTime(newTarget.Value) : null;
            var result = await SupportApi.CreateMilestoneAsync(new CreateMilestoneRequest
            {
                Title = newTitle.Trim(),
                TargetDate = target,
                Status = "planned"
            });
            if (result.Success)
            {
                newTitle = "";
                newTarget = null;
                await LoadAsync();
            }
            else error = result.Message;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }

    private static string GetStatusLabel(string status) => status switch
    {
        "in_progress" or "active" => "In Progress",
        "at_risk" => "At Risk",
        "done" or "completed" => "Done",
        _ => "Planned"
    };

    private static (string Bg, string Text) GetStatusStyle(string status) => status switch
    {
        "in_progress" or "active" => ("#DBEAFE", "#1E3A8A"),
        "at_risk" => ("#FEE2E2", "#991B1B"),
        "done" or "completed" => ("#D1FAE5", "#065F46"),
        _ => ("#F3F4F6", "#374151")
    };
}
