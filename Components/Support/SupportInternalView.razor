@using KobNeti.Services.Support
@using Microsoft.AspNetCore.Components.Web
@inject SupportApiClient SupportApi

<div class="kn-s3-page kn-s3-page--internal">
    <div class="kn-s3-head">
        <div>
            <p class="kn-s3-eyebrow">Team Collaboration</p>
            <h2>Internal Chat</h2>
            <p>Private channels for agents — not visible to customers</p>
        </div>
        <div class="kn-s3-actions">
            <button type="button" class="kn-btn kn-btn--outline kn-btn--sm" disabled="@busy" @onclick="FocusNewChannel">
                <span class="material-symbols-outlined" aria-hidden="true">add</span>
                New channel
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(msg))
    {
        <p class="kn-s3-alert">@msg</p>
    }

    <div class="kn-s3-internal">
        <aside class="kn-s3-internal__sidebar">
            <div class="kn-s3-search kn-s3-internal__search">
                <span class="material-symbols-outlined" aria-hidden="true">search</span>
                <input placeholder="Search channels…"
                       @bind="channelSearch"
                       @bind:event="oninput" />
            </div>

            <div class="kn-s3-internal__section-head">
                <span>Channels</span>
                <button type="button"
                        class="kn-s3-internal__icon-btn"
                        title="Create channel"
                        disabled="@busy"
                        @onclick="FocusNewChannel">
                    <span class="material-symbols-outlined" aria-hidden="true">add</span>
                </button>
            </div>

            <div class="kn-s3-internal__new">
                <input @ref="newChannelInputRef"
                       class="kn-s3-field__select"
                       placeholder="New channel name"
                       @bind="newChannel"
                       @onkeydown="OnNewChannelKey" />
                <button type="button"
                        class="kn-btn kn-btn--primary kn-btn--sm"
                        disabled="@(busy || string.IsNullOrWhiteSpace(newChannel))"
                        @onclick="CreateChannel">
                    Create
                </button>
            </div>

            <div class="kn-s3-internal__channels">
                @foreach (var c in FilteredChannels)
                {
                    <button type="button"
                            class="kn-s3-internal__channel @(selected?.Id == c.Id ? "is-active" : "")"
                            @onclick="() => SelectChannel(c)">
                        <span class="kn-s3-internal__channel-hash material-symbols-outlined" aria-hidden="true">tag</span>
                        <span class="kn-s3-internal__channel-name">@c.Name</span>
                    </button>
                }
                @if (!FilteredChannels.Any())
                {
                    <p class="kn-s3-empty kn-s3-internal__empty">No channels yet.</p>
                }
            </div>
        </aside>

        <section class="kn-s3-internal__room">
            @if (selected is null)
            {
                <div class="kn-s3-internal__placeholder">
                    <span class="material-symbols-outlined" aria-hidden="true">forum</span>
                    <p>Select or create a channel to start chatting.</p>
                </div>
            }
            else
            {
                <header class="kn-s3-internal__room-head">
                    <div class="kn-s3-internal__room-title">
                        <span class="kn-s3-internal__room-icon material-symbols-outlined" aria-hidden="true">tag</span>
                        <div>
                            <h3>#@selected.Name</h3>
                            <p>Team-only channel for @SupportApi.DisplayName</p>
                        </div>
                    </div>
                </header>

                <div class="kn-s3-internal__messages">
                    @if (messages.Count == 0)
                    {
                        <p class="kn-s3-empty">No messages yet. Say hello.</p>
                    }
                    else
                    {
                        @foreach (var m in messages)
                        {
                            <article class="kn-s3-internal__msg">
                                <div class="kn-s3-internal__avatar" aria-hidden="true">@GetInitials(m.SenderName)</div>
                                <div class="kn-s3-internal__msg-body">
                                    <div class="kn-s3-internal__msg-meta">
                                        <strong>@m.SenderName</strong>
                                        <time datetime="@m.CreatedAt.ToString("O")">@m.CreatedAt.ToLocalTime().ToString("g")</time>
                                    </div>
                                    <p>@m.Body</p>
                                </div>
                            </article>
                        }
                    }
                </div>

                <footer class="kn-s3-internal__composer">
                    <textarea class="kn-s3-field__select kn-s3-internal__composer-input"
                              rows="2"
                              placeholder="Message #@selected.Name…"
                              @bind="draft"
                              @onkeydown="OnKey"></textarea>
                    <button type="button"
                            class="kn-btn kn-btn--primary kn-btn--sm"
                            disabled="@(busy || string.IsNullOrWhiteSpace(draft))"
                            @onclick="Send">
                        <span class="material-symbols-outlined" aria-hidden="true">send</span>
                        Send
                    </button>
                </footer>
            }
        </section>
    </div>
</div>

@code {
    private List<ImChannelDto> channels = [];
    private List<ImMessageDto> messages = [];
    private ImChannelDto? selected;
    private string newChannel = "";
    private string channelSearch = "";
    private string draft = "";
    private string? msg;
    private bool busy;
    private ElementReference newChannelInputRef;

    private IEnumerable<ImChannelDto> FilteredChannels =>
        string.IsNullOrWhiteSpace(channelSearch)
            ? channels
            : channels.Where(c => c.Name.Contains(channelSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await LoadChannels();

    private async Task FocusNewChannel()
    {
        try
        {
            await newChannelInputRef.FocusAsync();
        }
        catch (Exception)
        {
        }
    }

    private async Task LoadChannels()
    {
        var r = await SupportApi.GetImChannelsAsync();
        channels = r.Data ?? [];
        if (!r.Success) msg = r.Message;
        if (selected is not null)
        {
            selected = channels.FirstOrDefault(c => c.Id == selected.Id);
            if (selected is not null)
                await LoadMessages();
            else
                messages = [];
        }
    }

    private async Task CreateChannel()
    {
        if (string.IsNullOrWhiteSpace(newChannel)) return;
        busy = true;
        msg = null;
        try
        {
            var r = await SupportApi.CreateImChannelAsync(newChannel.Trim());
            if (!r.Success) { msg = r.Message; return; }
            newChannel = "";
            await LoadChannels();
            if (r.Data is not null)
                await SelectChannel(r.Data);
        }
        finally { busy = false; }
    }

    private async Task SelectChannel(ImChannelDto c)
    {
        selected = c;
        msg = null;
        await LoadMessages();
    }

    private async Task LoadMessages()
    {
        if (selected is null) return;
        var r = await SupportApi.GetImMessagesAsync(selected.Id);
        messages = r.Data ?? [];
        if (!r.Success) msg = r.Message;
    }

    private async Task Send()
    {
        if (selected is null || string.IsNullOrWhiteSpace(draft)) return;
        busy = true;
        msg = null;
        try
        {
            var r = await SupportApi.SendImMessageAsync(selected.Id, draft.Trim());
            if (!r.Success) { msg = r.Message; return; }
            draft = "";
            await LoadMessages();
        }
        finally { busy = false; }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await Send();
    }

    private async Task OnNewChannelKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await CreateChannel();
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
        return parts[0].Length >= 2 ? parts[0][..2].ToUpperInvariant() : parts[0].ToUpperInvariant();
    }
}
