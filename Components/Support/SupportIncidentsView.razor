@using KobNeti.Services.Support
@inject SupportApiClient SupportApi
@implements IDisposable

<div class="kn-s3-page">
    <div class="kn-s3-head">
        <div>
            <p class="kn-s3-eyebrow">Customer Support</p>
            <h2>Incidents</h2>
            <p>Track escalations, update response status, and capture postmortems</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(loadError))
    {
        <p class="kn-s3-alert">@loadError</p>
    }

    @if (isLoading)
    {
        <div class="kn-s3-loading-block kn-s3-loading-block--center" role="status" aria-busy="true">
            <span class="kn-s3-spinner kn-s3-spinner--lg" aria-hidden="true"></span>
            <p>Loading incidents…</p>
        </div>
    }
    else
    {
        <div class="kn-s3-summary-row">
            <div class="kn-s3-summary kn-s3-summary--danger">
                <div class="kn-s3-metric__label">Active</div>
                <div class="kn-s3-metric__value">@incidents.Count(i => i.Status is "open" or "investigating")</div>
            </div>
            <div class="kn-s3-summary kn-s3-summary--warn">
                <div class="kn-s3-metric__label">Mitigated</div>
                <div class="kn-s3-metric__value">@incidents.Count(i => i.Status == "mitigated")</div>
            </div>
            <div class="kn-s3-summary">
                <div class="kn-s3-metric__label">Closed out</div>
                <div class="kn-s3-metric__value">@incidents.Count(i => i.Status is "resolved" or "closed")</div>
            </div>
        </div>

        <div class="kn-s3-toolbar">
            <div class="kn-s3-search">
                <span class="material-symbols-outlined" aria-hidden="true">search</span>
                <input placeholder="Search by number, title, or commander…"
                       @bind="search"
                       @bind:event="oninput" />
            </div>
            <div class="kn-s3-pills">
                <button type="button"
                        class="kn-s3-pill @(string.IsNullOrEmpty(filterStatus) ? "is-active" : "")"
                        @onclick="() => filterStatus = null">
                    All (@incidents.Count)
                </button>
                @foreach (var s in StatusFilters)
                {
                    var count = incidents.Count(i => i.Status == s.Key);
                    <button type="button"
                            class="kn-s3-pill @(filterStatus == s.Key ? "is-active" : "")"
                            @onclick="() => filterStatus = s.Key">
                        @s.Label (@count)
                    </button>
                }
            </div>
        </div>

        @if (FilteredIncidents.Any())
        {
            <div class="kn-s3-table-wrap">
                <table class="kn-s3-table">
                    <thead>
                        <tr>
                            <th>Incident</th>
                            <th>Title</th>
                            <th>Severity</th>
                            <th>Status</th>
                            <th>Commander</th>
                            <th>Updated</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in FilteredIncidents)
                        {
                            var sev = GetSeverityStyle(i.Severity);
                            var stat = GetStatusStyle(i.Status);
                            <tr class="@(activeIncident?.Id == i.Id ? "is-active" : "")"
                                @onclick="() => OpenDrawerAsync(i)">
                                <td>@i.IncidentNumber</td>
                                <td class="kn-s3-table__subject">@i.Title</td>
                                <td>
                                    <span class="kn-chip" style="background:@sev.Bg;color:@sev.Text">@GetSeverityLabel(i.Severity)</span>
                                </td>
                                <td>
                                    <span class="kn-chip" style="background:@stat.Bg;color:@stat.Text">@GetStatusLabel(i.Status)</span>
                                </td>
                                <td>@(i.CommanderName ?? "—")</td>
                                <td>@(i.UpdatedAt?.ToLocalTime().ToString("g") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="kn-s3-empty">
                <p>No incidents match your filters.</p>
                <p class="kn-s3-hint">Escalate from Live Chat or from a ticket drawer to create one.</p>
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(toast))
    {
        <div class="kn-s3-toast @(toastIsError ? "kn-s3-toast--error" : "")">@toast</div>
    }

    @if (activeIncident is not null)
    {
        <button type="button" class="kn-s3-drawer-backdrop" aria-label="Close incident drawer" @onclick="CloseDrawer"></button>
        <SupportIncidentDrawer Incident="activeIncident"
                               IsLoading="drawerLoading"
                               OnClose="CloseDrawer"
                               OnIncidentUpdated="HandleIncidentUpdated"
                               OnNotify="HandleDrawerNotify" />
    }
</div>

@code {
    private static readonly (string Key, string Label)[] StatusFilters =
    [
        ("open", "Open"),
        ("investigating", "Investigating"),
        ("mitigated", "Mitigated"),
        ("resolved", "Resolved"),
        ("closed", "Closed")
    ];

    private bool isLoading = true;
    private bool drawerLoading;
    private string? loadError;
    private string? filterStatus;
    private string search = "";
    private string? toast;
    private bool toastIsError;
    private List<IncidentDto> incidents = [];
    private IncidentDto? activeIncident;
    private System.Threading.Timer? toastTimer;

    private IEnumerable<IncidentDto> FilteredIncidents
    {
        get
        {
            IEnumerable<IncidentDto> rows = incidents;
            if (!string.IsNullOrWhiteSpace(filterStatus))
                rows = rows.Where(i => i.Status == filterStatus);
            if (!string.IsNullOrWhiteSpace(search))
            {
                var q = search.Trim();
                rows = rows.Where(i =>
                    i.IncidentNumber.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || i.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || (i.CommanderName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return rows.OrderByDescending(i => i.UpdatedAt ?? i.CreatedAt);
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            var result = await SupportApi.GetIncidentsAsync();
            if (!result.Success)
            {
                loadError = string.IsNullOrWhiteSpace(result.Message)
                    ? "Failed to load incidents."
                    : result.Message;
                incidents = [];
            }
            else
            {
                incidents = result.Data ?? [];
            }
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            incidents = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenDrawerAsync(IncidentDto row)
    {
        activeIncident = row;
        drawerLoading = true;
        StateHasChanged();

        try
        {
            var result = await SupportApi.GetIncidentAsync(row.Id);
            if (result.Success && result.Data != null)
            {
                activeIncident = result.Data;
                SyncIncidentInList(result.Data);
            }
            else
            {
                ShowToast(
                    string.IsNullOrWhiteSpace(result.Message)
                        ? "Failed to load incident details."
                        : result.Message,
                    isError: true);
            }
        }
        catch (Exception ex)
        {
            ShowToast(ex.Message, isError: true);
        }
        finally
        {
            drawerLoading = false;
        }
    }

    private void CloseDrawer() => activeIncident = null;

    private Task HandleIncidentUpdated(IncidentDto updated)
    {
        SyncIncidentInList(updated);
        activeIncident = updated;
        return Task.CompletedTask;
    }

    private Task HandleDrawerNotify((string Message, bool IsError) notification)
    {
        ShowToast(notification.Message, notification.IsError);
        return Task.CompletedTask;
    }

    private void SyncIncidentInList(IncidentDto updated)
    {
        var idx = incidents.FindIndex(i => i.Id == updated.Id);
        if (idx >= 0)
            incidents[idx] = updated;
    }

    private void ShowToast(string message, bool isError = false)
    {
        toast = message;
        toastIsError = isError;
        toastTimer?.Dispose();
        toastTimer = new System.Threading.Timer(_ =>
        {
            toast = null;
            _ = InvokeAsync(StateHasChanged);
        }, null, 3200, Timeout.Infinite);
    }

    private static string GetStatusLabel(string status) => status switch
    {
        "investigating" => "Investigating",
        "mitigated" => "Mitigated",
        "resolved" => "Resolved",
        "closed" => "Closed",
        _ => "Open"
    };

    private static string GetSeverityLabel(string severity) => severity switch
    {
        "sev1" => "SEV-1",
        "sev2" => "SEV-2",
        "sev3" => "SEV-3",
        "sev4" => "SEV-4",
        _ => severity.ToUpperInvariant()
    };

    private static (string Bg, string Text) GetStatusStyle(string status) => status switch
    {
        "investigating" => ("#FEF3C7", "#92400E"),
        "mitigated" => ("#EDE9FE", "#5B21B6"),
        "resolved" => ("#D1FAE5", "#065F46"),
        "closed" => ("#E5E7EB", "#374151"),
        _ => ("#FEE2E2", "#991B1B")
    };

    private static (string Bg, string Text) GetSeverityStyle(string severity) => severity switch
    {
        "sev1" => ("#FEE2E2", "#991B1B"),
        "sev2" => ("#FFEDD5", "#9A3412"),
        "sev3" => ("#FEF3C7", "#92400E"),
        _ => ("#E0E7FF", "#3730A3")
    };

    public void Dispose() => toastTimer?.Dispose();
}
