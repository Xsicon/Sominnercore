@using Microsoft.AspNetCore.Components.Web
@using KobNeti.Services.Support
@inject SupportApiClient SupportApi
@implements IDisposable

<div @onkeydown="HandleWindowKeyDown" class="kn-s3-kb-panel-root">
<aside class="kn-s3-kb-panel @(ShowHeader ? "" : "kn-s3-kb-panel--embedded")">
    @if (ShowHeader)
    {
        <header class="kn-s3-kb-panel__header">
            <div>
                <p class="kn-s3-eyebrow">Quick help</p>
                <h3 class="kn-s3-drawer__title">Knowledge Base · @SupportApi.DisplayName</h3>
            </div>
            @if (OnClose.HasDelegate)
            {
                <button type="button" class="kn-s3-btn-icon" @onclick="Close" aria-label="Close knowledge base panel">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            }
        </header>
    }

    @if (!string.IsNullOrEmpty(listWarning))
    {
        <p class="kn-s3-hint">@listWarning</p>
    }

    <div class="kn-s3-kb-panel__search">
        <span class="material-symbols-outlined">search</span>
        <input class="kn-s3-kb-panel__search-input"
               placeholder="Search articles while you work…"
               @bind="search"
               @bind:event="oninput" />
    </div>

    <div class="kn-s3-kb-panel__list">
        @if (isLoading)
        {
            <div class="kn-s3-loading-block" role="status" aria-busy="true">
                <span class="kn-s3-spinner" aria-hidden="true"></span>
                <p>Loading articles for @SupportApi.DisplayName…</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(loadError))
        {
            <div class="kn-s3-empty" style="padding:64px 16px">
                <p>@loadError</p>
            </div>
        }
        else
        {
            @foreach (var article in _publishedArticles)
            {
                if (!MatchesSearch(article))
                    continue;

                var meta = HelpCategoryMeta.Get(article.Category);
                <button type="button"
                        class="kn-s3-kb-panel__item"
                        @key="article.Id"
                        @onclick="@(() => OpenArticleAsync(article))">
                    <div class="kn-s3-data-row__icon" style="background:@meta.Bg">
                        @((MarkupString)HelpKbIcons.GetCategoryIconSvg(meta.IconKey, meta.Dot))
                    </div>
                    <div class="kn-s3-data-row__body">
                        <p class="kn-s3-data-row__title">@article.Title</p>
                        <p class="kn-s3-data-row__meta">
                            @article.Category
                            @if (article.Steps.Count > 0)
                            {
                                <span> · @article.Steps.Count-step guide</span>
                            }
                        </p>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#A9B7CC" stroke-width="2" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
            }

            @if (!HasSearchResults)
            {
                <div class="kn-s3-empty" style="padding:2rem 1rem">
                    <svg class="kn-s3-empty__icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
                    <p>@(
                        string.IsNullOrWhiteSpace(search)
                            ? (string.IsNullOrEmpty(loadError)
                                ? $"No published articles for {SupportApi.DisplayName}. Set the product API URL in Settings if articles live in the product API."
                                : loadError)
                            : "No articles match your search.")</p>
                </div>
            }
        }
    </div>
</aside>

@if (ViewArticle != null)
{
    <SupportKbArticleViewPanel Article="ViewArticle"
                               ShowEditButton="false"
                               ShowAgentEngagement="true"
                               OnClose="CloseArticle" />
}
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;

    private IReadOnlyList<HelpArticleDto> _publishedArticles = [];
    private string search = "";
    private HelpArticleDto? ViewArticle { get; set; }
    private bool isLoading = true;
    private string? loadError;
    private string? listWarning;

    private bool HasSearchResults => _publishedArticles.Any(MatchesSearch);

    protected override async Task OnInitializedAsync()
    {
        SupportApi.TenantChanged += OnTenantChanged;
        await LoadArticlesAsync();
    }

    private void OnTenantChanged()
    {
        _ = InvokeAsync(async () =>
        {
            ViewArticle = null;
            search = "";
            await LoadArticlesAsync();
            StateHasChanged();
        });
    }

    private async Task LoadArticlesAsync()
    {
        isLoading = true;
        loadError = null;
        listWarning = null;
        _publishedArticles = [];

        try
        {
            await SupportApi.EnsureAgentTokenAsync();
            var (items, error, truncation) = await SupportPaginatedLoader.LoadAllPagesAsync(
                (page, pageSize) => SupportApi.GetPublishedArticlesPageAsync(page, pageSize));

            if (error != null && items.Count == 0)
            {
                loadError = string.IsNullOrWhiteSpace(error) ? "Failed to load knowledge base." : error;
                return;
            }

            listWarning = truncation;
            _publishedArticles = items
                .OrderBy(a => a.Category)
                .ThenBy(a => a.Title)
                .ToList();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool MatchesSearch(HelpArticleDto article)
    {
        var q = search.Trim();
        if (string.IsNullOrEmpty(q))
            return true;

        return article.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
               article.Content.Contains(q, StringComparison.OrdinalIgnoreCase) ||
               article.Category.Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    private async Task OpenArticleAsync(HelpArticleDto article)
    {
        try
        {
            var result = await SupportApi.GetAdminArticleByIdAsync(article.Id);
            ViewArticle = result.Success && result.Data != null
                ? result.Data
                : article;
        }
        catch
        {
            ViewArticle = article;
        }
    }

    private void CloseArticle() => ViewArticle = null;

    private async Task Close()
    {
        ViewArticle = null;
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    private async Task HandleWindowKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            if (ViewArticle != null)
                CloseArticle();
            else if (OnClose.HasDelegate)
                await Close();
        }
    }

    public void Dispose() => SupportApi.TenantChanged -= OnTenantChanged;
}
