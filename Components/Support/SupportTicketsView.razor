@using KobNeti.Services
@using KobNeti.Services.Support
@using Microsoft.AspNetCore.Components.Web
@inject SupportApiClient SupportApi
@inject SupabaseAuthService AuthService
@implements IDisposable

<div class="kn-s3-page">
    <div class="kn-s3-head">
        <div>
            <p class="kn-s3-eyebrow">Customer Support</p>
            <h2>Support Tickets</h2>
            <p>Route to a team, assign an agent, and resolve fast</p>
        </div>
        <div class="kn-s3-actions">
            <SupportKbButton OnClick="OpenKbPanel" />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(loadError))
    {
        <p class="cs-error-banner">@loadError</p>
    }

    @if (!string.IsNullOrEmpty(listWarning))
    {
        <p class="cs-list-warning">@listWarning</p>
    }

    @if (isLoading)
    {
        <p class="kn-s3-empty">Loading tickets…</p>
    }

    <div class="kn-s3-summary-row">
        <div class="kn-s3-summary">
            <div class="kn-s3-metric__label">Open</div>
            <div class="kn-s3-metric__value">@(stats?.OpenCount ?? tickets.Count(t => t.Status is "new" or "open"))</div>
        </div>
        <div class="kn-s3-summary kn-s3-summary--warn">
            <div class="kn-s3-metric__label">In progress</div>
            <div class="kn-s3-metric__value">@(stats?.InProgressCount ?? tickets.Count(t => t.Status == "in_progress"))</div>
        </div>
        <div class="kn-s3-summary">
            <div class="kn-s3-metric__label">Resolved</div>
            <div class="kn-s3-metric__value">@tickets.Count(t => t.Status == "resolved")</div>
        </div>
    </div>

    <div class="kn-s3-toolbar">
        <div class="kn-s3-search">
            <span class="material-symbols-outlined">search</span>
            <input @ref="searchInputRef"
                   placeholder="Search tickets…"
                   value="@search"
                   @oninput="OnSearchChanged"
                   @onkeydown="HandleSearchKeyDown" />
        </div>
        <div class="kn-s3-pills">
            <button type="button"
                    class="kn-s3-pill @(mineOnly ? "is-active" : "")"
                    @onclick="ToggleMineOnly">
                Assigned to me (@MineCount)
            </button>
            @foreach (var s in StatusFilters)
            {
                <button type="button"
                        class="kn-s3-pill @(filterStatus == s.Key ? "is-active" : "")"
                        @onclick="() => filterStatus = s.Key">
                    @s.Label
                </button>
            }
        </div>
    </div>

    @if (!isLoading && FilteredTickets.Any())
    {
        <div class="kn-s3-table-wrap">
            <table class="kn-s3-table">
                <thead>
                    <tr>
                        <th>Ticket</th>
                        <th>Subject</th>
                        <th>Customer</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Assignee</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in FilteredTickets)
                    {
                        var ss = GetStatusStyle(ticket.Status);
                        var ps = GetPriorityStyle(ticket.Priority);
                        <tr class="@(activeTicket?.Id == ticket.Id ? "is-active" : "")"
                            @onclick="() => OpenTicketDrawerAsync(ticket)">
                            <td>@ticket.TicketNumber</td>
                            <td class="kn-s3-table__subject">@ticket.Subject</td>
                            <td>
                                <div>@ticket.Name</div>
                                @if (!string.IsNullOrWhiteSpace(ticket.Email))
                                {
                                    <small style="color:var(--kn-text-muted);">@ticket.Email</small>
                                }
                            </td>
                            <td>
                                <span class="cs-badge cs-badge--round" style="background:@ss.Bg;color:@ss.Text">
                                    @GetStatusLabel(ticket.Status)
                                </span>
                            </td>
                            <td>
                                <span class="cs-badge cs-badge--round" style="background:@ps.Bg;color:@ps.Text">
                                    @GetPriorityLabel(ticket.Priority)
                                </span>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(ticket.AssignedToName) || ticket.AssignedToName == SupportTicketAgents.Unassigned ? "—" : ticket.AssignedToName)</td>
                            <td>@FormatDate(ticket.CreatedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (!isLoading)
    {
        <div class="kn-s3-empty">
            <p>@(string.IsNullOrEmpty(loadError) ? "No tickets match your filters." : "Unable to load tickets.")</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(toast))
    {
        <div class="cs-toast @(toastIsError ? "cs-toast--error" : "")">
            @if (!toastIsError)
            {
                <svg class="cs-toast__icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.801 10A10 10 0 1 1 17 3.335"/><path d="m9 11 3 3L22 4"/></svg>
            }
            @toast
        </div>
    }

    @if (activeTicket != null)
    {
        <button type="button" class="kn-s3-drawer-backdrop" aria-label="Close ticket drawer" @onclick="CloseTicketDrawer"></button>
        <SupportTicketDrawer Ticket="activeTicket"
                             Shifted="showKbPanel"
                             IsLoading="drawerLoading"
                             OnClose="CloseTicketDrawer"
                             OnOpenKb="OpenKbPanel"
                             OnNotify="HandleDrawerNotify"
                             OnTicketUpdated="HandleTicketUpdated" />
    }

    @if (showKbPanel)
    {
        <button type="button" class="cs-kb-backdrop" @onclick="CloseKbPanel" aria-label="Close knowledge base panel"></button>
        <SupportKbQuickPanel OnClose="CloseKbPanel" />
    }
</div>

@code {
    private List<SupportTicketDto> tickets = [];
    private TicketStatsDto? stats;
    private SupportTicketDto? activeTicket;
    private bool isLoading = true;
    private bool drawerLoading;
    private string? loadError;
    private string? listWarning;
    private string search = string.Empty;
    private string filterStatus = "All";
    private bool mineOnly;
    private bool searchExpanded;
    private ElementReference searchInputRef;
    private string agentName = string.Empty;
    private string? toast;
    private bool toastIsError;
    private bool showKbPanel;
    private System.Threading.Timer? toastTimer;

    private string ShellClass =>
        showKbPanel ? "cs-tab-shell cs-tab-shell--kb-open" : "cs-tab-shell";

    private static readonly (string Key, string Label)[] StatusFilters =
    [
        ("All", "All"),
        ("new", "New"),
        ("in_progress", "In Progress"),
        ("waiting", "Waiting"),
        ("resolved", "Resolved"),
        ("closed", "Closed")
    ];

    private int MineCount =>
        string.IsNullOrWhiteSpace(agentName)
            ? 0
            : tickets.Count(t => t.IsAssignedTo(agentName));

    private IEnumerable<SupportTicketDto> FilteredTickets
    {
        get
        {
            var q = search.Trim().ToLowerInvariant();
            return tickets.Where(t =>
                (string.IsNullOrEmpty(q) ||
                 t.Subject.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                 t.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                 t.Email.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                 t.TicketNumber.Contains(q, StringComparison.OrdinalIgnoreCase)) &&
                (filterStatus == "All" || t.Status == filterStatus) &&
                (!mineOnly || t.IsAssignedTo(agentName)));
        }
    }

    private async Task ToggleSearchAsync()
    {
        if (searchExpanded)
        {
            searchExpanded = false;
            return;
        }

        searchExpanded = true;
        await Task.Yield();
        try
        {
            await searchInputRef.FocusAsync();
        }
        catch (InvalidOperationException)
        {
            // Input not rendered yet.
        }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && string.IsNullOrWhiteSpace(search))
        {
            searchExpanded = false;
            await Task.CompletedTask;
        }
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(search))
            searchExpanded = true;
    }

    private void ClearSearch() => search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        agentName = await AuthService.GetAgentDisplayNameAsync();

        try
        {
            await SupportApi.EnsureAgentTokenAsync();
            await Task.WhenAll(LoadTickets(), LoadStats());
        }
        catch (Exception ex)
        {
            loadError = string.IsNullOrWhiteSpace(ex.Message)
                ? "Failed to load support tickets."
                : ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadTickets()
    {
        var (items, error, truncation) = await SupportPaginatedLoader.LoadAllPagesAsync(
            (page, pageSize) => SupportApi.GetTicketsPageAsync(page, pageSize));

        if (error != null && items.Count == 0)
        {
            tickets = [];
            listWarning = null;
            loadError = string.IsNullOrWhiteSpace(error)
                ? "Failed to load support tickets."
                : error;
            return;
        }

        tickets = items;
        listWarning = truncation;
        loadError = null;
    }

    private async Task LoadStats()
    {
        stats = await SupportApi.GetTicketStatsAsync();
    }

    private async Task OpenTicketDrawerAsync(SupportTicketDto ticket)
    {
        activeTicket = ticket;
        drawerLoading = true;
        StateHasChanged();

        try
        {
            var result = await SupportApi.GetTicketByIdResultAsync(ticket.Id);
            if (result.Success && result.Data != null)
            {
                activeTicket = result.Data;
                SyncTicketInList(result.Data);
            }
            else
            {
                ShowToast(
                    string.IsNullOrWhiteSpace(result.Message)
                        ? "Failed to load ticket details."
                        : result.Message,
                    isError: true);
            }
        }
        catch (Exception ex)
        {
            ShowToast(ex.Message, isError: true);
        }
        finally
        {
            drawerLoading = false;
            StateHasChanged();
        }
    }

    private void CloseTicketDrawer() => activeTicket = null;

    private Task HandleTicketUpdated(SupportTicketDto updated)
    {
        SyncTicketInList(updated);
        activeTicket = updated;
        return Task.CompletedTask;
    }

    private Task HandleDrawerNotify((string Message, bool IsError) notification)
    {
        ShowToast(notification.Message, notification.IsError);
        return Task.CompletedTask;
    }

    private void SyncTicketInList(SupportTicketDto updated)
    {
        var index = tickets.FindIndex(t => t.Id == updated.Id);
        if (index >= 0)
            tickets[index] = updated;
    }

    private void ToggleMineOnly() => mineOnly = !mineOnly;

    private void ShowToast(string message, bool isError = false)
    {
        toast = message;
        toastIsError = isError;
        toastTimer?.Dispose();
        toastTimer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(() =>
            {
                toast = null;
                toastIsError = false;
                StateHasChanged();
            });
        }, null, 2400, Timeout.Infinite);
    }

    private static string GetStatusLabel(string status) => status switch
    {
        "new" or "open" => "New",
        "in_progress" => "In Progress",
        "waiting" => "Waiting",
        "resolved" => "Resolved",
        "closed" => "Closed",
        _ => status
    };

    private static string GetPriorityLabel(string priority) => priority switch
    {
        "high" => "HIGH",
        "normal" => "MEDIUM",
        _ => "LOW"
    };

    private static (string Bg, string Text, string Dot) GetStatusStyle(string status) => status switch
    {
        "in_progress" => ("#FEF3C7", "#92400E", "#F59E0B"),
        "waiting" => ("#EDE9FE", "#5B21B6", "#8B5CF6"),
        "resolved" => ("#D1FAE5", "#065F46", "#22C55E"),
        "closed" => ("#E5E7EB", "#374151", "#6B7280"),
        _ => ("#DBEAFE", "#1E3A8A", "#3B82F6")
    };

    private static (string Bg, string Text) GetPriorityStyle(string priority) => priority switch
    {
        "high" => ("#FEE2E2", "#991B1B"),
        "normal" => ("#FEF3C7", "#92400E"),
        _ => ("#F3F4F6", "#374151")
    };

    private static string FormatDate(DateTime? dt) =>
        dt?.ToString("MMM d, yyyy") ?? "—";

    private void OpenKbPanel() => showKbPanel = true;

    private void CloseKbPanel() => showKbPanel = false;

    public void Dispose() => toastTimer?.Dispose();
}
