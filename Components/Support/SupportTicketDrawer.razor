@using KobNeti.Services
@using KobNeti.Services.Support
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject SupportApiClient SupportApi
@inject SupabaseAuthService AuthService
@inject IJSRuntime JS

<aside class="kn-s3-drawer cs-drawer cs-ticket-drawer @(Shifted ? "cs-drawer--shifted" : "")">
    <header class="kn-s3-drawer__head cs-drawer__header cs-ticket-drawer__header">
        <div class="cs-ticket-drawer__heading">
            <p class="cs-drawer__eyebrow">@Ticket.TicketNumber · @Ticket.Category</p>
            <h3 class="cs-drawer__title">@Ticket.Subject</h3>
        </div>
        <div class="cs-ticket-drawer__header-actions">
            <button type="button" class="cs-btn cs-btn--outline cs-btn--sm" @onclick="OnOpenKb">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
                KB
            </button>
            <button type="button" class="cs-icon-btn" aria-label="Close ticket drawer" @onclick="OnClose">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        </div>
    </header>

    <div class="kn-s3-drawer__body cs-drawer__body cs-ticket-drawer__body">
        @if (IsLoading)
        {
            <p class="cs-loading">Loading ticket…</p>
        }
        else
        {
            <div class="cs-ticket-card">
                <div class="cs-ticket-card__customer">
                    <div class="cs-ticket-card__avatar">@CustomerInitials</div>
                    <div class="cs-ticket-card__customer-info">
                        <p class="cs-ticket-card__name">@Ticket.Name</p>
                        <a href="mailto:@Ticket.Email" class="cs-ticket-card__email">@Ticket.Email</a>
                    </div>
                    @if (!IsAssignedToMe)
                    {
                        <button type="button"
                                class="cs-btn cs-btn--primary cs-btn--sm"
                                disabled="@IsSaving"
                                @onclick="AssignToMeAsync">
                            Assign to me
                        </button>
                    }
                    @if (Ticket.Status is not ("resolved" or "closed"))
                    {
                        <button type="button"
                                class="cs-btn cs-btn--outline cs-btn--sm"
                                disabled="@IsSaving"
                                @onclick="EscalateToIncidentAsync">
                            Escalate
                        </button>
                    }
                </div>

                <div class="cs-ticket-card__meta">
                    <span class="cs-ticket-chip">Opened @FormatTimeAgo(Ticket.CreatedAt)</span>
                    @if (Ticket.Status is not ("resolved" or "closed"))
                    {
                        <span class="cs-ticket-chip @(Ticket.AgentReplyCount > 0 ? "cs-ticket-chip--success" : "cs-ticket-chip--warn")">
                            @(Ticket.AgentReplyCount > 0 ? "First response sent" : "Awaiting first response")
                        </span>
                    }
                </div>

                <div class="cs-ticket-grid">
                    <div class="cs-ticket-field">
                        <label class="cs-ticket-field__label">Status</label>
                        <select class="cs-ticket-field__select"
                                value="@Ticket.Status"
                                disabled="@IsSaving"
                                @onchange="OnStatusChanged">
                            @foreach (var s in SupportTicketStatuses.All)
                            {
                                <option value="@s.Value">@s.Label</option>
                            }
                        </select>
                    </div>
                    <div class="cs-ticket-field">
                        <label class="cs-ticket-field__label">Priority</label>
                        <select class="cs-ticket-field__select"
                                value="@Ticket.Priority"
                                disabled="@IsSaving"
                                @onchange="OnPriorityChanged">
                            @foreach (var p in SupportTicketPriorities.All)
                            {
                                <option value="@p.Value">@p.Label</option>
                            }
                        </select>
                    </div>
                    <div class="cs-ticket-field">
                        <label class="cs-ticket-field__label">Team</label>
                        <select class="cs-ticket-field__select"
                                value="@DisplayTeam"
                                disabled="@IsSaving"
                                @onchange="OnTeamChanged">
                            @foreach (var team in SupportTicketTeams.All)
                            {
                                <option value="@team">@team</option>
                            }
                        </select>
                    </div>
                    <div class="cs-ticket-field">
                        <label class="cs-ticket-field__label">Agent</label>
                        <select class="cs-ticket-field__select"
                                value="@DisplayAgent"
                                disabled="@IsSaving"
                                @onchange="OnAgentChanged">
                            @foreach (var agent in AgentOptions)
                            {
                                <option value="@agent">@agent</option>
                            }
                        </select>
                    </div>
                    <div class="cs-ticket-field">
                        <label class="cs-ticket-field__label">Tags (comma-separated)</label>
                        <input class="cs-ticket-field__select"
                               value="@tagsInput"
                               disabled="@IsSaving"
                               @onchange="OnTagsChanged" />
                    </div>
                    <div class="cs-ticket-field">
                        <label class="cs-ticket-field__label">Eng task id</label>
                        <input class="cs-ticket-field__select"
                               value="@engTaskInput"
                               disabled="@IsSaving"
                               placeholder="optional UUID"
                               @onchange="OnEngTaskChanged" />
                        <button type="button"
                                class="cs-btn cs-btn--outline cs-btn--sm"
                                style="margin-top:0.35rem;"
                                disabled="@IsSaving"
                                @onclick="CreateLinkedEngTaskAsync">
                            Create eng task
                        </button>
                    </div>
                </div>

                @if (Ticket.FirstResponseDueAt.HasValue || Ticket.ResolveDueAt.HasValue)
                {
                    <div class="cs-ticket-card__meta" style="margin-top:0.75rem;">
                        @if (Ticket.FirstResponseDueAt.HasValue)
                        {
                            <span class="cs-ticket-chip">First response due @Ticket.FirstResponseDueAt.Value.ToLocalTime().ToString("g")</span>
                        }
                        @if (Ticket.ResolveDueAt.HasValue)
                        {
                            <span class="cs-ticket-chip">Resolve due @Ticket.ResolveDueAt.Value.ToLocalTime().ToString("g")</span>
                        }
                        @if (Ticket.SlaFirstResponseMinutes is int mins)
                        {
                            <span class="cs-ticket-chip">SLA @mins min</span>
                        }
                    </div>
                }
            </div>

            <section class="cs-ticket-section">
                <h4 class="cs-ticket-section__title">Suggested articles</h4>
                @if (suggestionsLoading)
                {
                    <p class="cs-ticket-thread__empty">Loading…</p>
                }
                else if (suggestions.Count == 0)
                {
                    <p class="cs-ticket-thread__empty">No KB matches for “@Ticket.Category”.</p>
                }
                else
                {
                    <ul class="cs-ticket-thread" style="list-style:none;padding:0;margin:0;">
                        @foreach (var a in suggestions)
                        {
                            <li style="padding:0.4rem 0;border-bottom:1px solid #233648;">
                                <strong>@a.Title</strong>
                                <span class="cs-ticket-chip">@a.Category</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="cs-ticket-section">
                <h4 class="cs-ticket-section__title">Timeline</h4>
                @if (Ticket.Timeline.Count == 0)
                {
                    <p class="cs-ticket-thread__empty">No events yet.</p>
                }
                else
                {
                    <div class="cs-ticket-thread">
                        @foreach (var evt in Ticket.Timeline.OrderByDescending(e => e.CreatedAt))
                        {
                            <div class="cs-ticket-bubble cs-ticket-bubble--agent">
                                <p class="cs-ticket-bubble__text">
                                    <strong>@evt.EventType</strong>
                                    @if (!string.IsNullOrWhiteSpace(evt.Detail))
                                    {
                                        <span> — @evt.Detail</span>
                                    }
                                </p>
                                <span class="cs-ticket-bubble__time">@(evt.ActorName ?? "System") · @FormatReplyTime(evt.CreatedAt)</span>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="cs-ticket-section">
                <h4 class="cs-ticket-section__title">Original message</h4>
                <div class="cs-ticket-original">@Ticket.Message</div>
            </section>

            <section class="cs-ticket-section">
                <h4 class="cs-ticket-section__title">Conversation</h4>
                <div class="cs-ticket-thread">
                    @if (!VisibleReplies.Any())
                    {
                        <p class="cs-ticket-thread__empty">No replies yet.</p>
                    }
                    else
                    {
                        @foreach (var reply in VisibleReplies)
                        {
                            <div class="cs-ticket-bubble @(reply.IsAgent ? "cs-ticket-bubble--agent" : "cs-ticket-bubble--customer")">
                                <p class="cs-ticket-bubble__text">@reply.Message</p>
                                <span class="cs-ticket-bubble__time">@FormatReplyTime(reply.CreatedAt)</span>
                            </div>
                        }
                    }
                </div>
            </section>
        }
    </div>

    <footer class="cs-ticket-drawer__footer">
        <SupportMacrosBar @ref="macrosBar" OnApply="ApplyMacro" />
        <div class="cs-ticket-compose">
            <input class="cs-ticket-compose__input"
                   placeholder="Write a reply to the customer…"
                   @bind="replyText"
                   @bind:event="oninput"
                   @onkeydown="HandleReplyKeyDown"
                   disabled="@IsSaving" />
            <button type="button"
                    class="cs-btn cs-btn--primary"
                    disabled="@(IsSaving || string.IsNullOrWhiteSpace(replyText))"
                    @onclick="SendReplyAsync">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg>
                Reply
            </button>
        </div>
    </footer>
</aside>

@code {
    [Parameter, EditorRequired] public SupportTicketDto Ticket { get; set; } = default!;
    [Parameter] public bool Shifted { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnOpenKb { get; set; }
    [Parameter] public EventCallback<(string Message, bool IsError)> OnNotify { get; set; }
    [Parameter] public EventCallback<SupportTicketDto> OnTicketUpdated { get; set; }

    private SupportMacrosBar? macrosBar;
    private string replyText = string.Empty;
    private string agentName = "Admin";
    private string tagsInput = "";
    private string engTaskInput = "";
    private List<HelpArticleDto> suggestions = [];
    private bool suggestionsLoading;
    private Guid? suggestionsForTicket;
    private bool isSaving;
    private bool scrollAfterRender;
    private bool wasLoading = true;

    private bool IsSaving
    {
        get => isSaving;
        set
        {
            isSaving = value;
            StateHasChanged();
        }
    }

    private IReadOnlyList<string> AgentOptions =>
        SupportTicketAgents.WithCurrentUser(agentName);

    private string DisplayTeam =>
        string.IsNullOrWhiteSpace(Ticket.Team) || Ticket.Team == SupportTicketTeams.Unassigned
            ? SupportTicketTeams.Unassigned
            : Ticket.Team;

    private string DisplayAgent =>
        string.IsNullOrWhiteSpace(Ticket.AssignedToName) ||
        Ticket.AssignedToName == SupportTicketAgents.Unassigned
            ? SupportTicketAgents.Unassigned
            : Ticket.AssignedToName;

    private bool IsAssignedToMe => Ticket.IsAssignedTo(agentName);

    private IEnumerable<SupportTicketReplyDto> VisibleReplies =>
        Ticket.Replies.Where(r => !IsDuplicateOriginalMessage(r));

    private bool IsDuplicateOriginalMessage(SupportTicketReplyDto reply) =>
        !reply.IsAgent &&
        string.Equals(reply.Message.Trim(), Ticket.Message.Trim(), StringComparison.Ordinal);

    private string CustomerInitials => GetInitials(Ticket.Name);

    protected override async Task OnInitializedAsync()
    {
        agentName = await AuthService.GetAgentDisplayNameAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (wasLoading && !IsLoading)
            scrollAfterRender = true;

        wasLoading = IsLoading;
        tagsInput = string.Join(", ", Ticket.Tags ?? []);
        engTaskInput = Ticket.EngTaskId?.ToString() ?? "";

        if (!IsLoading && Ticket.Id != Guid.Empty && suggestionsForTicket != Ticket.Id)
        {
            suggestionsForTicket = Ticket.Id;
            await LoadSuggestionsAsync();
        }
    }

    private async Task LoadSuggestionsAsync()
    {
        suggestionsLoading = true;
        try
        {
            var result = await SupportApi.SuggestArticlesForTicketAsync(Ticket.Id);
            suggestions = result.Success ? result.Data ?? [] : [];
        }
        catch
        {
            suggestions = [];
        }
        finally
        {
            suggestionsLoading = false;
        }
    }

    private async Task OnTagsChanged(ChangeEventArgs e)
    {
        tagsInput = e.Value?.ToString() ?? "";
        var tags = tagsInput.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        await PatchTicketAsync(new UpdateTicketRequest { Tags = tags }, "Tags updated");
    }

    private async Task OnEngTaskChanged(ChangeEventArgs e)
    {
        engTaskInput = e.Value?.ToString()?.Trim() ?? "";
        Guid? engId = null;
        if (!string.IsNullOrWhiteSpace(engTaskInput))
        {
            if (!Guid.TryParse(engTaskInput, out var parsed))
            {
                await NotifyAsync("Eng task id must be a UUID", true);
                return;
            }
            engId = parsed;
        }
        else
        {
            engId = Guid.Empty; // clear
        }

        await PatchTicketAsync(new UpdateTicketRequest { EngTaskId = engId }, "Eng task link updated");
    }

    private async Task CreateLinkedEngTaskAsync()
    {
        IsSaving = true;
        try
        {
            var created = await SupportApi.CreateEngTaskAsync(new CreateEngTaskRequest
            {
                Title = Ticket.Subject,
                Description = Ticket.Message,
                TaskType = "bug",
                Priority = Ticket.Priority is "urgent" or "high" ? "high" : "medium",
                Status = "ready",
                TicketId = Ticket.Id
            });
            if (created.Success && created.Data != null)
            {
                engTaskInput = created.Data.Id.ToString();
                var refreshed = await SupportApi.GetTicketByIdResultAsync(Ticket.Id);
                if (refreshed.Success && refreshed.Data != null)
                    await ApplyTicketUpdate(refreshed.Data);
                await NotifyAsync($"Created {created.Data.TaskNumber}");
            }
            else
            {
                await NotifyAsync(FirstNonEmpty(created.Message, "Failed to create eng task."), true);
            }
        }
        catch (Exception ex)
        {
            await NotifyAsync(ex.Message, true);
        }
        finally
        {
            IsSaving = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollAfterRender)
            return;

        scrollAfterRender = false;
        if (Ticket.Replies.Count > 0)
            await ScrollThreadToEndAsync();
    }

    private async Task ScrollThreadToEndAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "eval",
                "(function(){const el=document.querySelector('.cs-ticket-thread');if(el)el.scrollTop=el.scrollHeight;})();");
        }
        catch
        {
            // ignore scroll errors
        }
    }

    private async Task AssignToMeAsync()
    {
        IsSaving = true;
        try
        {
            var result = await SupportApi.AssignTicketToMeAsync(Ticket.Id);
            if (result.Success && result.Data != null)
            {
                await ApplyTicketUpdate(result.Data);
                await NotifyAsync("Assigned to you");
            }
            else
            {
                var fallback = await SupportApi.UpdateTicketAsync(Ticket.Id, new UpdateTicketRequest
                {
                    AssignedToName = agentName,
                    Status = Ticket.Status is "new" or "open" ? "in_progress" : Ticket.Status
                });
                if (fallback.Success && fallback.Data != null)
                {
                    await ApplyTicketUpdate(fallback.Data);
                    await NotifyAsync("Assigned to you");
                }
                else
                {
                    await NotifyAsync(
                        FirstNonEmpty(result.Message, "Failed to assign ticket."),
                        isError: true);
                }
            }
        }
        catch (Exception ex)
        {
            await NotifyAsync(ex.Message, isError: true);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task EscalateToIncidentAsync()
    {
        IsSaving = true;
        try
        {
            var result = await SupportApi.EscalateTicketToIncidentAsync(Ticket.Id, new EscalateTicketRequest
            {
                Title = $"Escalation: {Ticket.Subject}",
                Severity = "sev2",
                CommanderName = agentName
            });
            if (result.Success && result.Data != null)
            {
                var refreshed = await SupportApi.GetTicketByIdResultAsync(Ticket.Id);
                if (refreshed.Success && refreshed.Data != null)
                    await ApplyTicketUpdate(refreshed.Data);
                await NotifyAsync($"Escalated to {result.Data.IncidentNumber}");
            }
            else
            {
                await NotifyAsync(
                    FirstNonEmpty(result.Message, "Failed to escalate ticket."),
                    isError: true);
            }
        }
        catch (Exception ex)
        {
            await NotifyAsync(ex.Message, isError: true);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task OnStatusChanged(ChangeEventArgs e)
    {
        var next = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(next) || next == Ticket.Status)
            return;

        await PatchTicketAsync(new UpdateTicketRequest { Status = next }, "Status updated");
    }

    private async Task OnPriorityChanged(ChangeEventArgs e)
    {
        var next = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(next) || next == Ticket.Priority)
            return;

        await PatchTicketAsync(new UpdateTicketRequest { Priority = next }, "Priority updated");
    }

    private async Task OnTeamChanged(ChangeEventArgs e)
    {
        var next = e.Value?.ToString() ?? SupportTicketTeams.Unassigned;
        var team = next == SupportTicketTeams.Unassigned ? string.Empty : next;
        if ((Ticket.Team ?? string.Empty) == team)
            return;

        await PatchTicketAsync(new UpdateTicketRequest { Team = team }, "Team assigned");
    }

    private async Task OnAgentChanged(ChangeEventArgs e)
    {
        var next = e.Value?.ToString() ?? SupportTicketAgents.Unassigned;
        var assigned = next == SupportTicketAgents.Unassigned ? string.Empty : next;
        if ((Ticket.AssignedToName ?? string.Empty) == assigned)
            return;

        await PatchTicketAsync(new UpdateTicketRequest
        {
            AssignedToName = assigned,
            AssignedTo = null
        }, "Agent assigned");
    }

    private async Task PatchTicketAsync(UpdateTicketRequest request, string successMessage)
    {
        IsSaving = true;
        try
        {
            var result = await SupportApi.UpdateTicketAsync(Ticket.Id, request);
            if (result.Success && result.Data != null)
            {
                await ApplyTicketUpdate(result.Data);
                await NotifyAsync(successMessage);
            }
            else
            {
                await NotifyAsync(
                    FirstNonEmpty(result.Message, "Failed to update ticket."),
                    isError: true);
            }
        }
        catch (Exception ex)
        {
            await NotifyAsync(ex.Message, isError: true);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task SendReplyAsync()
    {
        if (string.IsNullOrWhiteSpace(replyText))
            return;

        var message = replyText.Trim();
        IsSaving = true;
        try
        {
            var result = await SupportApi.AddTicketReplyAsync(Ticket.Id, message);
            if (result.Success && result.Data != null)
            {
                replyText = string.Empty;
                macrosBar?.Close();

                var refreshed = await SupportApi.GetTicketByIdResultAsync(Ticket.Id);
                if (refreshed.Success && refreshed.Data != null)
                    await ApplyTicketUpdate(refreshed.Data);
                else
                {
                    Ticket.Replies.Add(result.Data);
                    if (Ticket.FirstResponseAt == null && result.Data.IsAgent)
                        Ticket.FirstResponseAt = result.Data.CreatedAt ?? DateTime.UtcNow;
                    if (Ticket.Status is "new" or "open")
                        Ticket.Status = "in_progress";
                    await ApplyTicketUpdate(Ticket);
                }

                await NotifyAsync("Reply sent to customer");
                await ScrollThreadToEndAsync();
            }
            else
            {
                await NotifyAsync(
                    FirstNonEmpty(result.Message, "Failed to send reply."),
                    isError: true);
            }
        }
        catch (Exception ex)
        {
            await NotifyAsync(ex.Message, isError: true);
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task ApplyMacro(string text)
    {
        replyText = string.IsNullOrWhiteSpace(replyText)
            ? text
            : $"{replyText.Trim()} {text}";
        await Task.CompletedTask;
    }

    private async Task HandleReplyKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendReplyAsync();
    }

    private async Task ApplyTicketUpdate(SupportTicketDto updated)
    {
        Ticket = updated;
        tagsInput = string.Join(", ", Ticket.Tags ?? []);
        engTaskInput = Ticket.EngTaskId?.ToString() ?? "";
        await OnTicketUpdated.InvokeAsync(updated);
        StateHasChanged();
    }

    private static string FormatTimeAgo(DateTime? dt)
    {
        if (dt == null)
            return "—";

        var mins = Math.Max(0, (int)(DateTime.UtcNow - dt.Value.ToUniversalTime()).TotalMinutes);
        if (mins < 60) return $"{mins}m ago";
        var hrs = mins / 60;
        if (hrs < 24) return $"{hrs}h ago";
        var days = hrs / 24;
        if (days < 30) return $"{days}d ago";
        return dt.Value.ToString("MMM d, yyyy");
    }

    private static string FormatReplyTime(DateTime? dt) =>
        dt?.ToString("MMM d, yyyy · h:mm tt") ?? "—";

    private async Task NotifyAsync(string message, bool isError = false)
    {
        if (OnNotify.HasDelegate)
            await OnNotify.InvokeAsync((message, isError));
    }

    private static string FirstNonEmpty(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";

        return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
    }
}
