@using SominnercoreNew.Services.Support
@inject SupportApiClient SupportApi

<div class="sh-page">
    <div class="sh-page-intro">
        <p class="sh-eyebrow">Support Workspace</p>
        <h2>Overview</h2>
        <p>Live support analytics for @SupportApi.DisplayName</p>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <p class="sh-empty-list">@error</p>
    }
    else if (loading)
    {
        <p class="sh-empty-list">Loading counts...</p>
    }
    else
    {
        <div class="sh-stat-grid four">
            <div class="sh-stat-card">
                <div class="sh-stat-top">
                    <span>Active Chats</span>
                    <span class="material-symbols-outlined">forum</span>
                </div>
                <strong>@counts.ActiveChats</strong>
                <em>Project: @SupportApi.DisplayName</em>
            </div>
            <div class="sh-stat-card">
                <div class="sh-stat-top">
                    <span>Open Tickets</span>
                    <span class="material-symbols-outlined">confirmation_number</span>
                </div>
                <strong>@counts.OpenTickets</strong>
                <em>open + in progress</em>
            </div>
            <div class="sh-stat-card">
                <div class="sh-stat-top">
                    <span>Ticket Stats</span>
                    <span class="material-symbols-outlined">inbox</span>
                </div>
                <strong>@stats.OpenCount</strong>
                <em>@stats.InProgressCount in progress · @stats.TotalCount total</em>
            </div>
            <div class="sh-stat-card">
                <div class="sh-stat-top">
                    <span>Desk</span>
                    <span class="material-symbols-outlined">storefront</span>
                </div>
                <strong>@SupportApi.DisplayName</strong>
                <em>@SupportApi.TenantId</em>
            </div>
        </div>
    }
</div>

@code {
    private bool loading = true;
    private string? error;
    private SupportCountsDto counts = new();
    private TicketStatsDto stats = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await SupportApi.EnsureAgentTokenAsync();
            counts = await SupportApi.GetCountsAsync();
            stats = await SupportApi.GetTicketStatsAsync() ?? new();
        }
        catch (Exception ex)
        {
            error = $"Unable to load Support API data. Is Sominnercore.SupportApi running? ({ex.Message})";
        }
        finally
        {
            loading = false;
        }
    }
}
