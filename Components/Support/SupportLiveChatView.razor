@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using KobNeti.Services.Support
@inject SupportApiClient SupportApi
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<div class="kn-s3-page kn-s3-page--live-chat">
    <div class="kn-s3-head">
        <div>
            <p class="kn-s3-eyebrow">Customer Support</p>
            <h2>Live Chat</h2>
            <p>Respond to customers in real time · @SupportApi.DisplayName</p>
        </div>
        <div class="kn-s3-actions">
            <SupportKbButton OnClick="OpenKbPanel" />
        </div>
    </div>

    @if (!string.IsNullOrEmpty(loadError))
    {
        <p class="kn-s3-alert">@loadError</p>
    }

    <div class="@ChatGridClass">
        <aside class="kn-s3-chat__col">
            <div class="kn-s3-chat__head">
                Active Conversations@(isLoading ? "" : $" ({sessions.Count})")
            </div>
            <div class="kn-s3-chat__list">
                @if (isLoading)
                {
                    <div class="kn-s3-loading-block" role="status" aria-live="polite" aria-busy="true">
                        <span class="kn-s3-spinner" aria-hidden="true"></span>
                        <p>Loading conversations@(string.IsNullOrWhiteSpace(SupportApi.DisplayName) ? "…" : $" for {SupportApi.DisplayName}…")</p>
                        @for (var i = 0; i < 5; i++)
                        {
                            <div class="kn-s3-skeleton kn-s3-skeleton--conv" aria-hidden="true"></div>
                        }
                    </div>
                }
                else if (sessions.Count == 0)
                {
                    <div class="kn-s3-empty">
                        <span class="material-symbols-outlined" aria-hidden="true">forum</span>
                        <p>@(string.IsNullOrEmpty(loadError) ? "No active chats. Set the product API URL in Settings and ensure the product API is running." : "Unable to load conversations")</p>
                    </div>
                }
                else
                {
                    @foreach (var s in sessions)
                    {
                        <button type="button"
                                class="kn-s3-conv @(selectedSessionId == s.Id ? "kn-s3-conv--active" : "")"
                                @onclick="() => SelectSession(s.Id)"
                                @key="s.Id">
                            <div class="kn-s3-conv__top">
                                <span class="kn-s3-conv__name">@s.CustomerName</span>
                                <div class="kn-s3-conv__meta">
                                    @if (GetSidebarMessageCount(s) > 0)
                                    {
                                        <span class="kn-s3-conv__count @(ShouldHighlightSidebarCount(s) ? "kn-s3-conv__count--unread" : "")">
                                            @GetSidebarMessageCount(s)
                                        </span>
                                    }
                                    <span class="kn-s3-conv__time">@GetRelativeTime(s.LastActivity)</span>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(s.ContactEmail))
                            {
                                <span class="kn-s3-conv__email">@s.ContactEmail</span>
                            }
                            @if (!string.IsNullOrEmpty(s.LastMessagePreview))
                            {
                                <p class="kn-s3-conv__preview">@s.LastMessagePreview</p>
                            }
                            <div class="kn-s3-conv__status">
                                <span class="kn-s3-status-dot kn-s3-status-dot--@(IsWaiting(s) ? "waiting" : "active")" aria-hidden="true"></span>
                                @(IsWaiting(s) ? "waiting" : "active")
                            </div>
                        </button>
                    }
                }
            </div>
        </aside>

        @if (selectedSessionId.HasValue && selectedSession != null)
        {
            <aside class="kn-s3-chat__col kn-s3-thread">
                <header class="kn-s3-thread__head">
                    <div class="kn-s3-thread__mobile-top">
                        <button type="button"
                                class="kn-s3-thread__mobile-back kn-s3-icon-btn"
                                aria-label="Back to conversations"
                                @onclick="DeselectSession">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                        </button>
                        <div class="kn-s3-thread__mobile-center">
                            <h3 class="kn-s3-thread__mobile-name">@selectedSession.CustomerName</h3>
                            <p class="kn-s3-thread__mobile-status">
                                @(IsWaiting(selectedSession) ? "Waiting" : "Active")
                                · @GetRelativeTime(selectedSession.LastActivity)
                            </p>
                        </div>
                        <div class="kn-s3-thread__mobile-actions">
                            <button type="button"
                                    class="kn-s3-sticky-btn @(stickyNoteOpen ? "kn-s3-sticky-btn--active" : "")"
                                    @onclick="ToggleStickyNote">
                                Sticky Note
                            </button>
                            @if (selectedSession.Status == "active")
                            {
                                <button type="button"
                                        class="kn-s3-ghost-btn kn-s3-ghost-btn--compact"
                                        @onclick="OpenEscalateModal"
                                        disabled="@isClosingSession">
                                    Escalate
                                </button>
                            }
                            <button type="button" class="kn-s3-icon-btn" aria-label="Open knowledge base" @onclick="OpenKbPanel">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
                            </button>
                        </div>
                    </div>

                    <div class="kn-s3-thread__desktop">
                        <div class="kn-s3-thread__heading">
                            <h3 class="kn-s3-thread__title">@selectedSession.CustomerName</h3>
                            <p class="kn-s3-thread__subtitle">
                                @(IsWaiting(selectedSession) ? "Waiting" : "Active")
                                · last message @GetRelativeTime(selectedSession.LastActivity)
                            </p>
                            @if (!string.IsNullOrWhiteSpace(selectedSession.ContactEmail))
                            {
                                <div class="kn-s3-thread__email-row">
                                    <span class="kn-s3-thread__email"
                                          title="@selectedSession.ContactEmail">
                                        @selectedSession.ContactEmail
                                    </span>
                                    <button type="button"
                                            class="kn-s3-icon-btn"
                                            title="@(emailCopied ? "Copied!" : "Copy email")"
                                            aria-label="Copy customer email"
                                            @onclick="CopyCustomerEmail">
                                        @if (emailCopied)
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21.801 10A10 10 0 1 1 17 3.335"/><path d="m9 11 3 3L22 4"/></svg>
                                        }
                                        else
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                                        }
                                    </button>
                                </div>
                            }
                            else
                            {
                                <p class="kn-s3-thread__email-missing">No email provided</p>
                            }
                        </div>
                        <div class="kn-s3-thread__actions">
                            <button type="button"
                                    class="kn-s3-sticky-btn @(stickyNoteOpen ? "kn-s3-sticky-btn--active" : "")"
                                    @onclick="ToggleStickyNote">
                                Sticky Note
                            </button>
                            <button type="button" class="kn-btn kn-btn--outline kn-btn--sm" @onclick="OpenKbPanel">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
                                KB
                            </button>
                            @if (selectedSession.Status == "active")
                            {
                                <button type="button"
                                        class="kn-s3-ghost-btn"
                                        @onclick="OpenEscalateModal"
                                        disabled="@isClosingSession">
                                    Escalate
                                </button>
                                <button type="button" class="kn-s3-ghost-btn kn-s3-ghost-btn--danger"
                                        @onclick="CloseSelectedSession"
                                        disabled="@isClosingSession">
                                    @(isClosingSession ? "Closing…" : "Close Chat")
                                </button>
                            }
                            <button type="button" class="kn-s3-icon-btn" aria-label="Close chat panel" @onclick="DeselectSession">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                            </button>
                        </div>
                    </div>

                    @if (selectedSession.Status == "active")
                    {
                        <div class="kn-s3-thread__mobile-close-row">
                            <button type="button"
                                    class="kn-btn kn-btn--danger kn-btn--sm kn-s3-thread__mobile-close-btn"
                                    @onclick="CloseSelectedSession"
                                    disabled="@isClosingSession">
                                @(isClosingSession ? "Closing…" : "Close Chat")
                            </button>
                        </div>
                    }
                </header>

                <div class="kn-s3-thread__body">
                    @if (!string.IsNullOrEmpty(loadError))
                    {
                        <p class="kn-s3-alert kn-s3-alert--inline">@loadError</p>
                    }
                    <div class="kn-s3-thread__messages" @ref="messagesContainerRef">
                        @if (!string.IsNullOrEmpty(messagesError))
                        {
                            <p class="kn-s3-alert kn-s3-alert--inline">@messagesError</p>
                        }
                        else if (isLoadingMessages)
                        {
                            <div class="kn-s3-loading-block kn-s3-loading-block--inline" role="status" aria-live="polite" aria-busy="true">
                                <span class="kn-s3-spinner" aria-hidden="true"></span>
                                <p>Loading messages…</p>
                            </div>
                        }
                        else if (messagesLoadSucceeded && messages.Count == 0)
                        {
                            <p class="kn-s3-empty kn-s3-empty--inline">No messages yet.</p>
                        }
                        else
                        {
                            @foreach (var m in messages)
                            {
                                var isAgent = m.SenderType is "admin" or "agent";
                                <div class="kn-s3-msg @(isAgent ? "kn-s3-msg--agent" : "kn-s3-msg--customer")">
                                    <div class="kn-s3-bubble @(isAgent ? "kn-s3-bubble--agent" : "kn-s3-bubble--customer")">
                                        <p class="kn-s3-bubble__text">@m.Message</p>
                                        <span class="kn-s3-bubble__time">@m.CreatedAt.ToLocalTime().ToString("h:mm tt")</span>
                                    </div>
                                </div>
                            }
                            <div class="kn-s3-thread__anchor" @ref="messagesEndRef" aria-hidden="true"></div>
                        }
                    </div>
                </div>

                <footer class="kn-s3-thread__foot">
                    @if (!string.IsNullOrEmpty(actionMessage))
                    {
                        <p class="kn-s3-hint kn-s3-hint--inline">@actionMessage</p>
                    }
                    @if (!string.IsNullOrEmpty(actionError))
                    {
                        <p class="kn-s3-alert kn-s3-alert--inline">@actionError</p>
                    }
                    <SupportMacrosBar @ref="macrosBar" OnApply="ApplyMacro" />
                    <div class="kn-s3-thread__composer">
                        <div class="kn-field">
                            <textarea placeholder="Type a message…"
                                      rows="2"
                                      @bind="adminMessageInput"
                                      @bind:event="oninput"
                                      @onkeydown="HandleAdminKeyDown"
                                      disabled="@(selectedSession.Status == "closed" || isSendingAdminMessage)"></textarea>
                        </div>
                        <button type="button"
                                class="kn-btn kn-btn--primary"
                                @onclick="SendAdminMessage"
                                disabled="@(selectedSession.Status == "closed" || isSendingAdminMessage || string.IsNullOrWhiteSpace(adminMessageInput))">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                            Send
                        </button>
                    </div>
                </footer>
            </aside>
        }
        else if (isLoading)
        {
            <div class="kn-s3-chat__col kn-s3-chat__placeholder">
                <div class="kn-s3-loading-block kn-s3-loading-block--center" role="status" aria-busy="true">
                    <span class="kn-s3-spinner kn-s3-spinner--lg" aria-hidden="true"></span>
                    <p>Fetching live chat from product API…</p>
                </div>
            </div>
        }
        else
        {
            <div class="kn-s3-chat__col kn-s3-empty">
                <span class="material-symbols-outlined" style="font-size:2.5rem;">forum</span>
                <p>Select a conversation</p>
            </div>
        }

        <aside class="kn-s3-chat__col kn-s3-chat__col--kb">
            <div class="kn-s3-chat__head">Knowledge Base</div>
            <div class="kn-s3-chat__list kn-s3-chat__list--kb">
                <SupportKbQuickPanel @key="@SupportApi.TenantId" ShowHeader="false" />
            </div>
        </aside>
    </div>

    @if (showKbPanel)
    {
        <div class="kn-s3-kb-mobile-sheet">
            <SupportKbQuickPanel @key="@($"{SupportApi.TenantId}-mobile")" OnClose="CloseKbPanel" />
        </div>
        <button type="button" class="kn-s3-overlay kn-s3-overlay--mobile-only" @onclick="CloseKbPanel" aria-label="Close knowledge base panel"></button>
    }

    <SupportChatStickyNote SessionId="selectedSessionId"
                           CustomerName="@(selectedSession?.CustomerName ?? "Customer")"
                           @bind-IsOpen="stickyNoteOpen" />

    <SupportChatEscalateModal SessionId="selectedSessionId"
                              CustomerName="@(selectedSession?.CustomerName ?? "Customer")"
                              @bind-IsOpen="showEscalateModal"
                              OnEscalated="HandleEscalated" />
</div>

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(3);
    private static readonly TimeSpan MessageLoadTimeout = TimeSpan.FromSeconds(30);
    private const string ReadStateStorageKeyPrefix = "support-hub-chat-read-at";

    private List<ChatSessionDto> sessions = [];
    private List<ChatMessageDto> messages = [];
    private readonly Dictionary<Guid, DateTime> readChatAtBySessionId = new();
    private Guid? selectedSessionId;
    private ChatSessionDto? selectedSession;
    private string adminMessageInput = string.Empty;
    private bool isLoading = true;
    private bool isLoadingMessages;
    private bool messagesLoadSucceeded;
    private bool isSendingAdminMessage;
    private bool isClosingSession;
    private string? loadError;
    private string? messagesError;
    private string? actionError;
    private string? actionMessage;
    private bool showKbPanel;
    private bool stickyNoteOpen;
    private bool showEscalateModal;
    private bool emailCopied;

    private string ChatGridClass =>
        SupportLiveChatUiHelper.BuildChatGridClass(showKbPanel, selectedSessionId.HasValue);

    private SupportMacrosBar? macrosBar;
    private ElementReference messagesContainerRef;
    private ElementReference messagesEndRef;
    private bool scrollMessagesPending;
    private bool scrollMessagesForce;
    private CancellationTokenSource? pollCts;
    private CancellationTokenSource? messagesPollCts;
    private Task? sessionsPollTask;
    private int _messagesLoadVersion;
    private System.Threading.Timer? emailCopiedTimer;

    private string ReadStateStorageKey =>
        $"{ReadStateStorageKeyPrefix}:{SupportApi.TenantId}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            SupportApi.TenantChanged += OnTenantChanged;
            try
            {
                await InitializeWorkspaceAsync();
            }
            catch (Exception ex)
            {
                loadError = string.IsNullOrWhiteSpace(ex.Message)
                    ? "Failed to load live chat sessions."
                    : ex.Message;
                isLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }

        if (!scrollMessagesPending)
            return;

        scrollMessagesPending = false;
        var force = scrollMessagesForce;
        scrollMessagesForce = false;
        await TryScrollMessagesAsync(force);
    }

    private void QueueScrollMessages(bool force = false)
    {
        scrollMessagesForce = scrollMessagesForce || force;
        scrollMessagesPending = true;
    }

    private async Task TryScrollMessagesAsync(bool force = false)
    {
        if (!selectedSessionId.HasValue)
            return;

        try
        {
            await JS.InvokeVoidAsync("chatScroll.scrollToBottom", messagesContainerRef, messagesEndRef, true);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private int GetSidebarMessageCount(ChatSessionDto session) =>
        SupportLiveChatUnreadHelper.GetSidebarMessageCount(session, readChatAtBySessionId);

    private bool ShouldHighlightSidebarCount(ChatSessionDto session) =>
        SupportLiveChatUnreadHelper.ShouldHighlightSidebarCount(session, readChatAtBySessionId);

    private Guid? TryGetSessionIdFromUri()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrEmpty(query))
            return null;

        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length != 2) continue;
            if (!string.Equals(Uri.UnescapeDataString(pair[0]), "sessionId", StringComparison.OrdinalIgnoreCase))
                continue;

            return Guid.TryParse(Uri.UnescapeDataString(pair[1]), out var sessionId) ? sessionId : null;
        }

        return null;
    }

    private static bool IsWaiting(ChatSessionDto s) =>
        SupportLiveChatUnreadHelper.IsWaitingForAdmin(s);

    private void OnTenantChanged()
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await InitializeWorkspaceAsync();
            }
            catch (Exception ex)
            {
                loadError = string.IsNullOrWhiteSpace(ex.Message)
                    ? "Failed to load live chat sessions."
                    : ex.Message;
                isLoading = false;
                StateHasChanged();
            }
        });
    }

    private async Task InitializeWorkspaceAsync()
    {
        isLoading = true;
        loadError = null;
        messagesError = null;
        actionError = null;

        StopSessionsPolling();
        selectedSessionId = null;
        selectedSession = null;
        messages = [];
        sessions = [];
        messagesLoadSucceeded = false;
        showKbPanel = false;
        stickyNoteOpen = false;
        showEscalateModal = false;

        try
        {
            await LoadReadStateAsync();
            await SupportApi.EnsureAgentTokenAsync();
            await LoadSessions();

            pollCts = new CancellationTokenSource();
            StartSessionsPolling();

            var focusSessionId = TryGetSessionIdFromUri();
            if (focusSessionId.HasValue && sessions.Any(s => s.Id == focusSessionId.Value))
                await SelectSession(focusSessionId.Value);
            else if (sessions.Count > 0)
                await SelectSession(sessions[0].Id);
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadSessions()
    {
        try
        {
            var result = await SupportApi.GetActiveSessionsResultAsync();
            if (!result.Success)
            {
                sessions = [];
                loadError = string.IsNullOrWhiteSpace(result.Message)
                    ? "Failed to load live chat sessions."
                    : result.Message;
                return;
            }

            sessions = result.Data ?? [];
            loadError = null;
            if (sessions.Count == 0 && !string.IsNullOrWhiteSpace(result.Message)
                && !result.Message.Contains("loaded", StringComparison.OrdinalIgnoreCase))
            {
                loadError = result.Message;
            }

            if (selectedSessionId.HasValue)
            {
                selectedSession = sessions.FirstOrDefault(s => s.Id == selectedSessionId);
                if (selectedSession == null)
                {
                    selectedSessionId = null;
                    messages = [];
                    messagesLoadSucceeded = false;
                    StopMessagesPolling();
                }
            }
        }
        catch (Exception ex)
        {
            loadError = string.IsNullOrWhiteSpace(ex.Message)
                ? "Failed to load live chat sessions."
                : ex.Message;
        }
    }

    private void StartSessionsPolling()
    {
        if (sessionsPollTask != null || pollCts == null)
            return;

        sessionsPollTask = PollSessionsAsync(pollCts.Token);
    }

    private async Task PollSessionsAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(PollInterval);
        while (await timer.WaitForNextTickAsync(cancellationToken))
        {
            await InvokeAsync(async () =>
            {
                await LoadSessions();
                StateHasChanged();
            });
        }
    }

    private void StopSessionsPolling()
    {
        pollCts?.Cancel();
        pollCts?.Dispose();
        pollCts = null;
        sessionsPollTask = null;
        StopMessagesPolling();
    }

    private async Task LoadMessages()
    {
        if (!selectedSessionId.HasValue)
            return;

        var sessionId = selectedSessionId.Value;
        var loadVersion = _messagesLoadVersion;

        try
        {
            isLoadingMessages = messages.Count == 0;

            var loadTask = SupportApi.GetMessagesResultAsync(sessionId);
            var completed = await Task.WhenAny(loadTask, Task.Delay(MessageLoadTimeout));

            if (completed != loadTask)
            {
                if (loadVersion == _messagesLoadVersion && selectedSessionId == sessionId)
                    messagesError = "Timed out loading messages. Please try again.";
                return;
            }

            var result = await loadTask;

            if (loadVersion != _messagesLoadVersion || selectedSessionId != sessionId)
                return;

            if (result.Success && result.Data != null)
            {
                ApplyServerMessages(result.Data);
                messagesLoadSucceeded = true;
                messagesError = null;
            }
            else
            {
                messagesLoadSucceeded = false;
                messagesError = string.IsNullOrWhiteSpace(result.Message)
                    ? "Failed to load messages."
                    : result.Message;
            }
        }
        catch (Exception ex)
        {
            if (loadVersion == _messagesLoadVersion && selectedSessionId == sessionId)
            {
                messagesLoadSucceeded = false;
                messagesError = ex.Message;
            }
        }
        finally
        {
            if (loadVersion == _messagesLoadVersion && selectedSessionId == sessionId)
                isLoadingMessages = false;

            if (loadVersion == _messagesLoadVersion && selectedSessionId == sessionId)
                QueueScrollMessages(force: true);
        }
    }

    private void ApplyServerMessages(List<ChatMessageDto> serverMessages)
    {
        var serverIds = serverMessages.Select(m => m.Id).ToHashSet();
        var pendingLocal = messages.Where(m => !serverIds.Contains(m.Id)).ToList();

        if (isSendingAdminMessage && pendingLocal.Count > 0 && serverMessages.Count < messages.Count)
            return;

        var merged = serverMessages
            .Concat(pendingLocal)
            .OrderBy(m => m.CreatedAt)
            .ToList();

        if (merged.Count == messages.Count &&
            merged.Select(m => m.Id).SequenceEqual(messages.Select(m => m.Id)))
            return;

        messages = merged;
        QueueScrollMessages(force: true);
    }

    private void StartMessagesPolling()
    {
        messagesPollCts?.Cancel();
        messagesPollCts?.Dispose();

        if (pollCts == null)
            return;

        messagesPollCts = CancellationTokenSource.CreateLinkedTokenSource(pollCts.Token);
        _ = PollMessagesAsync(messagesPollCts.Token);
    }

    private async Task PollMessagesAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(PollInterval);
        while (await timer.WaitForNextTickAsync(cancellationToken))
        {
            await InvokeAsync(async () =>
            {
                await LoadMessages();
                StateHasChanged();
            });
        }
    }

    private void StopMessagesPolling()
    {
        messagesPollCts?.Cancel();
        messagesPollCts?.Dispose();
        messagesPollCts = null;
    }

    private async Task SelectSession(Guid sessionId)
    {
        _messagesLoadVersion++;
        selectedSessionId = sessionId;
        selectedSession = sessions.FirstOrDefault(s => s.Id == sessionId);
        emailCopied = false;
        messages = [];
        messagesLoadSucceeded = false;
        messagesError = null;
        actionError = null;
        isLoadingMessages = true;

        if (selectedSession != null && IsWaiting(selectedSession))
        {
            SupportLiveChatUnreadHelper.MarkSessionRead(
                readChatAtBySessionId, sessionId, selectedSession.LastActivity);
            await PersistReadStateAsync();
        }

        StateHasChanged();

        await LoadSessionDetails(sessionId);
        await LoadMessages();
        StartMessagesPolling();
        QueueScrollMessages(force: true);
        StateHasChanged();
        QueueScrollMessages(force: true);
    }

    private async Task LoadSessionDetails(Guid sessionId)
    {
        var result = await SupportApi.GetSessionByIdAsync(sessionId);
        if (!result.Success || result.Data == null)
        {
            actionError = string.IsNullOrWhiteSpace(result.Message)
                ? "Failed to load conversation details."
                : result.Message;
            return;
        }

        var details = result.Data;
        var index = sessions.FindIndex(s => s.Id == sessionId);
        if (index >= 0)
        {
            sessions[index].CustomerName = string.IsNullOrWhiteSpace(details.CustomerName)
                ? sessions[index].CustomerName
                : details.CustomerName;
            sessions[index].CustomerEmail ??= details.CustomerEmail;
            sessions[index].Email ??= details.Email;
            sessions[index].GuestEmail ??= details.GuestEmail;
            sessions[index].Status = details.Status;
            sessions[index].LastActivity = details.LastActivity;
            sessions[index].LastMessagePreview = details.LastMessagePreview ?? sessions[index].LastMessagePreview;
            sessions[index].LastMessageSender = details.LastMessageSender ?? sessions[index].LastMessageSender;
        }

        if (selectedSessionId == sessionId)
            selectedSession = index >= 0 ? sessions[index] : details;
    }

    private async Task CopyCustomerEmail()
    {
        var email = selectedSession?.ContactEmail;
        if (string.IsNullOrWhiteSpace(email))
            return;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", email);
            actionError = null;
            emailCopied = true;
            StateHasChanged();
            emailCopiedTimer?.Dispose();
            emailCopiedTimer = new System.Threading.Timer(_ =>
            {
                _ = InvokeAsync(() =>
                {
                    emailCopied = false;
                    StateHasChanged();
                });
            }, null, 2000, Timeout.Infinite);
        }
        catch (Exception ex)
        {
            actionError = ex.Message;
        }
    }

    private async Task SendAdminMessage()
    {
        if (!selectedSessionId.HasValue ||
            string.IsNullOrWhiteSpace(adminMessageInput) ||
            isSendingAdminMessage)
            return;

        try
        {
            isSendingAdminMessage = true;
            actionError = null;
            var result = await SupportApi.SendAdminMessageResultAsync(
                selectedSessionId.Value, adminMessageInput.Trim());

            if (result.Success && result.Data != null)
            {
                messages.Add(result.Data);
                messagesLoadSucceeded = true;
                adminMessageInput = string.Empty;
                macrosBar?.Close();
                QueueScrollMessages(force: true);
            }
            else
            {
                actionError = string.IsNullOrWhiteSpace(result.Message)
                    ? "Failed to send message."
                    : result.Message;
            }
        }
        catch (Exception ex)
        {
            actionError = ex.Message;
        }
        finally
        {
            isSendingAdminMessage = false;
        }
    }

    private async Task HandleAdminKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isSendingAdminMessage && !string.IsNullOrWhiteSpace(adminMessageInput))
            await SendAdminMessage();
    }

    private void OpenKbPanel() => showKbPanel = true;
    private void CloseKbPanel() => showKbPanel = false;
    private void ToggleStickyNote() => stickyNoteOpen = !stickyNoteOpen;
    private void OpenEscalateModal() => showEscalateModal = true;

    private Task HandleEscalated(string message)
    {
        actionError = null;
        actionMessage = message;
        loadError = null;
        messagesError = null;
        return Task.CompletedTask;
    }

    private void DeselectSession() => ClearChatSessionState();

    private void ClearChatSessionState()
    {
        showKbPanel = false;
        stickyNoteOpen = false;
        showEscalateModal = false;
        _messagesLoadVersion++;
        emailCopied = false;
        StopMessagesPolling();
        selectedSessionId = null;
        selectedSession = null;
        messages = [];
        messagesLoadSucceeded = false;
        messagesError = null;
        actionError = null;
        actionMessage = null;
        adminMessageInput = string.Empty;
    }

    private void ApplyMacro(string text) => adminMessageInput = text;

    private async Task CloseSelectedSession()
    {
        if (!selectedSessionId.HasValue || isClosingSession) return;

        try
        {
            isClosingSession = true;
            actionError = null;
            var result = await SupportApi.CloseSessionResultAsync(selectedSessionId.Value);

            if (result.Success)
            {
                sessions.RemoveAll(s => s.Id == selectedSessionId);
                ClearChatSessionState();

                if (sessions.Count > 0)
                    await SelectSession(sessions[0].Id);
            }
            else
            {
                actionError = string.IsNullOrWhiteSpace(result.Message)
                    ? "Failed to close chat session."
                    : result.Message;
            }
        }
        catch (Exception ex)
        {
            actionError = ex.Message;
        }
        finally
        {
            isClosingSession = false;
        }
    }

    private static string GetRelativeTime(DateTime utc)
    {
        var value = utc.Kind == DateTimeKind.Unspecified
            ? DateTime.SpecifyKind(utc, DateTimeKind.Utc)
            : utc.ToUniversalTime();
        var diff = DateTime.UtcNow - value;
        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return value.ToLocalTime().ToString("MMM d");
    }

    private async Task LoadReadStateAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", ReadStateStorageKey);
            if (string.IsNullOrWhiteSpace(json))
                return;

            var map = JsonSerializer.Deserialize<Dictionary<string, DateTime>>(json);
            if (map == null) return;

            foreach (var pair in map)
            {
                if (Guid.TryParse(pair.Key, out var id))
                    readChatAtBySessionId[id] = pair.Value;
            }
        }
        catch
        {
            // ignore storage errors
        }
    }

    private async Task PersistReadStateAsync()
    {
        try
        {
            var map = readChatAtBySessionId.ToDictionary(
                kv => kv.Key.ToString(),
                kv => kv.Value);
            var json = JsonSerializer.Serialize(map);
            await JS.InvokeVoidAsync("localStorage.setItem", ReadStateStorageKey, json);
        }
        catch
        {
            // ignore storage errors
        }
    }

    public void Dispose()
    {
        SupportApi.TenantChanged -= OnTenantChanged;
        emailCopiedTimer?.Dispose();
        StopSessionsPolling();
    }
}
