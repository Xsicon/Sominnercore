@page "/admin/insights"
@layout Components.Layout.AdminLayout
@using KobNeti.Services
@using KobNeti.Services.Support
@inject SupabaseAuthService AuthService
@inject SupportApiClient SupportApi
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Insights - KobNeti</PageTitle>

@if (isCheckingAuth)
{
    <div class="kn-hub-loading"><p>Loading...</p></div>
}
else if (!isAuthenticated)
{
    <div class="kn-hub-loading"><p>Redirecting to login...</p></div>
}
else
{
<KnHubShell BodyClass="kn-hub__body--scroll">
    <Tabs>
        <button type="button" class="kn-hub-subnav__item @(tab == "overview" ? "is-active" : "")" @onclick="@(() => SetTab("overview"))">Overview</button>
        <button type="button" class="kn-hub-subnav__item @(tab == "cross" ? "is-active" : "")" @onclick="@(() => SetTab("cross"))">All products</button>
        <button type="button" class="kn-hub-subnav__item @(tab == "reports" ? "is-active" : "")" @onclick="@(() => SetTab("reports"))">Reports</button>
    </Tabs>
    <ChildContent>
        <div class="kn-s3-page kn-s6-page" @key="workspaceKey">
            @if (!string.IsNullOrEmpty(msg))
            {
                <div class="kn-s5-toast @(msgIsError ? "kn-s5-toast--error" : "")" role="status">@msg</div>
            }

            @if (tab == "overview")
            {
                <div class="kn-s6-greeting">
                    <div>
                        <p class="kn-s3-eyebrow">Analytics</p>
                        <h2>@Greeting, @FirstName</h2>
                        <p>Live operations snapshot for @SupportApi.DisplayName</p>
                    </div>
                    <span class="kn-s6-date-pill">
                        <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
                        @DateTime.Now.ToString("dddd, MMM d")
                    </span>
                </div>

                @if (overview is null)
                {
                    <div class="kn-s3-loading-block" role="status"><span class="kn-s3-spinner" aria-hidden="true"></span><p>Loading overview…</p></div>
                }
                else
                {
                    <div class="kn-s6-metric-grid">
                        <div class="kn-s6-metric kn-s6-metric--indigo">
                            <div class="kn-s6-metric__icon" aria-hidden="true"><span class="material-symbols-outlined">confirmation_number</span></div>
                            <div>
                                <div class="kn-s6-metric__label">Open tickets</div>
                                <div class="kn-s6-metric__value">@overview.OpenTickets</div>
                                <div class="kn-s6-metric__hint">@overview.ActiveChats active chats</div>
                            </div>
                        </div>
                        <div class="kn-s6-metric kn-s6-metric--amber">
                            <div class="kn-s6-metric__icon" aria-hidden="true"><span class="material-symbols-outlined">engineering</span></div>
                            <div>
                                <div class="kn-s6-metric__label">Eng in progress</div>
                                <div class="kn-s6-metric__value">@overview.EngTasksInProgress</div>
                                <div class="kn-s6-metric__hint">@overview.PendingApprovals pending approvals</div>
                            </div>
                        </div>
                        <div class="kn-s6-metric kn-s6-metric--rose">
                            <div class="kn-s6-metric__icon" aria-hidden="true"><span class="material-symbols-outlined">warning</span></div>
                            <div>
                                <div class="kn-s6-metric__label">Incidents</div>
                                <div class="kn-s6-metric__value">@overview.OpenIncidents</div>
                                <div class="kn-s6-metric__hint">@overview.UnreadNotifications unread alerts</div>
                            </div>
                        </div>
                    </div>

                    <div class="kn-s6-panel-grid">
                        <section class="kn-s6-panel">
                            <h3 class="kn-s6-panel__title">Attention queue</h3>
                            <div class="kn-s6-urgency-list">
                                <div class="kn-s6-urgency-item">
                                    <div>
                                        <strong>Support backlog</strong>
                                        <span>Open tickets + live chats</span>
                                    </div>
                                    <span class="kn-chip @(overview.OpenTickets + overview.ActiveChats > 0 ? "kn-chip--warn" : "kn-chip--success")">
                                        @(overview.OpenTickets + overview.ActiveChats)
                                    </span>
                                </div>
                                <div class="kn-s6-urgency-item">
                                    <div>
                                        <strong>People approvals</strong>
                                        <span>Time edits waiting on managers</span>
                                    </div>
                                    <span class="kn-chip @(overview.PendingApprovals > 0 ? "kn-chip--warn" : "kn-chip--success")">@overview.PendingApprovals</span>
                                </div>
                                <div class="kn-s6-urgency-item">
                                    <div>
                                        <strong>Incidents</strong>
                                        <span>Open operational incidents</span>
                                    </div>
                                    <span class="kn-chip @(overview.OpenIncidents > 0 ? "kn-chip--danger" : "kn-chip--success")">@overview.OpenIncidents</span>
                                </div>
                                <div class="kn-s6-urgency-item">
                                    <div>
                                        <strong>Notifications</strong>
                                        <span>Unread in-app alerts</span>
                                    </div>
                                    <span class="kn-chip kn-chip--neutral">@overview.UnreadNotifications</span>
                                </div>
                            </div>
                        </section>
                        <section class="kn-s6-panel">
                            <h3 class="kn-s6-panel__title">Workload mix</h3>
                            <div class="kn-s6-bar-list">
                                @foreach (var row in WorkloadBars(overview))
                                {
                                    <div class="kn-s6-bar-row">
                                        <span class="kn-s6-bar-row__name">@row.Label</span>
                                        <div class="kn-s6-bar-track"><div class="kn-s6-bar-fill" style="width:@row.Pct%"></div></div>
                                        <span class="kn-s6-bar-row__val">@row.Value</span>
                                    </div>
                                }
                            </div>
                        </section>
                    </div>

                    <div class="kn-s5-stats">
                        <div class="kn-s5-stat"><div class="kn-s5-stat__label">Active chats</div><div class="kn-s5-stat__value">@overview.ActiveChats</div></div>
                        <div class="kn-s5-stat"><div class="kn-s5-stat__label">Open tickets</div><div class="kn-s5-stat__value">@overview.OpenTickets</div></div>
                        <div class="kn-s5-stat"><div class="kn-s5-stat__label">Incidents</div><div class="kn-s5-stat__value">@overview.OpenIncidents</div></div>
                        <div class="kn-s5-stat"><div class="kn-s5-stat__label">Eng tasks</div><div class="kn-s5-stat__value">@overview.EngTasksInProgress</div></div>
                        <div class="kn-s5-stat"><div class="kn-s5-stat__label">Approvals</div><div class="kn-s5-stat__value">@overview.PendingApprovals</div></div>
                        <div class="kn-s5-stat"><div class="kn-s5-stat__label">Alerts</div><div class="kn-s5-stat__value">@overview.UnreadNotifications</div></div>
                    </div>
                }
            }
            else if (tab == "cross")
            {
                <div class="kn-s5-page-head">
                    <div>
                        <p class="kn-s3-eyebrow">Analytics</p>
                        <h2>All products</h2>
                        <p>Cross-brand totals from the ops API</p>
                    </div>
                </div>

                @if (cross is null)
                {
                    <div class="kn-s3-loading-block" role="status"><span class="kn-s3-spinner" aria-hidden="true"></span><p>Loading cross-product…</p></div>
                }
                else
                {
                    <div class="kn-s6-metric-grid" style="margin-bottom:1rem;">
                        <div class="kn-s6-metric kn-s6-metric--indigo">
                            <div class="kn-s6-metric__icon" aria-hidden="true"><span class="material-symbols-outlined">confirmation_number</span></div>
                            <div>
                                <div class="kn-s6-metric__label">Open tickets</div>
                                <div class="kn-s6-metric__value">@cross.TotalOpenTickets</div>
                            </div>
                        </div>
                        <div class="kn-s6-metric kn-s6-metric--amber">
                            <div class="kn-s6-metric__icon" aria-hidden="true"><span class="material-symbols-outlined">forum</span></div>
                            <div>
                                <div class="kn-s6-metric__label">Active chats</div>
                                <div class="kn-s6-metric__value">@cross.TotalActiveChats</div>
                            </div>
                        </div>
                        <div class="kn-s6-metric kn-s6-metric--rose">
                            <div class="kn-s6-metric__icon" aria-hidden="true"><span class="material-symbols-outlined">warning</span></div>
                            <div>
                                <div class="kn-s6-metric__label">Incidents + approvals</div>
                                <div class="kn-s6-metric__value">@(cross.TotalOpenIncidents + cross.TotalPendingApprovals)</div>
                            </div>
                        </div>
                    </div>

                    <div class="kn-s6-product-strip" aria-label="Products by activity">
                        @foreach (var p in cross.Products.OrderByDescending(x => x.OpenTickets + x.ActiveChats))
                        {
                            <div class="kn-s6-product-chip">
                                <strong>@p.DisplayName</strong>
                                <span>@p.OpenTickets tickets · @p.ActiveChats chats</span>
                            </div>
                        }
                    </div>

                    <div class="kn-s6-panel">
                        <h3 class="kn-s6-panel__title">Product load</h3>
                        @if (cross.Products.Count == 0)
                        {
                            <p style="margin:0;font-size:0.8125rem;color:var(--kn-text-muted);">No products returned.</p>
                        }
                        else
                        {
                            <div class="kn-s6-bar-list">
                                @{
                                    var maxLoad = Math.Max(1, cross.Products.Max(p => p.OpenTickets + p.ActiveChats + p.OpenIncidents));
                                }
                                @foreach (var p in cross.Products.OrderByDescending(x => x.OpenTickets + x.ActiveChats))
                                {
                                    var load = p.OpenTickets + p.ActiveChats + p.OpenIncidents;
                                    var pct = (int)Math.Round(100.0 * load / maxLoad);
                                    <div class="kn-s6-bar-row">
                                        <span class="kn-s6-bar-row__name" title="@p.TenantId">@p.DisplayName</span>
                                        <div class="kn-s6-bar-track"><div class="kn-s6-bar-fill" style="width:@pct%"></div></div>
                                        <span class="kn-s6-bar-row__val">@load</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div style="margin-top:1rem;display:grid;gap:0.75rem;">
                        @foreach (var p in cross.Products.OrderBy(x => x.DisplayName))
                        {
                            <article class="kn-s5-card">
                                <div class="kn-s5-card__head">
                                    <span class="kn-s5-card__title">@p.DisplayName</span>
                                    <span class="kn-chip kn-chip--neutral">@p.TenantId</span>
                                </div>
                                <div class="kn-s5-card__meta">
                                    <span>@p.OpenTickets tickets</span>
                                    <span>@p.ActiveChats chats</span>
                                    <span>@p.OpenIncidents incidents</span>
                                    <span>@p.EngTasksInProgress eng</span>
                                    <span>@p.PendingApprovals approvals</span>
                                </div>
                            </article>
                        }
                    </div>
                }
            }
            else
            {
                <div class="kn-s5-page-head">
                    <div>
                        <p class="kn-s3-eyebrow">Analytics</p>
                        <h2>Reports</h2>
                        <p>Export tickets, time, payroll, and audit data for @SupportApi.DisplayName</p>
                    </div>
                </div>

                <div class="kn-s5-toolbar">
                    <select @bind="reportType">
                        <option value="tickets">Tickets</option>
                        <option value="time">Time</option>
                        <option value="payroll">Payroll</option>
                        <option value="audit">Audit</option>
                    </select>
                    <button type="button" class="kn-btn kn-btn--primary kn-btn--sm" disabled="@busy" @onclick="RunReport">
                        <span class="material-symbols-outlined" aria-hidden="true">download</span>
                        Run export
                    </button>
                </div>

                @if (reports.Count == 0)
                {
                    <div class="kn-s5-empty">
                        <span class="material-symbols-outlined" aria-hidden="true">description</span>
                        <strong>No reports yet</strong>
                        <p>Run an export to generate CSV data.</p>
                    </div>
                }
                else
                {
                    <div class="kn-s5-table-wrap">
                        <table class="kn-s5-table">
                            <thead>
                                <tr>
                                    <th>Label</th>
                                    <th>Type</th>
                                    <th>Rows</th>
                                    <th>Created</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in reports.OrderByDescending(x => x.CreatedAt))
                                {
                                    <tr>
                                        <td><strong>@r.Label</strong></td>
                                        <td>@r.ReportType</td>
                                        <td>@r.RowCount</td>
                                        <td>@r.CreatedAt.ToLocalTime().ToString("g")</td>
                                        <td><button type="button" class="kn-btn kn-btn--outline kn-btn--sm" @onclick="() => ShowCsv(r.Id)">Preview</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (!string.IsNullOrEmpty(csvPreview))
                    {
                        <pre class="kn-s6-pre">@csvPreview</pre>
                    }
                }
            }
        </div>
    </ChildContent>
</KnHubShell>
}

@code {
    private bool isCheckingAuth = true;
    private bool isAuthenticated;
    private string tab = "overview";
    private string? msg;
    private bool msgIsError;
    private bool busy;
    private int workspaceEpoch;
    private string workspaceKey => $"{SupportApi.TenantId}:{workspaceEpoch}";
    private OverviewDto? overview;
    private CrossProductOverviewDto? cross;
    private List<ReportRunDto> reports = [];
    private string reportType = "tickets";
    private string? csvPreview;
    private string? userEmail;

    private string Greeting
    {
        get
        {
            var hour = DateTime.Now.Hour;
            if (hour < 12) return "Good morning";
            if (hour < 17) return "Good afternoon";
            return "Good evening";
        }
    }

    private string FirstName
    {
        get
        {
            if (string.IsNullOrWhiteSpace(userEmail)) return "there";
            var local = userEmail.Split('@')[0];
            var part = local.Split(new[] { '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
            if (string.IsNullOrEmpty(part)) return "there";
            return char.ToUpperInvariant(part[0]) + part.Substring(1);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var (user, session) = await AuthService.GetAuthenticatedAdminAsync();
        if (user == null || session == null)
        {
            isCheckingAuth = false;
            Navigation.NavigateTo("/admin/login");
            return;
        }
        userEmail = user.Email;
        isAuthenticated = true;
        isCheckingAuth = false;
        SupportApi.TenantChanged += OnTenantChanged;
        Navigation.LocationChanged += OnLocationChanged;
        ApplyTabFromQuery();
        try { await SupportApi.EnsureAgentTokenAsync(); } catch { }
        await LoadTab();
    }

    private sealed record WorkloadBar(string Label, int Value, int Pct);

    private static IEnumerable<WorkloadBar> WorkloadBars(OverviewDto o)
    {
        var items = new[]
        {
            new WorkloadBar("Tickets", o.OpenTickets, 0),
            new WorkloadBar("Chats", o.ActiveChats, 0),
            new WorkloadBar("Eng tasks", o.EngTasksInProgress, 0),
            new WorkloadBar("Approvals", o.PendingApprovals, 0),
            new WorkloadBar("Incidents", o.OpenIncidents, 0),
        };
        var max = Math.Max(1, items.Max(i => i.Value));
        return items.Select(i => i with { Pct = (int)Math.Round(100.0 * i.Value / max) });
    }

    private void ApplyTabFromQuery()
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query.TrimStart('?');
        if (string.IsNullOrEmpty(query)) return;
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 2 && string.Equals(Uri.UnescapeDataString(pair[0]), "tab", StringComparison.OrdinalIgnoreCase))
            {
                var t = Uri.UnescapeDataString(pair[1]);
                if (t is "overview" or "cross" or "reports")
                    tab = t;
            }
        }
    }

    private void OnTenantChanged() => _ = InvokeAsync(async () => { workspaceEpoch++; await LoadTab(); StateHasChanged(); });
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () => { ApplyTabFromQuery(); await LoadTab(); StateHasChanged(); });

    private async Task SetTab(string t)
    {
        tab = t;
        csvPreview = null;
        msg = null;
        Navigation.NavigateTo(t == "overview" ? "/admin/insights" : $"/admin/insights?tab={t}", replace: true);
        await LoadTab();
    }

    private async Task LoadTab()
    {
        msg = null;
        try
        {
            if (tab == "overview")
            {
                var r = await SupportApi.GetOverviewAsync();
                overview = r.Success ? r.Data : null;
                if (!r.Success) Show(r.Message ?? "Failed", true);
            }
            else if (tab == "cross")
            {
                var r = await SupportApi.GetCrossProductOverviewAsync();
                cross = r.Success ? r.Data : null;
                if (!r.Success) Show(r.Message ?? "Failed", true);
            }
            else
            {
                var r = await SupportApi.GetReportsAsync();
                reports = r.Data ?? [];
                if (!r.Success) Show(r.Message ?? "Failed", true);
            }
        }
        catch (Exception ex) { Show(ex.Message, true); }
    }

    private async Task RunReport()
    {
        busy = true;
        try
        {
            var r = await SupportApi.RunReportAsync(reportType);
            Show(r.Success ? $"Generated {r.Data!.RowCount} rows" : r.Message ?? "Failed", !r.Success);
            await LoadTab();
        }
        finally { busy = false; }
    }

    private async Task ShowCsv(Guid id)
    {
        var r = await SupportApi.GetReportCsvAsync(id);
        csvPreview = r.Success ? r.Data : r.Message;
    }

    private void Show(string text, bool error)
    {
        msg = text;
        msgIsError = error;
    }

    public void Dispose()
    {
        SupportApi.TenantChanged -= OnTenantChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
