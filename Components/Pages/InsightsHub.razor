@page "/admin/insights"
@layout Components.Layout.AdminLayout
@using KobNeti.Services
@using KobNeti.Services.Support
@inject SupabaseAuthService AuthService
@inject SupportApiClient SupportApi
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Insights - KobNeti</PageTitle>

@if (ready)
{
<KnHubShell BodyClass="kn-hub__body--scroll">
    <Tabs>
        <button type="button" class="kn-hub-subnav__item @(tab=="overview"?"is-active":"")" @onclick="@(() => SetTab("overview"))">Overview</button>
        <button type="button" class="kn-hub-subnav__item @(tab=="cross"?"is-active":"")" @onclick="@(() => SetTab("cross"))">All products</button>
        <button type="button" class="kn-hub-subnav__item @(tab=="reports"?"is-active":"")" @onclick="@(() => SetTab("reports"))">Reports</button>
        <button type="button" class="kn-hub-subnav__item @(tab=="help"?"is-active":"")" @onclick="@(() => SetTab("help"))">Platform help</button>
        <button type="button" class="kn-hub-subnav__item @(tab=="assets"?"is-active":"")" @onclick="@(() => SetTab("assets"))">Assets</button>
    </Tabs>
    <ChildContent>
        <div class="kn-s3-page" @key="workspaceKey">
                @if (!string.IsNullOrEmpty(msg)) { <p class="sh-empty-list">@msg</p> }

                @if (tab == "overview")
                {
                    @if (overview is null)
                    {
                        <p class="sh-empty-list">Loadingâ€¦</p>
                    }
                    else
                    {
                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:0.75rem;">
                            <div style="padding:0.75rem;border:1px solid rgba(255,255,255,0.1);border-radius:8px;">
                                <div style="font-size:1.4rem;font-weight:600;">@overview.ActiveChats</div>
                                <div style="opacity:0.7;font-size:0.85rem;">Active chats</div>
                            </div>
                            <div style="padding:0.75rem;border:1px solid rgba(255,255,255,0.1);border-radius:8px;">
                                <div style="font-size:1.4rem;font-weight:600;">@overview.OpenTickets</div>
                                <div style="opacity:0.7;font-size:0.85rem;">Open tickets</div>
                            </div>
                            <div style="padding:0.75rem;border:1px solid rgba(255,255,255,0.1);border-radius:8px;">
                                <div style="font-size:1.4rem;font-weight:600;">@overview.OpenIncidents</div>
                                <div style="opacity:0.7;font-size:0.85rem;">Open incidents</div>
                            </div>
                            <div style="padding:0.75rem;border:1px solid rgba(255,255,255,0.1);border-radius:8px;">
                                <div style="font-size:1.4rem;font-weight:600;">@overview.EngTasksInProgress</div>
                                <div style="opacity:0.7;font-size:0.85rem;">Eng in progress</div>
                            </div>
                            <div style="padding:0.75rem;border:1px solid rgba(255,255,255,0.1);border-radius:8px;">
                                <div style="font-size:1.4rem;font-weight:600;">@overview.PendingApprovals</div>
                                <div style="opacity:0.7;font-size:0.85rem;">Pending approvals</div>
                            </div>
                            <div style="padding:0.75rem;border:1px solid rgba(255,255,255,0.1);border-radius:8px;">
                                <div style="font-size:1.4rem;font-weight:600;">@overview.UnreadNotifications</div>
                                <div style="opacity:0.7;font-size:0.85rem;">Unread alerts</div>
                            </div>
                        </div>
                    }
                }
                else if (tab == "cross")
                {
                    @if (cross is null)
                    {
                        <p class="sh-empty-list">Loadingâ€¦</p>
                    }
                    else
                    {
                        <p class="sh-empty-list" style="margin-bottom:1rem;">
                            Totals â€” tickets @cross.TotalOpenTickets Â· chats @cross.TotalActiveChats Â·
                            incidents @cross.TotalOpenIncidents Â· approvals @cross.TotalPendingApprovals
                        </p>
                        @foreach (var p in cross.Products)
                        {
                            <div style="padding:0.55rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
                                <strong>@p.DisplayName</strong>
                                <div><small>
                                    tickets @p.OpenTickets Â· chats @p.ActiveChats Â· incidents @p.OpenIncidents Â·
                                    eng @p.EngTasksInProgress Â· approvals @p.PendingApprovals
                                </small></div>
                            </div>
                        }
                    }
                }
                else if (tab == "reports")
                {
                    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1rem;">
                        <select class="kn-field" @bind="reportType">
                            <option value="tickets">Tickets</option>
                            <option value="time">Time</option>
                            <option value="payroll">Payroll</option>
                            <option value="audit">Audit</option>
                        </select>
                        <button type="button" class="kn-btn kn-btn--primary kn-btn--sm" disabled="@busy" @onclick="RunReport">Run export</button>
                    </div>
                    @foreach (var r in reports)
                    {
                        <div style="padding:0.45rem 0;border-bottom:1px solid rgba(255,255,255,0.08);display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
                            <strong>@r.Label</strong>
                            <span class="kn-chip kn-chip--neutral">@r.ReportType</span>
                            <span class="kn-chip kn-chip--neutral">@r.RowCount rows</span>
                            <small>@r.CreatedAt.ToLocalTime().ToString("g")</small>
                            <button type="button" class="kn-btn kn-btn--outline kn-btn--sm" @onclick="() => ShowCsv(r.Id)">View CSV</button>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(csvPreview))
                    {
                        <pre style="margin-top:1rem;max-height:240px;overflow:auto;font-size:0.75rem;white-space:pre-wrap;">@csvPreview</pre>
                    }
                }
                else if (tab == "help")
                {
                    @foreach (var a in helpArticles)
                    {
                        <details style="padding:0.55rem 0;border-bottom:1px solid rgba(255,255,255,0.08);">
                            <summary><strong>@a.Title</strong> <span class="kn-chip kn-chip--neutral">@a.Category</span></summary>
                            <p style="margin:0.5rem 0 0;opacity:0.9;">@a.Body</p>
                        </details>
                    }
                }
                else
                {
                    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1rem;">
                        <input class="kn-field" placeholder="Asset name" @bind="assetName" />
                        <select class="kn-field" @bind="assetType">
                            <option value="hardware">Hardware</option>
                            <option value="license">License</option>
                            <option value="other">Other</option>
                        </select>
                        <button type="button" class="kn-btn kn-btn--primary kn-btn--sm" disabled="@busy" @onclick="CreateAsset">Add</button>
                        <button type="button" class="kn-btn kn-btn--outline kn-btn--sm" disabled="@busy" @onclick="RemindRenewals">Renewal reminders</button>
                    </div>
                    @foreach (var a in assets)
                    {
                        <div style="padding:0.55rem 0;border-bottom:1px solid rgba(255,255,255,0.08);display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
                            <strong>@a.Name</strong>
                            <span class="kn-chip kn-chip--neutral">@a.AssetType</span>
                            <span class="kn-chip kn-chip--neutral">@a.Status</span>
                            @if (!string.IsNullOrEmpty(a.AssignedUserName)) { <span>â†’ @a.AssignedUserName</span> }
                            @if (a.RenewalDate is not null) { <small>renew @a.RenewalDate</small> }
                            @if (a.Status != "retired")
                            {
                                <button type="button" class="kn-btn kn-btn--outline kn-btn--sm" disabled="@busy" @onclick="() => AssignAsset(a.Id)">Assign me</button>
                                <button type="button" class="kn-btn kn-btn--outline kn-btn--sm" disabled="@busy" @onclick="() => RetireAsset(a.Id)">Retire</button>
                            }
                        </div>
                    }
                }
        </div>
    </ChildContent>
</KnHubShell>
}

@code {
    private bool ready;
    private string tab = "overview";
    private string? msg;
    private bool busy;
    private string workspaceKey = "";
    private OverviewDto? overview;
    private CrossProductOverviewDto? cross;
    private List<ReportRunDto> reports = [];
    private List<PlatformHelpArticleDto> helpArticles = [];
    private List<AssetDto> assets = [];
    private string reportType = "tickets";
    private string? csvPreview;
    private string assetName = "";
    private string assetType = "hardware";

    private string TabTitle => tab switch
    {
        "cross" => "All products",
        "reports" => "Reports",
        "help" => "Platform help",
        "assets" => "Assets",
        _ => "Overview"
    };

    protected override async Task OnInitializedAsync()
    {
        var (user, session) = await AuthService.GetAuthenticatedAdminAsync();
        if (user == null || session == null)
        {
            Navigation.NavigateTo("/admin/login");
            return;
        }
        SupportApi.TenantChanged += OnTenantChanged;
        workspaceKey = SupportApi.TenantId;
        ApplyTabFromQuery();
        ready = true;
        await LoadTab();
    }

    private void ApplyTabFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrEmpty(query)) return;
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 2 && string.Equals(Uri.UnescapeDataString(pair[0]), "tab", StringComparison.OrdinalIgnoreCase))
            {
                var t = Uri.UnescapeDataString(pair[1]);
                if (t is "overview" or "cross" or "reports" or "help" or "assets")
                    tab = t;
            }
        }
    }

    private void OnTenantChanged()
    {
        workspaceKey = SupportApi.TenantId;
        _ = InvokeAsync(async () => { await LoadTab(); StateHasChanged(); });
    }

    private async Task SetTab(string t)
    {
        tab = t;
        csvPreview = null;
        msg = null;
        Navigation.NavigateTo(t == "overview" ? "/admin/insights" : $"/admin/insights?tab={t}", replace: true);
        await LoadTab();
    }

    private async Task LoadTab()
    {
        msg = null;
        try
        {
            if (tab == "overview")
            {
                var r = await SupportApi.GetOverviewAsync();
                overview = r.Success ? r.Data : null;
                if (!r.Success) msg = r.Message;
            }
            else if (tab == "cross")
            {
                var r = await SupportApi.GetCrossProductOverviewAsync();
                cross = r.Success ? r.Data : null;
                if (!r.Success) msg = r.Message;
            }
            else if (tab == "reports")
            {
                var r = await SupportApi.GetReportsAsync();
                reports = r.Data ?? [];
                if (!r.Success) msg = r.Message;
            }
            else if (tab == "help")
            {
                var r = await SupportApi.GetPlatformHelpAsync();
                helpArticles = r.Data ?? [];
                if (!r.Success) msg = r.Message;
            }
            else
            {
                var r = await SupportApi.GetAssetsAsync();
                assets = r.Data ?? [];
                if (!r.Success) msg = r.Message;
            }
        }
        catch (Exception ex) { msg = ex.Message; }
    }

    private async Task RunReport()
    {
        busy = true;
        try
        {
            var r = await SupportApi.RunReportAsync(reportType);
            msg = r.Success ? $"Generated {r.Data!.RowCount} rows" : r.Message;
            await LoadTab();
        }
        finally { busy = false; }
    }

    private async Task ShowCsv(Guid id)
    {
        var r = await SupportApi.GetReportCsvAsync(id);
        csvPreview = r.Success ? r.Data : r.Message;
    }

    private async Task CreateAsset()
    {
        if (string.IsNullOrWhiteSpace(assetName)) return;
        busy = true;
        try
        {
            var r = await SupportApi.CreateAssetAsync(assetName.Trim(), assetType,
                DateOnly.FromDateTime(DateTime.UtcNow.AddDays(60)));
            msg = r.Success ? "Asset added" : r.Message;
            assetName = "";
            await LoadTab();
        }
        finally { busy = false; }
    }

    private async Task AssignAsset(Guid id)
    {
        busy = true;
        try
        {
            var r = await SupportApi.AssignAssetAsync(id, "Me");
            msg = r.Success ? "Assigned" : r.Message;
            await LoadTab();
        }
        finally { busy = false; }
    }

    private async Task RetireAsset(Guid id)
    {
        busy = true;
        try
        {
            var r = await SupportApi.RetireAssetAsync(id);
            msg = r.Success ? "Retired" : r.Message;
            await LoadTab();
        }
        finally { busy = false; }
    }

    private async Task RemindRenewals()
    {
        busy = true;
        try
        {
            var r = await SupportApi.SendAssetRenewalRemindersAsync();
            msg = r.Success ? $"Sent {r.Data} reminders" : r.Message;
        }
        finally { busy = false; }
    }

    public void Dispose() => SupportApi.TenantChanged -= OnTenantChanged;
}
