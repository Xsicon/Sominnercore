@page "/"
@using SominnercoreNew.Models
@using SominnercoreNew.Services
@using System.Globalization
@inject SoftwareProductService ProductService
@inject ProductChangeNotifier ChangeNotifier
@implements IDisposable

<PageTitle>Sominnercore - Enterprise Software</PageTitle>

<!-- ===== HERO SECTION ===== -->
<section id="home" class="hero-section">
    <div class="hero-bg-effects">
        <div class="hero-blob blob-1"></div>
        <div class="hero-blob blob-2"></div>
        <div class="hero-blob blob-3"></div>
    </div>

    <div class="section-container hero-grid">
        <div class="hero-content">
            <div class="pill-badge">
                <span class="pulse-dot green"></span>
                <span>290K+ Downloads Worldwide</span>
            </div>

            <h1 class="hero-title">
                <span>Enterprise Software</span>
                <span>That Powers</span>
                <span class="text-primary">Modern Business</span>
            </h1>

            <p class="hero-desc">
                Discover our suite of powerful, industry-leading software solutions designed to solve real business challenges and drive digital transformation.
            </p>

            <div class="hero-buttons">
                <a href="#products" class="btn-primary-lg">
                    Explore Products
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
                <a href="#contact" class="btn-outline-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    Watch Demo
                </a>
            </div>

            <div class="hero-stats">
                <div class="stat-item">
                    <span class="stat-number">@publishedProducts.Count</span>
                    <span class="stat-label">Active Products</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number">@FormatDownloads(publishedProducts.Sum(p => p.TotalDownloads))</span>
                    <span class="stat-label">Total Downloads</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number">@FormatDownloads(publishedProducts.Sum(p => p.ActiveUsers))</span>
                    <span class="stat-label">Active Users</span>
                </div>
            </div>
        </div>

        <div class="hero-image-area">
            <div class="hero-img-wrapper">
                <img src="https://images.unsplash.com/photo-1623715537851-8bc15aa8c145?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxtb2Rlcm4lMjB0ZWNobm9sb2d5JTIwb2ZmaWNlJTIwd29ya3NwYWNlfGVufDF8fHx8MTc1NzkxNDMxMXww&ixlib=rb-4.1.0&q=80&w=1080" alt="Modern technology workspace" />
            </div>
            <div class="floating-card floating-top">
                <span class="pulse-dot green"></span>
                <span>New Release: v3.2.1</span>
            </div>
            <div class="floating-card floating-bottom">
                <span class="pulse-dot blue"></span>
                <span>5K+ Downloads Today</span>
            </div>
        </div>
    </div>
</section>

<!-- ===== PRODUCTS SECTION ===== -->
<section id="products" class="section-dark">
    <div class="section-container">
        <div class="section-header">
            <div class="pill-badge">
                <span class="pulse-dot blue"></span>
                <span>Our Software Products</span>
            </div>
            <h2>Enterprise Software<br /><span class="text-primary">Built for Scale</span></h2>
            <p>Discover our suite of powerful software solutions designed to solve real business challenges across various industries.</p>
        </div>

        <div class="filter-bar">
            @foreach (var cat in DynamicProductCategories)
            {
                <button class="@(selectedProductCategory == cat ? "filter-btn active" : "filter-btn")" @onclick="() => selectedProductCategory = cat">@cat</button>
            }
        </div>

        <div class="products-grid">
            @if (isLoadingProducts)
            {
                <div class="products-state-card">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/></svg>
                    <h3>Loading Products</h3>
                    <p>Fetching the latest software products...</p>
                </div>
            }
            else if (!string.IsNullOrEmpty(productLoadError))
            {
                <div class="products-state-card">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <h3>Unable to Load Products</h3>
                    <p>@productLoadError</p>
                    <button class="btn-primary-lg" @onclick="RetryLoadProducts">
                        Retry
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                    </button>
                </div>
            }
            else if (!FilteredPublishedProducts.Any())
            {
                <div class="products-state-card">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                    <h3>No Products Available Yet</h3>
                    <p>We're preparing exciting new software products. Check back soon or contact us for more information.</p>
                    <a href="#contact" class="btn-outline-lg">Contact Us</a>
                </div>
            }
            else
            {
                @foreach (var product in FilteredPublishedProducts)
                {
                    <div class="product-card" @onclick="() => selectedSoftware = product">
                        <div class="product-card-header @GetGradientClass(product.IconColor)">
                            <div class="product-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                                </svg>
                            </div>
                            <div class="product-badges">
                                <span class="version-badge">@product.Version</span>
                                @if (product.Status == "upcoming")
                                {
                                    <span class="status-badge new">New</span>
                                }
                            </div>
                        </div>
                        <div class="product-card-header-text">
                            <h3>@product.Name</h3>
                            <p class="tagline">@(product.ShortDescription ?? "")</p>
                        </div>
                        <div class="product-card-body">
                            <p class="product-desc">@(product.FullDescription ?? product.ShortDescription ?? "")</p>
                            <div class="product-meta">
                                <div class="meta-row"><span class="meta-label">Released:</span><span>@FormatReleaseDate(product.ReleaseDate)</span></div>
                                @if (product.TotalDownloads > 0)
                                {
                                    <div class="meta-row"><span class="meta-label">Downloads:</span><span class="fw-600">@FormatDownloads(product.TotalDownloads)</span></div>
                                }
                                @if (product.ActiveUsers > 0)
                                {
                                    <div class="meta-row"><span class="meta-label">Active Users:</span><span class="fw-600">@product.ActiveUsers.ToString("N0")</span></div>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(product.Category))
                            {
                                <div class="tag-list">
                                    <span class="outline-tag">@product.Category</span>
                                </div>
                            }
                            <button class="btn-primary-full" @onclick="() => selectedSoftware = product" @onclick:stopPropagation="true">
                                View Details
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                            </button>
                        </div>
                    </div>
                }
            }
        </div>

        @if (selectedSoftware != null)
        {
            <div class="modal-overlay" @onclick="() => selectedSoftware = null">
                <div class="modal-content" @onclick:stopPropagation="true">
                    <div class="modal-header @GetGradientClass(selectedSoftware.IconColor)">
                        <div class="modal-header-info">
                            <div class="product-icon lg">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                            </div>
                            <div>
                                <h3>@selectedSoftware.Name</h3>
                                <p>@(selectedSoftware.ShortDescription ?? "")</p>
                            </div>
                        </div>
                        <button class="modal-close" @onclick="() => selectedSoftware = null">&#10005;</button>
                    </div>
                    <div class="modal-body">
                        <h4>About</h4>
                        <p>@(selectedSoftware.FullDescription ?? selectedSoftware.ShortDescription ?? "No description available.")</p>
                        <div class="product-meta">
                            <div class="meta-row"><span class="meta-label">Version:</span><span>@selectedSoftware.Version</span></div>
                            <div class="meta-row"><span class="meta-label">Category:</span><span>@(selectedSoftware.Category ?? "N/A")</span></div>
                            <div class="meta-row"><span class="meta-label">Release Date:</span><span>@FormatReleaseDate(selectedSoftware.ReleaseDate)</span></div>
                            <div class="meta-row"><span class="meta-label">Downloads:</span><span>@FormatDownloads(selectedSoftware.TotalDownloads)</span></div>
                            <div class="meta-row"><span class="meta-label">Active Users:</span><span>@selectedSoftware.ActiveUsers.ToString("N0")</span></div>
                        </div>
                        <div class="modal-actions">
                            <button class="btn-primary-lg">Download Now</button>
                            <button class="btn-outline-lg">Documentation</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="stats-cards-row">
            <div class="stat-card"><div class="stat-card-number">@publishedProducts.Count</div><div class="stat-card-label">Active Products</div></div>
            <div class="stat-card"><div class="stat-card-number">@FormatDownloads(publishedProducts.Sum(p => p.TotalDownloads))</div><div class="stat-card-label">Total Downloads</div></div>
            <div class="stat-card"><div class="stat-card-number">@FormatDownloads(publishedProducts.Sum(p => p.ActiveUsers))</div><div class="stat-card-label">Active Users</div></div>
            <div class="stat-card"><div class="stat-card-number">@publishedProducts.Select(p => p.Category).Where(c => !string.IsNullOrEmpty(c)).Distinct().Count()</div><div class="stat-card-label">Categories</div></div>
        </div>

        <div class="cta-card gradient-bg">
            <h3>Looking for a Custom Solution?</h3>
            <p>We also offer custom software development tailored to your specific business needs. Contact us to discuss your requirements.</p>
            <a href="#contact" class="btn-primary-lg">Contact Sales <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        </div>
    </div>
</section>

<!-- ===== SERVICES SECTION ===== -->
<section id="services" class="section-muted">
    <div class="section-container">
        <div class="section-header">
            <div class="pill-badge"><span>Our Services</span></div>
            <h2>Complete Technology<br /><span class="text-primary">Solutions</span></h2>
            <p>We offer a comprehensive suite of technology services to help your business thrive in the digital landscape.</p>
        </div>

        <div class="filter-bar">
            @foreach (var cat in serviceCategories)
            {
                <button class="@(selectedServiceCategory == cat ? "filter-btn active" : "filter-btn")" @onclick="() => { selectedServiceCategory = cat; currentServiceSlide = 0; }">@cat</button>
            }
        </div>

        <div class="carousel-wrapper">
            <div class="carousel-track" style="transform: translateX(-@(currentServiceSlide * 100)%)">
                @foreach (var service in FilteredServices)
                {
                    <div class="carousel-slide">
                        <div class="service-slide-card">
                            <div class="service-visual @service.ColorClass">
                                <div class="service-icon-large">@((MarkupString)service.IconSvg)</div>
                                <span class="service-category-pill">@service.Category</span>
                            </div>
                            <div class="service-info">
                                <h3>@service.Title</h3>
                                <p>@service.Description</p>
                                <div class="service-features">
                                    @foreach (var f in service.Features)
                                    {
                                        <div class="service-feature-item"><span class="feature-dot"></span><span>@f</span></div>
                                    }
                                </div>
                                <div class="service-actions">
                                    <a href="#contact" class="btn-primary-lg">Learn More</a>
                                    <a href="#contact" class="btn-outline-lg">Get Started</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            @if (FilteredServices.Count > 1)
            {
                <button class="carousel-arrow left" @onclick="PrevServiceSlide"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg></button>
                <button class="carousel-arrow right" @onclick="NextServiceSlide"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></button>
                <div class="carousel-dots">
                    @for (int i = 0; i < FilteredServices.Count; i++)
                    {
                        var idx = i;
                        <button class="@(currentServiceSlide == idx ? "dot active" : "dot")" @onclick="() => currentServiceSlide = idx"></button>
                    }
                </div>
            }
        </div>

        <div class="cta-card gradient-solid">
            <h3>Ready to Transform Your Business?</h3>
            <p>Let's discuss how our technology solutions can help you achieve your goals and drive growth.</p>
            <a href="#contact" class="btn-white">Schedule a Consultation</a>
        </div>
    </div>
</section>

<!-- ===== ABOUT SECTION ===== -->
<section id="about" class="section-dark">
    <div class="section-container">
        <div class="section-header">
            <div class="pill-badge"><span>About Us</span></div>
            <h2>Building the Future of<br /><span class="text-primary">Enterprise Software</span></h2>
        </div>

        <div class="about-grid">
            <div class="about-content">
                <p class="about-lead">At Sominnercore, we're a team of passionate software engineers and product designers dedicated to building powerful, scalable enterprise software that solves real business challenges.</p>
                <p>Founded with a vision to democratize enterprise-grade technology, we've developed a suite of software products trusted by thousands of organizations worldwide.</p>
                <h3>Why Choose Our Software?</h3>
                <div class="checklist">
                    <div class="check-item"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#137fec" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span>Enterprise-grade reliability &amp; security</span></div>
                    <div class="check-item"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#137fec" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span>Intuitive user interface &amp; experience</span></div>
                    <div class="check-item"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#137fec" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span>Seamless integration capabilities</span></div>
                    <div class="check-item"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#137fec" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span>Regular updates &amp; new features</span></div>
                    <div class="check-item"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#137fec" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span>Dedicated customer support</span></div>
                </div>
            </div>
            <div class="about-image">
                <img src="https://images.unsplash.com/photo-1531535807748-218331acbcb4?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080" alt="Team collaboration" />
            </div>
        </div>

        <div class="achievements-row">
            <div class="achievement"><div class="achievement-number">290K+</div><h3>Downloads</h3><p>Active users worldwide</p></div>
            <div class="achievement"><div class="achievement-number">6</div><h3>Software Products</h3><p>Enterprise-grade solutions</p></div>
            <div class="achievement"><div class="achievement-number">5+</div><h3>Years Experience</h3><p>In software development</p></div>
            <div class="achievement"><div class="achievement-number">99.9%</div><h3>Uptime</h3><p>Reliable &amp; stable performance</p></div>
        </div>

        <h3 class="values-title">Our Core Values</h3>
        <div class="values-grid">
            <div class="value-card"><h4>Innovation First</h4><p>We continuously push boundaries with cutting-edge technology to build software that transforms industries.</p></div>
            <div class="value-card"><h4>User-Centric Design</h4><p>Every feature is designed with the end user in mind, ensuring intuitive interfaces and seamless experiences.</p></div>
            <div class="value-card"><h4>Quality &amp; Reliability</h4><p>Our software undergoes rigorous testing to deliver enterprise-grade reliability and performance you can trust.</p></div>
            <div class="value-card"><h4>Continuous Improvement</h4><p>We actively listen to user feedback and continuously update our products with new features and improvements.</p></div>
        </div>
    </div>
</section>

<!-- ===== PORTFOLIO SECTION ===== -->
<section id="portfolio" class="section-muted">
    <div class="section-container">
        <div class="section-header">
            <div class="pill-badge"><span>Latest Updates</span></div>
            <h2>Product Releases &amp;<br /><span class="text-primary">Success Stories</span></h2>
            <p>Stay updated with our latest software releases, feature updates, and real-world success stories.</p>
        </div>

        <div class="portfolio-grid">
            @foreach (var project in portfolioProjects)
            {
                <div class="portfolio-card">
                    <div class="portfolio-image">
                        <img src="@project.Image" alt="@project.Title" loading="lazy" />
                        <div class="portfolio-date-badge">@project.ReleaseDate</div>
                    </div>
                    <div class="portfolio-body">
                        <span class="portfolio-category-tag">@project.Category</span>
                        <h3>@project.Title</h3>
                        <p>@project.Description</p>
                        <div class="tag-list sm">
                            @foreach (var tech in project.Technologies.Take(3))
                            {
                                <span class="outline-tag">@tech</span>
                            }
                        </div>
                        <div class="portfolio-actions">
                            <button class="btn-primary-sm">Read More</button>
                            <button class="btn-outline-sm">Details</button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="cta-card bordered">
            <h3>Want to See More?</h3>
            <p>Explore our comprehensive documentation, watch demos, and read more success stories.</p>
            <button class="btn-primary-lg">View All Updates</button>
        </div>
    </div>
</section>

<!-- ===== CONTACT SECTION ===== -->
<section id="contact" class="section-dark">
    <div class="section-container">
        <div class="section-header">
            <div class="pill-badge"><span>Get In Touch</span></div>
            <h2>Let's Start Building<br /><span class="text-primary">Something Amazing</span></h2>
            <p>Ready to transform your ideas into reality? Contact us today to discuss your project.</p>
        </div>

        <div class="contact-grid">
            <div class="contact-info">
                <h3>Get in Touch</h3>
                <p>We'd love to hear from you. Whether you have a question about our services, need a custom solution, or just want to say hello, we're here to help.</p>
                <div class="contact-cards">
                    <div class="contact-card"><div class="contact-icon blue-cyan"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></div><h4>Email Us</h4><p class="sm">Send us an email and we'll respond within 24 hours</p><p class="contact-value">hello@sominnercore.com</p></div>
                    <div class="contact-card"><div class="contact-icon green-teal"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div><h4>Call Us</h4><p class="sm">Speak directly with our team</p><p class="contact-value">+1 (555) 123-4567</p></div>
                    <div class="contact-card"><div class="contact-icon purple-pink"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></div><h4>Visit Us</h4><p class="sm">Come visit our office</p><p class="contact-value">123 Tech Street, Digital City</p></div>
