@page "/"
@inject PublicUiState PublicUi
@implements IDisposable

<PageTitle>KobNeti - Enterprise Software</PageTitle>

<div class="pub-home">
    <section class="pub-container pub-hero">
        <div>
            <div class="pub-pill">
                <span class="material-symbols-outlined" style="font-size:0.95rem;">cloud</span>
                290K+ DOWNLOADS WORLDWIDE
            </div>
            <h1>
                Enterprise Software That Powers
                <span class="accent"> Modern Business</span>
            </h1>
            <p class="pub-hero__desc">
                Elevate your operational efficiency with our cutting-edge, data-centric architecture. KobNeti delivers reliable innovation designed to scale with your most demanding marketing and operational needs.
            </p>
            <div class="pub-hero__actions">
                <a class="pub-btn-primary" href="/products" id="hero-explore-products-btn">
                    Explore Products
                    <span class="material-symbols-outlined" style="font-size:1rem;">arrow_forward</span>
                </a>
                <button type="button" class="pub-btn-secondary" id="hero-watch-demo-btn" @onclick="() => showDemo = true">
                    <span class="pub-btn-play">▶</span>
                    Watch Demo
                </button>
            </div>
            <div class="pub-hero__stats">
                <div>
                    <strong>24+</strong>
                    <span>Active Products</span>
                </div>
                <div>
                    <strong>290K</strong>
                    <span>Total Downloads</span>
                </div>
                <div>
                    <strong>1.2M</strong>
                    <span>Active Users</span>
                </div>
            </div>
        </div>

        <div class="pub-hero-card">
            <div class="pub-hero-card__glow"></div>
            <div class="pub-hero-card__panel">
                <div class="pub-hero-card__top">
                    <div style="display:flex;align-items:center;gap:0.5rem;">
                        <span class="pub-live-dot"><i></i> New Release</span>
                        <span style="color:#CBD5E1;font-weight:600;">KobNeti Home Page</span>
                    </div>
                    <span style="font-family:ui-monospace,monospace;color:#94A3B8;font-size:0.7rem;">v4.8.0</span>
                </div>
                <div style="border-radius:0.75rem;background:rgba(2,6,23,0.7);border:1px solid #1E293B;padding:1rem;">
                    <div style="display:flex;justify-content:space-between;font-size:0.75rem;margin-bottom:0.75rem;">
                        <span style="color:#94A3B8;">Dashboard Overview</span>
                        <span style="color:#34D399;font-weight:700;">↗ +34.8% this month</span>
                    </div>
                    <div class="pub-chart">
                        @foreach (var h in ChartHeights)
                        {
                            <span style="height:@h%"></span>
                        }
                    </div>
                    <div class="pub-mini-grid">
                        <div><span>Active Services</span><strong style="color:#fff;">6 Modules</strong></div>
                        <div><span>SLA Health</span><strong style="color:#34D399;">99.99%</strong></div>
                    </div>
                </div>
                <div style="margin-top:1rem;display:flex;justify-content:space-between;align-items:center;">
                    <span class="pub-pill" style="background:rgba(49,46,129,0.5);border-color:#4338CA;color:#C7D2FE;">5K+ Downloads Today</span>
                    <a href="/products" style="font-size:0.75rem;color:#A5B4FC;text-decoration:none;font-weight:600;">Explore Suite →</a>
                </div>
            </div>
        </div>
    </section>

    <section class="pub-container" id="product-carousel-showcase-section"
             @onmouseenter="() => paused = true"
             @onmouseleave="() => paused = false">
        <div class="pub-section-head">
            <div>
                <div class="pub-eyebrow">
                    <span class="material-symbols-outlined" style="font-size:0.95rem;">auto_awesome</span>
                    Ecosystem Spotlight
                </div>
                <h2>Featured Products &amp; Solutions</h2>
                <p>Explore the specialized applications engineered under the KobNeti platform.</p>
            </div>
            <div class="pub-carousel-nav">
                <button type="button" aria-label="Previous" @onclick="Prev">‹</button>
                <button type="button" aria-label="Next" @onclick="Next">›</button>
            </div>
        </div>

        @{
            var current = Products[activeSlide];
        }
        <div class="pub-slide">
            <div class="pub-slide__body">
                <div>
                    <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center;">
                        <span class="pub-badge @current.BadgeClass">@current.Badge</span>
                        <span style="font-size:0.75rem;font-weight:600;color:#475569;">@current.Category</span>
                    </div>
                    <h3>@current.Name</h3>
                    <p style="margin:0.75rem 0 0;color:#334155;line-height:1.55;">@current.Tagline</p>
                    <ul class="pub-features">
                        @foreach (var f in current.Features)
                        {
                            <li>@f</li>
                        }
                    </ul>
                </div>
                <div style="padding-top:1.5rem;border-top:1px solid #F1F5F9;display:flex;flex-wrap:wrap;justify-content:space-between;gap:1rem;align-items:center;">
                    <div>
                        <div style="font-size:0.7rem;color:#64748B;">Performance Metric</div>
                        <div style="font-weight:800;color:#4F46E5;">@current.Metric</div>
                    </div>
                    <a class="pub-btn-primary" href="/products" style="padding:0.65rem 1.25rem;font-size:0.75rem;">Explore @current.Name →</a>
                </div>
            </div>
            <div class="pub-slide__visual @current.VisualClass">
                <div>
                    <div style="font-size:0.65rem;font-family:ui-monospace,monospace;letter-spacing:0.08em;text-transform:uppercase;color:#A5B4FC;">Live Telemetry &amp; Rating</div>
                    <div style="font-size:1.5rem;font-weight:700;margin-top:0.5rem;">@current.Rating</div>
                    <div style="font-size:0.75rem;color:#CBD5E1;margin-top:0.25rem;">@current.Stats</div>
                </div>
                <div style="padding:1rem;border-radius:1rem;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);">
                    <div style="display:flex;justify-content:space-between;font-size:0.75rem;margin-bottom:0.5rem;">
                        <span>Integrated Modules</span>
                        <span style="color:#6EE7B7;">100% Operational</span>
                    </div>
                    <div style="height:6px;background:rgba(255,255,255,0.2);border-radius:999px;overflow:hidden;">
                        <div style="height:100%;width:100%;background:linear-gradient(90deg,#34D399,#5EEAD4);"></div>
                    </div>
                </div>
                <div style="display:flex;justify-content:space-between;font-size:0.7rem;color:#94A3B8;">
                    <span>Product ID: KOB-@current.Id.ToUpperInvariant()</span>
                    <span>Ready for Deployment</span>
                </div>
            </div>
        </div>

        <div class="pub-dots">
            @for (var i = 0; i < Products.Length; i++)
            {
                var idx = i;
                <button type="button" class="@(activeSlide == idx ? "is-active" : "")" @onclick="() => activeSlide = idx" aria-label="Go to slide @(idx + 1)"></button>
            }
        </div>
    </section>

    <section class="pub-container">
        <div class="pub-value-grid">
            <div class="pub-value-card">
                <div class="pub-value-card__icon"><span class="material-symbols-outlined">bolt</span></div>
                <h4>Ultra Low-Latency Pipelines</h4>
                <p>Engineered with sub-millisecond edge processing, ensuring real-time event streaming and rapid inventory synchronization.</p>
            </div>
            <div class="pub-value-card">
                <div class="pub-value-card__icon" style="background:#ECFDF5;color:#059669;"><span class="material-symbols-outlined">verified_user</span></div>
                <h4>Enterprise Zero-Trust Security</h4>
                <p>Tier 4 compliant encryption with automated threat detection and role-based cryptographic access controls.</p>
            </div>
            <div class="pub-value-card">
                <div class="pub-value-card__icon" style="background:#EFF6FF;color:#2563EB;"><span class="material-symbols-outlined">layers</span></div>
                <h4>Modular Microservice Mesh</h4>
                <p>Seamlessly scale individual services across multi-cloud regions without incurring downtime or architectural lock-in.</p>
            </div>
        </div>
    </section>

    <section class="pub-container">
        <div class="pub-banner">
            <div>
                <h3>Ready to modernize your operations?</h3>
                <p>Join leading organizations that trust KobNeti to orchestrate their infrastructure, commerce, and logistics.</p>
            </div>
            <div class="pub-banner__actions">
                <button type="button" class="on-white" @onclick="PublicUi.OpenGetStarted">Get Started Free</button>
                <a class="ghost" href="/contact" style="text-decoration:none;display:inline-flex;align-items:center;">Contact Sales</a>
            </div>
        </div>
    </section>
</div>

@if (showDemo)
{
    <div class="pub-modal-backdrop" @onclick="() => showDemo = false">
        <div class="pub-modal pub-modal--wide" @onclick:stopPropagation="true">
            <div class="pub-modal__head">
                <h3>KobNeti Platform Overview Demo</h3>
                <button type="button" class="pub-modal__close" @onclick="() => showDemo = false">✕</button>
            </div>
            <div class="pub-demo-stage">
                <button type="button" aria-label="Play">▶</button>
                <p style="font-size:0.75rem;font-weight:600;color:#CBD5E1;">Click to play interactive walk-through (2:45)</p>
            </div>
            <div style="display:flex;justify-content:flex-end;margin-top:1rem;">
                <button type="button" class="pub-btn-primary" @onclick="() => showDemo = false">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private int activeSlide;
    private bool paused;
    private bool showDemo;
    private System.Threading.Timer? timer;

    private static readonly int[] ChartHeights = [28, 39, 34, 49, 56, 53, 61, 72, 81, 89, 100];

    private sealed record FeaturedProduct(
        string Id, string Name, string Tagline, string Category, string Rating, string Stats,
        string Badge, string BadgeClass, string VisualClass, string[] Features, string Metric);

    private static readonly FeaturedProduct[] Products =
    [
        new("muuqwear", "MuuqWear",
            "Elevating comfort to an art form. The next generation of daily essentials.",
            "Consumer Lifestyle & E-Commerce", "4.9 ★ (18.4k reviews)", "140k+ units shipped",
            "Flagship Lifestyle", "pub-badge--rose", "pub-slide__visual--muuqwear",
            ["Active Stretch Tech", "Automated Warehouse Dispatch", "Global Express Shipping"],
            "99.4% Fulfillment Rate"),
        new("sompay", "SomPay",
            "Unified payment orchestration and multi-currency merchant ledger.",
            "Fintech & Digital Payments", "4.95 ★ (Enterprise)", "$42M+ monthly volume",
            "Fintech Core", "pub-badge--emerald", "pub-slide__visual--sompay",
            ["3DS Security Shield", "Instant Sub-Second Settlement", "Automated KYC & AML"],
            "99.999% Gateway Uptime"),
        new("gaarx", "GaarX",
            "Intelligent fleet management, real-time telemetry, and dispatch routing.",
            "Smart Mobility & Logistics", "4.8 ★ (120 fleets)", "12k vehicles connected",
            "IoT Mobility", "pub-badge--blue", "pub-slide__visual--gaarx",
            ["Sub-second GPS telemetry", "Predictive maintenance AI", "Automated fuel audit"],
            "-28% Fuel Burn Reduction"),
        new("salguri", "Salguri",
            "End-to-end supply chain trace, wholesale procurement, and inventory sync.",
            "Supply Chain Operations", "4.9 ★ (85 Enterprise)", "4.2M SKU inventory",
            "Enterprise Supply", "pub-badge--amber", "pub-slide__visual--salguri",
            ["Real-time batch tracking", "Supplier invoice automation", "Smart reorder alerts"],
            "99.8% Order Accuracy"),
    ];

    protected override void OnInitialized()
    {
        timer = new System.Threading.Timer(_ =>
        {
            if (paused) return;
            activeSlide = (activeSlide + 1) % Products.Length;
            _ = InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(4.5), TimeSpan.FromSeconds(4.5));
    }

    private void Prev() => activeSlide = activeSlide == 0 ? Products.Length - 1 : activeSlide - 1;
    private void Next() => activeSlide = (activeSlide + 1) % Products.Length;

    public void Dispose() => timer?.Dispose();
}
