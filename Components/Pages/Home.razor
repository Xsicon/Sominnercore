@code {
    private string selectedProductCategory = "All";
    private string selectedServiceCategory = "All";
    private int currentServiceSlide = 0;
    private Software? selectedSoftware = null;
    private bool chatOpen = false;
    private ContactFormModel contactForm = new();

    // Dynamic product state
    private List<Software> publishedProducts = new();
    private bool isLoadingProducts = true;
    private string? productLoadError;
    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadPublishedProducts();

        // Instant sync: refresh when admin creates/updates/deletes a product
        ChangeNotifier.OnChange += OnProductsChanged;

        // Fallback: auto-refresh every 60 seconds for release_date auto-publish
        _refreshTimer = new System.Threading.Timer(
            async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadPublishedProducts();
                    StateHasChanged();
                });
            },
            null,
            TimeSpan.FromSeconds(60),
            TimeSpan.FromSeconds(60));
    }

    private async void OnProductsChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadPublishedProducts();
            StateHasChanged();
        });
    }

    private async Task LoadPublishedProducts()
    {
        try
        {
            isLoadingProducts = true;
            productLoadError = null;
            publishedProducts = await ProductService.GetPublishedAsync();
        }
        catch (Exception ex)
        {
            productLoadError = "Unable to load products.";
            Console.WriteLine($"Error loading published products: {ex.Message}");
        }
        finally
        {
            isLoadingProducts = false;
        }
    }

    private async Task RetryLoadProducts()
    {
        await LoadPublishedProducts();
        StateHasChanged();
    }

    public void Dispose()
    {
        ChangeNotifier.OnChange -= OnProductsChanged;
        _refreshTimer?.Dispose();
    }

    private string[] DynamicProductCategories =>
        new[] { "All" }
            .Concat(publishedProducts
                .Where(p => !string.IsNullOrEmpty(p.Category))
                .Select(p => p.Category!)
                .Distinct()
                .OrderBy(c => c))
            .ToArray();

    private List<Software> FilteredPublishedProducts => selectedProductCategory == "All"
        ? publishedProducts
        : publishedProducts.Where(p => p.Category == selectedProductCategory).ToList();

    private List<ServiceInfo> FilteredServices => selectedServiceCategory == "All"
        ? services : services.Where(s => s.Category == selectedServiceCategory).ToList();

    private void NextServiceSlide() => currentServiceSlide = (currentServiceSlide + 1) % FilteredServices.Count;
    private void PrevServiceSlide() => currentServiceSlide = (currentServiceSlide - 1 + FilteredServices.Count) % FilteredServices.Count;

