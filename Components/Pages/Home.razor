            "#10b981" => "grad-emerald-teal",
            "#f97316" => "grad-orange-red",
            "#6366f1" => "grad-indigo-purple",
            "#0ea5e9" => "grad-sky-blue",
            "#ef4444" => "grad-orange-red",
            "#ec4899" => "grad-purple-pink",
            _ => "grad-blue-cyan"
        };
    }

    private static string FormatReleaseDate(string? dateStr)
    {
        if (string.IsNullOrEmpty(dateStr)) return "N/A";
        if (DateTime.TryParse(dateStr, CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            return date.ToString("MMMM d, yyyy");
        }
        return dateStr;
    }

    private static string FormatDownloads(int downloads)
    {
        if (downloads >= 1_000_000) return $"{downloads / 1_000_000.0:0.#}M+";
        if (downloads >= 1_000) return $"{downloads / 1_000.0:0.#}K+";
        return downloads.ToString("N0");
    }

