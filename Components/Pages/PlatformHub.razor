@page "/admin/platform"
@layout Components.Layout.AdminLayout
@using KobNeti.Services
@using KobNeti.Services.Support
@inject SupabaseAuthService AuthService
@inject SupportApiClient SupportApi
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Platform - KobNeti</PageTitle>

@if (isCheckingAuth)
{
    <div class="kn-hub-loading"><p>Loading...</p></div>
}
else if (!isAuthenticated)
{
    <div class="kn-hub-loading"><p>Redirecting to login...</p></div>
}
else
{
<KnHubShell BodyClass="kn-hub__body--scroll">
    <Tabs>
        <button type="button" class="kn-hub-subnav__item @(tab == "audit" ? "is-active" : "")" @onclick="@(() => SetTab("audit"))">Audit</button>
        <button type="button" class="kn-hub-subnav__item @(tab == "notifications" ? "is-active" : "")" @onclick="@(() => SetTab("notifications"))">Notifications</button>
        <button type="button" class="kn-hub-subnav__item @(tab == "files" ? "is-active" : "")" @onclick="@(() => SetTab("files"))">Files</button>
    </Tabs>
    <ChildContent>
        @if (tab == "notifications")
        {
            <PlatformNotificationsView @key="workspaceKey" />
        }
        else if (tab == "files")
        {
            <PlatformFilesView @key="workspaceKey" />
        }
        else
        {
            <PlatformAuditView @key="workspaceKey" />
        }
    </ChildContent>
</KnHubShell>
}

@code {
    private bool isCheckingAuth = true;
    private bool isAuthenticated;
    private string tab = "audit";
    private int workspaceEpoch;
    private string workspaceKey => $"{SupportApi.TenantId}:{workspaceEpoch}";

    protected override async Task OnInitializedAsync()
    {
        var (user, session) = await AuthService.GetAuthenticatedAdminAsync();
        if (user == null || session == null)
        {
            isCheckingAuth = false;
            Navigation.NavigateTo("/admin/login");
            return;
        }
        isAuthenticated = true;
        isCheckingAuth = false;
        ApplyTabFromQuery();
        Navigation.LocationChanged += OnLocationChanged;
        SupportApi.TenantChanged += OnTenantChanged;
        try { await SupportApi.EnsureAgentTokenAsync(); } catch { }
    }

    private void OnTenantChanged() { workspaceEpoch++; _ = InvokeAsync(StateHasChanged); }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(() => { ApplyTabFromQuery(); StateHasChanged(); });

    private void ApplyTabFromQuery()
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query.TrimStart('?');
        if (string.IsNullOrEmpty(query)) return;
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 2 && string.Equals(Uri.UnescapeDataString(pair[0]), "tab", StringComparison.OrdinalIgnoreCase))
            {
                var t = Uri.UnescapeDataString(pair[1]);
                if (t is "audit" or "notifications" or "files")
                    tab = t;
                else if (t == "integrations")
                    tab = "audit";
            }
        }
    }

    private void SetTab(string next)
    {
        tab = next;
        Navigation.NavigateTo($"/admin/platform?tab={next}", replace: true);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        SupportApi.TenantChanged -= OnTenantChanged;
    }
}
