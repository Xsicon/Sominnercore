@page "/admin/calendar"
@layout Components.Layout.AdminLayout
@using KobNeti.Services
@using KobNeti.Services.Support
@inject SupabaseAuthService AuthService
@inject SupportApiClient SupportApi
@inject NavigationManager Navigation

<PageTitle>Calendar - KobNeti</PageTitle>

@if (ready)
{
<KnHubShell BodyClass="kn-hub__body--scroll">
    <ChildContent>
        <div class="kn-s3-page">
            <div class="kn-s3-toolbar" style="margin-bottom:1rem;">
                <input placeholder="Event title" @bind="title" style="flex:1;max-width:240px;border:1px solid var(--kn-border);border-radius:var(--kn-radius-sm);padding:0.5rem;" />
                <input type="datetime-local" @bind="starts" style="border:1px solid var(--kn-border);border-radius:var(--kn-radius-sm);padding:0.5rem;" />
                <button type="button" class="kn-btn kn-btn--primary kn-btn--sm" @onclick="Create">Add event</button>
                <button type="button" class="kn-btn kn-btn--outline kn-btn--sm" @onclick="Remind">Send reminders</button>
            </div>
            @if (!string.IsNullOrEmpty(msg)) { <p class="kn-s3-empty">@msg</p> }
            @foreach (var e in events)
            {
                <div class="kn-s3-list-row">
                    <span><strong>@e.Title</strong> · @e.EventType · @e.StartsAt.ToLocalTime().ToString("g")</span>
                </div>
            }
        </div>
    </ChildContent>
</KnHubShell>
}

@code {
    private bool ready;
    private string? msg;
    private string title = "";
    private DateTime? starts = DateTime.Now.AddDays(1);
    private List<CalendarEventDto> events = [];

    protected override async Task OnInitializedAsync()
    {
        var (user, session) = await AuthService.GetAuthenticatedAdminAsync();
        if (user == null || session == null) { Navigation.NavigateTo("/admin/login"); return; }
        ready = true;
        try { await SupportApi.EnsureAgentTokenAsync(); } catch { }
        await Load();
    }

    private async Task Load()
    {
        var r = await SupportApi.GetCalendarEventsAsync();
        events = r.Success ? r.Data ?? [] : [];
        if (!r.Success) msg = r.Message;
    }

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(title) || starts is null) return;
        var r = await SupportApi.CreateCalendarEventAsync(title.Trim(), starts.Value.ToUniversalTime());
        msg = r.Success ? "Created" : r.Message;
        if (r.Success) title = "";
        await Load();
    }

    private async Task Remind()
    {
        var r = await SupportApi.SendCalendarRemindersAsync();
        msg = r.Success ? $"Sent {r.Data} reminders" : r.Message;
    }
}
