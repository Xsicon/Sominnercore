@page "/admin/support"
@layout Components.Layout.AdminLayout
@using KobNeti.Services
@using KobNeti.Services.Support
@using KobNeti.Components.Support
@inject SupabaseAuthService AuthService
@inject SupportApiClient SupportApi
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Support Hub - KobNeti</PageTitle>

@if (isCheckingAuth)
{
    <div class="sh-loading">
        <p>Loading...</p>
    </div>
}
else if (!isAuthenticated)
{
    <div class="sh-loading">
        <p>Redirecting to login...</p>
    </div>
}
else
{
<div class="admin-dashboard support-hub admin-dashboard--embedded">
    <main class="main-content">
        <header class="dashboard-header">
            <div class="header-content">
                <div>
                    <h1>@GetTabTitle()</h1>
                    <p class="header-subtitle">@GetTabSubtitle()</p>
                </div>
                <div class="sh-header-actions">
                    <span class="sh-active-project" title="@SupportApi.TenantKey">@SupportApi.DisplayName</span>
                </div>
            </div>
        </header>

        <nav class="ops-subnav">
            <button type="button" class="ops-subnav__item @(activeTab == "overview" ? "active" : "")" @onclick="@(() => SetTab("overview"))">Overview</button>
            <button type="button" class="ops-subnav__item @(activeTab == "chat" ? "active" : "")" @onclick="@(() => SetTab("chat"))">Live Chat</button>
            <button type="button" class="ops-subnav__item @(activeTab == "tickets" ? "active" : "")" @onclick="@(() => SetTab("tickets"))">Tickets</button>
            <button type="button" class="ops-subnav__item @(activeTab == "kb" ? "active" : "")" @onclick="@(() => SetTab("kb"))">Knowledge Base</button>
            <button type="button" class="ops-subnav__item @(activeTab == "internal" ? "active" : "")" @onclick="@(() => SetTab("internal"))">Internal Chat</button>
            <button type="button" class="ops-subnav__item @(activeTab == "settings" ? "active" : "")" @onclick="@(() => SetTab("settings"))">Settings</button>
        </nav>

        @if (activeTab == "overview")
        {
            <div class="sh-scroll" @key="workspaceKey">
                <SupportOverviewView />
            </div>
        }
        else if (activeTab == "tickets")
        {
            <div class="sh-scroll" @key="workspaceKey">
                <SupportTicketsView />
            </div>
        }
        else if (activeTab == "kb")
        {
            <div class="sh-scroll" @key="workspaceKey">
                <SupportKbView />
            </div>
        }
        else if (activeTab == "internal")
        {
            <div class="sh-scroll" @key="workspaceKey">
                <SupportInternalView />
            </div>
        }
        else if (activeTab == "settings")
        {
            <div class="sh-scroll" @key="@($"settings-{workspaceKey}")">
                <SupportSettingsView OnTenantSelected="SelectTenantAsync" />
            </div>
        }
        else
        {
            <div class="sh-scroll sh-scroll--chat" @key="workspaceKey">
                <SupportLiveChatView />
            </div>
        }
    </main>
</div>
}

@code {
    private bool isCheckingAuth = true;
    private bool isAuthenticated;
    private string activeTab = "overview";
    private int workspaceEpoch;

    private string workspaceKey => $"{SupportApi.TenantId}:{workspaceEpoch}";

    protected override async Task OnInitializedAsync()
    {
        var (user, session) = await AuthService.GetAuthenticatedAdminAsync();
        if (user == null || session == null)
        {
            isAuthenticated = false;
            isCheckingAuth = false;
            Navigation.NavigateTo("/admin/login");
            return;
        }

        isAuthenticated = true;
        isCheckingAuth = false;
        ApplyTabFromQuery();
        SupportApi.TenantChanged += OnTenantChanged;

        try
        {
            await SupportApi.EnsureAgentTokenAsync();
        }
        catch
        {
            // OpsShell also exchanges; page views will surface errors.
        }
    }

    private void OnTenantChanged()
    {
        workspaceEpoch++;
        _ = InvokeAsync(StateHasChanged);
    }

    private Task SelectTenantAsync(SupportTenantDto tenant)
    {
        SupportApi.SetTenant(tenant.TenantId, tenant.PublicKey, tenant.DisplayName, tenant.PublicHelpCenterUrl);
        workspaceEpoch++;
        return Task.CompletedTask;
    }

    private void ApplyTabFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrEmpty(query))
            return;

        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length != 2) continue;
            if (!string.Equals(Uri.UnescapeDataString(pair[0]), "tab", StringComparison.OrdinalIgnoreCase))
                continue;

            var tab = Uri.UnescapeDataString(pair[1]);
            if (tab is "overview" or "chat" or "tickets" or "kb" or "internal" or "settings")
                activeTab = tab;
            break;
        }
    }

    private Task SetTab(string tab)
    {
        activeTab = tab;
        var url = tab == "overview" ? "/admin/support" : $"/admin/support?tab={tab}";
        Navigation.NavigateTo(url, replace: true);
        return Task.CompletedTask;
    }

    private string GetTabTitle() => activeTab switch
    {
        "chat" => "Live Chat",
        "tickets" => "Tickets",
        "kb" => "Knowledge Base",
        "internal" => "Internal Chat",
        "settings" => "Settings",
        _ => "Overview"
    };

    private string GetTabSubtitle() => activeTab switch
    {
        "chat" => $"Respond to {SupportApi.DisplayName} customers in real time",
        "tickets" => $"Route and resolve {SupportApi.DisplayName} tickets",
        "kb" => $"Help articles for {SupportApi.DisplayName}",
        "internal" => "Coming soon",
        "settings" => "Project desks and API connection",
        _ => $"Support analytics for {SupportApi.DisplayName}"
    };

    public void Dispose() => SupportApi.TenantChanged -= OnTenantChanged;
}
