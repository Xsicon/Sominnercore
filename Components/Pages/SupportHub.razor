@page "/admin/support"
@layout Components.Layout.AdminLayout
@using SominnercoreNew.Services
@using SominnercoreNew.Components.Support
@inject SupabaseAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Support Hub - Sominnercore</PageTitle>

@if (isCheckingAuth)
{
    <div class="sh-loading">
        <p>Loading...</p>
    </div>
}
else if (!isAuthenticated)
{
    <div class="sh-loading">
        <p>Redirecting to login...</p>
    </div>
}
else
{
<div class="admin-dashboard support-hub @(isSidebarOpen ? "sidebar-open" : "")">
    <aside class="sidebar @(isSidebarOpen ? "open" : "")">
        <div class="sidebar-header">
            <div class="brand">
                <div class="brand-dot"></div>
                <span>Support Hub</span>
            </div>
            <p class="brand-subtitle">Multi-app customer support</p>
        </div>

        <nav class="sidebar-nav">
            <a href="#" class="nav-item @(activeTab == "overview" ? "active" : "")" @onclick="@(() => SetTab("overview"))" @onclick:preventDefault>
                <span class="material-symbols-outlined">dashboard</span>
                <span>Overview</span>
            </a>
            <a href="#" class="nav-item @(activeTab == "chat" ? "active" : "")" @onclick="@(() => SetTab("chat"))" @onclick:preventDefault>
                <span class="material-symbols-outlined">support_agent</span>
                <span>Live Chat</span>
            </a>
            <a href="#" class="nav-item @(activeTab == "tickets" ? "active" : "")" @onclick="@(() => SetTab("tickets"))" @onclick:preventDefault>
                <span class="material-symbols-outlined">confirmation_number</span>
                <span>Tickets</span>
            </a>
            <a href="#" class="nav-item @(activeTab == "kb" ? "active" : "")" @onclick="@(() => SetTab("kb"))" @onclick:preventDefault>
                <span class="material-symbols-outlined">menu_book</span>
                <span>Knowledge Base</span>
            </a>
            <a href="#" class="nav-item @(activeTab == "internal" ? "active" : "")" @onclick="@(() => SetTab("internal"))" @onclick:preventDefault>
                <span class="material-symbols-outlined">forum</span>
                <span>Internal Chat</span>
            </a>
            <a href="#" class="nav-item @(activeTab == "settings" ? "active" : "")" @onclick="@(() => SetTab("settings"))" @onclick:preventDefault>
                <span class="material-symbols-outlined">settings</span>
                <span>Settings</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="user-info">
                <div class="user-avatar">
                    <span>@GetUserInitials()</span>
                </div>
                <div class="user-details">
                    <p class="user-name">@GetUserDisplayName()</p>
                    <p class="user-email">@currentUserEmail</p>
                </div>
            </div>
            <a href="/admin" class="settings-link back-dashboard-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 19-7-7 7-7"/>
                    <path d="M19 12H5"/>
                </svg>
                <span>Back to Dashboard</span>
            </a>
            <button class="logout-button" @onclick="HandleLogout">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" x2="9" y1="12" y2="12"/>
                </svg>
                <span>Logout</span>
            </button>
        </div>
    </aside>

    @if (isSidebarOpen)
    {
        <div class="sh-overlay" @onclick="ToggleSidebar"></div>
    }

    <main class="main-content">
        <header class="dashboard-header">
            <button class="menu-toggle" @onclick="ToggleSidebar" type="button">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" x2="20" y1="12" y2="12"/>
                    <line x1="4" x2="20" y1="6" y2="6"/>
                    <line x1="4" x2="20" y1="18" y2="18"/>
                </svg>
            </button>
            <div class="header-content">
                <div>
                    <h1>@GetTabTitle()</h1>
                    <p class="header-subtitle">@GetTabSubtitle()</p>
                </div>
                <a href="/admin" class="admin-access-btn back-dashboard-btn">Back to Dashboard</a>
            </div>
        </header>

        @if (activeTab == "overview")
        {
            <div class="sh-scroll">
                <SupportOverviewView />
            </div>
        }
        else if (activeTab == "tickets")
        {
            <div class="sh-scroll">
                <SupportTicketsView />
            </div>
        }
        else if (activeTab == "kb")
        {
            <div class="sh-scroll">
                <SupportKbView />
            </div>
        }
        else if (activeTab == "internal")
        {
            <div class="sh-scroll">
                <SupportInternalView />
            </div>
        }
        else if (activeTab == "settings")
        {
            <div class="sh-scroll">
                <SupportSettingsView />
            </div>
        }
        else
        {
        <div class="sh-workspace">
            <!-- Conversation list -->
            <section class="sh-list-pane @(selectedConversation != null && showChatOnMobile ? "hidden-mobile" : "")">
                <div class="sh-list-toolbar">
                    <div class="sh-search">
                        <span class="material-symbols-outlined">search</span>
                        <input type="text"
                               placeholder="Search conversations..."
                               @bind="searchQuery"
                               @bind:event="oninput" />
                    </div>
                    <div class="sh-filters">
                        @foreach (var filter in brandFilters)
                        {
                            <button type="button"
                                    class="sh-filter-chip @(activeBrandFilter == filter.Key ? "active" : "")"
                                    @onclick="() => activeBrandFilter = filter.Key">
                                @filter.Label
                            </button>
                        }
                    </div>
                </div>

                <div class="sh-ticket-list">
                    @foreach (var conv in FilteredConversations)
                    {
                        var isActive = selectedConversation?.Id == conv.Id;
                        <button type="button"
                                class="sh-ticket @(isActive ? "active" : "") brand-@conv.BrandKey"
                                @onclick="() => SelectConversation(conv)">
                            @if (isActive)
                            {
                                <span class="sh-ticket-stripe"></span>
                            }
                            <div class="sh-ticket-body">
                                <div class="sh-ticket-avatar" style="background: @conv.AvatarColor">
                                    @conv.Initials
                                    @if (conv.IsLive)
                                    {
                                        <span class="sh-live-dot"></span>
                                    }
                                </div>
                                <div class="sh-ticket-content">
                                    <div class="sh-ticket-top">
                                        <h4>@conv.Name</h4>
                                        <span class="sh-ticket-time">@conv.LastMessageTime</span>
                                    </div>
                                    <p class="sh-ticket-preview">@conv.LastMessage</p>
                                    <div class="sh-ticket-tags">
                                        <span class="sh-tag brand-@conv.BrandKey">@conv.BrandLabel</span>
                                        <span class="sh-tag status-@conv.Status.ToLowerInvariant()">@conv.Status</span>
                                    </div>
                                </div>
                                @if (conv.UnreadCount > 0)
                                {
                                    <span class="sh-unread">@conv.UnreadCount</span>
                                }
                            </div>
                        </button>
                    }

                    @if (!FilteredConversations.Any())
                    {
                        <div class="sh-empty-list">
                            <p>No conversations match your filters.</p>
                        </div>
                    }
                </div>
            </section>

            <!-- Chat detail -->
            <section class="sh-chat-pane @(selectedConversation == null || !showChatOnMobile ? "hidden-mobile-empty" : "")">
                @if (selectedConversation == null)
                {
                    <div class="sh-chat-empty">
                        <span class="material-symbols-outlined">forum</span>
                        <h3>Select a conversation</h3>
                        <p>Choose a customer from the queue to view and reply.</p>
                    </div>
                }
                else
                {
                    <div class="sh-chat-header">
                        <button type="button" class="sh-back-mobile" @onclick="() => showChatOnMobile = false">
                            <span class="material-symbols-outlined">arrow_back</span>
                        </button>
                        <div class="sh-chat-identity">
                            <div class="sh-chat-avatar" style="background: @selectedConversation.AvatarColor">
                                @selectedConversation.Initials
                            </div>
                            <div>
                                <h3>
                                    @selectedConversation.Name
                                    @if (selectedConversation.IsLive)
                                    {
                                        <span class="sh-live-badge">
                                            <span class="sh-live-dot-inline"></span>
                                            LIVE
                                        </span>
                                    }
                                </h3>
                                <div class="sh-chat-meta">
                                    @if (!string.IsNullOrEmpty(selectedConversation.Reference))
                                    {
                                        <span>@selectedConversation.Reference</span>
                                        <span class="sh-meta-sep"></span>
                                    }
                                    <span class="sh-tag brand-@selectedConversation.BrandKey">@selectedConversation.BrandLabel</span>
                                </div>
                            </div>
                        </div>
                        <div class="sh-chat-actions">
                            <button type="button" class="sh-icon-btn" title="Notes">
                                <span class="material-symbols-outlined">sticky_note_2</span>
                            </button>
                            <button type="button" class="sh-icon-btn" title="Assign">
                                <span class="material-symbols-outlined">person_add</span>
                            </button>
                            <button type="button" class="sh-icon-btn" title="More">
                                <span class="material-symbols-outlined">more_vert</span>
                            </button>
                            <button type="button" class="sh-end-chat">
                                <span class="material-symbols-outlined">cancel</span>
                                End Chat
                            </button>
                        </div>
                    </div>

                    <div class="sh-messages">
                        @{
                            string? lastDate = null;
                        }
                        @foreach (var msg in GetMessagesForConversation(selectedConversation.Id))
                        {
                            if (msg.DateLabel != lastDate)
                            {
                                lastDate = msg.DateLabel;
                                <div class="sh-date-divider">
                                    <span></span>
                                    <em>@msg.DateLabel</em>
                                    <span></span>
                                </div>
                            }

                            @if (msg.IsInternalNote)
                            {
                                <div class="sh-msg note">
                                    <span class="sh-msg-meta">Internal note • @msg.Time</span>
                                    <div class="sh-bubble note">@msg.Text</div>
                                </div>
                            }
                            else if (msg.IsFromCustomer)
                            {
                                <div class="sh-msg customer">
                                    <span class="sh-msg-meta">@selectedConversation.Name • @msg.Time</span>
                                    <div class="sh-bubble customer">@msg.Text</div>
                                </div>
                            }
                            else
                            {
                                <div class="sh-msg agent">
                                    <span class="sh-msg-meta">
                                        <span class="material-symbols-outlined filled">done_all</span>
                                        You • @msg.Time
                                    </span>
                                    <div class="sh-bubble agent">@msg.Text</div>
                                </div>
                            }
                        }
                    </div>

                    <div class="sh-composer">
                        <div class="sh-composer-box @(isInternalNote ? "note-mode" : "")">
                            <div class="sh-composer-toolbar">
                                <button type="button" class="sh-icon-btn sm" title="Attach File">
                                    <span class="material-symbols-outlined">attach_file</span>
                                </button>
                                <button type="button" class="sh-icon-btn sm" title="Insert Template">
                                    <span class="material-symbols-outlined">quick_reference_all</span>
                                </button>
                                <label class="sh-note-toggle">
                                    <span>Internal Note</span>
                                    <button type="button"
                                            class="sh-switch @(isInternalNote ? "on" : "")"
                                            @onclick="() => isInternalNote = !isInternalNote"
                                            aria-pressed="@isInternalNote">
                                        <span class="sh-switch-knob"></span>
                                    </button>
                                </label>
                            </div>
                            <div class="sh-composer-input">
                                <textarea @bind="draftMessage"
                                          @bind:event="oninput"
                                          placeholder="@(isInternalNote ? "Add an internal note..." : "Type your message...")"
                                          rows="3"></textarea>
                                <button type="button" class="sh-send" @onclick="SendMessage" disabled="@string.IsNullOrWhiteSpace(draftMessage)">
                                    <span class="material-symbols-outlined filled">send</span>
                                </button>
                            </div>
                        </div>
                        <p class="sh-composer-footer">
                            Responding as <strong>@GetUserDisplayName()</strong>
                        </p>
                    </div>
                }
            </section>
        </div>
        }
    </main>
</div>
}

@code {
    private bool isCheckingAuth = true;
    private bool isAuthenticated;
    private string currentUserEmail = "";
    private bool isSidebarOpen;
    private string activeTab = "overview";
    private bool showChatOnMobile;
    private string searchQuery = "";
    private string activeBrandFilter = "all";
    private string draftMessage = "";
    private bool isInternalNote;
    private Conversation? selectedConversation;

    private readonly List<(string Key, string Label)> brandFilters = new()
    {
        ("all", "All"),
        ("muuqwear", "Muuqwear"),
        ("salguri-customer", "Salguri Customer"),
        ("salguri-business", "Salguri Business")
    };

    private readonly List<Conversation> conversations = new()
    {
        new()
        {
            Id = 1,
            Name = "Alex Thompson",
            Email = "alex@example.com",
            Initials = "AT",
            AvatarColor = "#1e40af",
            BrandKey = "muuqwear",
            BrandLabel = "MUUQWEAR",
            Status = "ACTIVE",
            IsLive = true,
            Reference = "Order #MQ-88492",
            LastMessage = "Thanks for the quick response! I'm interested in...",
            LastMessageTime = "Nov 7",
            UnreadCount = 2
        },
        new()
        {
            Id = 2,
            Name = "Maria Garcia",
            Email = "maria@retailcorp.com",
            Initials = "MG",
            AvatarColor = "#6b21a8",
            BrandKey = "salguri-business",
            BrandLabel = "BUSINESS",
            Status = "WAITING",
            IsLive = false,
            Reference = "Ticket #SG-2201",
            LastMessage = "When can we schedule a call?",
            LastMessageTime = "Nov 1",
            UnreadCount = 1
        },
        new()
        {
            Id = 3,
            Name = "Robert Kim",
            Email = "robert@example.com",
            Initials = "RK",
            AvatarColor = "#059669",
            BrandKey = "salguri-customer",
            BrandLabel = "CUSTOMER",
            Status = "RESOLVED",
            IsLive = false,
            Reference = "Order #SG-99102",
            LastMessage = "Perfect, thank you for your help!",
            LastMessageTime = "Nov 6",
            UnreadCount = 0
        },
        new()
        {
            Id = 4,
            Name = "Jamie Lee",
            Email = "jamie@muuq.wear",
            Initials = "JL",
            AvatarColor = "#0f766e",
            BrandKey = "muuqwear",
            BrandLabel = "MUUQWEAR",
            Status = "WAITING",
            IsLive = false,
            Reference = "Order #MQ-90112",
            LastMessage = "Can I change the shipping address?",
            LastMessageTime = "Nov 5",
            UnreadCount = 3
        }
    };

    private readonly Dictionary<int, List<ChatMessage>> messagesData = new()
    {
        {
            1, new List<ChatMessage>
            {
                new() { Text = "Hi, I'm interested in your web development services. Can you help me build an e-commerce platform?", IsFromCustomer = true, Time = "09:15 PM", DateLabel = "Nov 7, 2023" },
                new() { Text = "Hello Alex! Absolutely, we'd be happy to help. We have extensive experience building scalable e-commerce platforms. Could you tell me more about your requirements?", IsFromCustomer = false, Time = "09:18 PM", DateLabel = "Nov 7, 2023" },
                new() { Text = "I need a platform that can handle around 5,000 products with payment integration, inventory management, and customer reviews.", IsFromCustomer = true, Time = "09:25 PM", DateLabel = "Nov 7, 2023" },
                new() { Text = "Thanks for the quick response! Also, do you support multi-currency?", IsFromCustomer = true, Time = "09:30 PM", DateLabel = "Nov 7, 2023" }
            }
        },
        {
            2, new List<ChatMessage>
            {
                new() { Text = "Hello, I'm looking for mobile app development services.", IsFromCustomer = true, Time = "10:00 AM", DateLabel = "Nov 1, 2023" },
                new() { Text = "Hi Maria! We'd love to help. What kind of app are you looking to build?", IsFromCustomer = false, Time = "10:05 AM", DateLabel = "Nov 1, 2023" },
                new() { Text = "When can we schedule a call?", IsFromCustomer = true, Time = "10:15 AM", DateLabel = "Nov 1, 2023" }
            }
        },
        {
            3, new List<ChatMessage>
            {
                new() { Text = "We need cloud migration services for our enterprise.", IsFromCustomer = true, Time = "02:00 PM", DateLabel = "Nov 6, 2023" },
                new() { Text = "Perfect, thank you for your help!", IsFromCustomer = true, Time = "04:30 PM", DateLabel = "Nov 6, 2023" }
            }
        },
        {
            4, new List<ChatMessage>
            {
                new() { Text = "Can I change the shipping address on my recent order?", IsFromCustomer = true, Time = "11:20 AM", DateLabel = "Nov 5, 2023" }
            }
        }
    };

    private IEnumerable<Conversation> FilteredConversations =>
        conversations.Where(c =>
        {
            if (activeBrandFilter != "all" && c.BrandKey != activeBrandFilter)
                return false;

            if (string.IsNullOrWhiteSpace(searchQuery))
                return true;

            return c.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                || c.Email.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                || c.LastMessage.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                || c.BrandLabel.Contains(searchQuery, StringComparison.OrdinalIgnoreCase);
        });

    protected override async Task OnInitializedAsync()
    {
        var (user, session) = await AuthService.GetAuthenticatedAdminAsync();
        if (user == null || session == null)
        {
            isAuthenticated = false;
            isCheckingAuth = false;
            Navigation.NavigateTo("/admin/login");
            return;
        }

        currentUserEmail = user.Email ?? "";
        isAuthenticated = true;
        isCheckingAuth = false;
        ApplyTabFromQuery();
        selectedConversation = conversations.FirstOrDefault();
    }

    private void ApplyTabFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrEmpty(query))
            return;

        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length != 2) continue;
            if (!string.Equals(Uri.UnescapeDataString(pair[0]), "tab", StringComparison.OrdinalIgnoreCase))
                continue;

            var tab = Uri.UnescapeDataString(pair[1]);
            if (tab is "overview" or "chat" or "tickets" or "kb" or "internal" or "settings")
                activeTab = tab;
            break;
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        isSidebarOpen = false;
        var url = tab == "overview" ? "/admin/support" : $"/admin/support?tab={tab}";
        Navigation.NavigateTo(url, replace: true);
    }

    private string GetTabTitle() => activeTab switch
    {
        "chat" => "Live Chat",
        "tickets" => "Tickets",
        "kb" => "Knowledge Base",
        "internal" => "Internal Chat",
        "settings" => "Settings",
        _ => "Overview"
    };

    private string GetTabSubtitle() => activeTab switch
    {
        "chat" => "Multi-brand customer conversations",
        "tickets" => "Route, assign, and resolve support tickets",
        "kb" => "Help articles and macros for every brand",
        "internal" => "Private agent collaboration channels",
        "settings" => "Desks, routing, and agent preferences",
        _ => "Support analytics across all connected apps"
    };

    private void ToggleSidebar() => isSidebarOpen = !isSidebarOpen;

    private void SelectConversation(Conversation conv)
    {
        selectedConversation = conv;
        conv.UnreadCount = 0;
        showChatOnMobile = true;
        isSidebarOpen = false;
    }

    private List<ChatMessage> GetMessagesForConversation(int convId) =>
        messagesData.TryGetValue(convId, out var list) ? list : new List<ChatMessage>();

    private Task SendMessage()
    {
        if (selectedConversation == null || string.IsNullOrWhiteSpace(draftMessage))
            return Task.CompletedTask;

        if (!messagesData.ContainsKey(selectedConversation.Id))
            messagesData[selectedConversation.Id] = new List<ChatMessage>();

        messagesData[selectedConversation.Id].Add(new ChatMessage
        {
            Text = draftMessage.Trim(),
            IsFromCustomer = false,
            IsInternalNote = isInternalNote,
            Time = DateTime.Now.ToString("hh:mm tt"),
            DateLabel = DateTime.Now.ToString("MMM d, yyyy")
        });

        if (!isInternalNote)
        {
            selectedConversation.LastMessage = draftMessage.Trim();
            selectedConversation.LastMessageTime = "Just now";
        }

        draftMessage = "";
        return Task.CompletedTask;
    }

    private async Task HandleLogout()
    {
        await AuthService.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    private string GetUserInitials()
    {
        if (string.IsNullOrEmpty(currentUserEmail)) return "?";
        var name = currentUserEmail.Split('@')[0];
        return name.Length >= 2
            ? (name[0].ToString() + name[1]).ToUpperInvariant()
            : name.ToUpperInvariant();
    }

    private string GetUserDisplayName()
    {
        if (string.IsNullOrEmpty(currentUserEmail)) return "Admin User";
        var name = currentUserEmail.Split('@')[0];
        return name.Length == 0 ? "Admin User" : char.ToUpperInvariant(name[0]) + name[1..];
    }

    private sealed class Conversation
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Initials { get; set; } = "";
        public string AvatarColor { get; set; } = "";
        public string BrandKey { get; set; } = "";
        public string BrandLabel { get; set; } = "";
        public string Status { get; set; } = "";
        public bool IsLive { get; set; }
        public string Reference { get; set; } = "";
        public string LastMessage { get; set; } = "";
        public string LastMessageTime { get; set; } = "";
        public int UnreadCount { get; set; }
    }

    private sealed class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsFromCustomer { get; set; }
        public bool IsInternalNote { get; set; }
        public string Time { get; set; } = "";
        public string DateLabel { get; set; } = "";
    }
}
