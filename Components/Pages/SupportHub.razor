@page "/admin/support"
@layout Components.Layout.AdminLayout
@using KobNeti.Services
@using KobNeti.Services.Support
@using KobNeti.Components.Support
@inject SupabaseAuthService AuthService
@inject SupportApiClient SupportApi
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Support Hub - KobNeti</PageTitle>

@if (isCheckingAuth)
{
    <div class="kn-hub-loading"><p>Loading...</p></div>
}
else if (!isAuthenticated)
{
    <div class="kn-hub-loading"><p>Redirecting to login...</p></div>
}
else
{
<KnHubShell HubClass="@HubShellClass" BodyClass="@HubBodyClass">
    <Tabs>
        <button type="button" class="kn-hub-subnav__item @(activeTab == "overview" ? "is-active" : "")" @onclick="@(() => SetTab("overview"))">Overview</button>
        <button type="button" class="kn-hub-subnav__item @(activeTab == "chat" ? "is-active" : "")" @onclick="@(() => SetTab("chat"))">Live Chat</button>
        <button type="button" class="kn-hub-subnav__item @(activeTab == "tickets" ? "is-active" : "")" @onclick="@(() => SetTab("tickets"))">Tickets</button>
        <button type="button" class="kn-hub-subnav__item @(activeTab == "incidents" ? "is-active" : "")" @onclick="@(() => SetTab("incidents"))">Incidents</button>
        <button type="button" class="kn-hub-subnav__item @(activeTab == "kb" ? "is-active" : "")" @onclick="@(() => SetTab("kb"))">Knowledge Base</button>
        <button type="button" class="kn-hub-subnav__item @(activeTab == "internal" ? "is-active" : "")" @onclick="@(() => SetTab("internal"))">Internal Chat</button>
        <button type="button" class="kn-hub-subnav__item @(activeTab == "settings" ? "is-active" : "")" @onclick="@(() => SetTab("settings"))">Settings</button>
    </Tabs>
    <ChildContent>
        @if (activeTab == "overview")
        {
            <SupportOverviewView @key="workspaceKey" />
        }
        else if (activeTab == "tickets")
        {
            <SupportTicketsView @key="workspaceKey" />
        }
        else if (activeTab == "incidents")
        {
            <SupportIncidentsView @key="workspaceKey" />
        }
        else if (activeTab == "kb")
        {
            <SupportKbView @key="workspaceKey" />
        }
        else if (activeTab == "internal")
        {
            <SupportInternalView @key="workspaceKey" />
        }
        else if (activeTab == "settings")
        {
            <SupportSettingsView @key="@($"settings-{workspaceKey}")" OnTenantSelected="SelectTenantAsync" />
        }
        else
        {
            <SupportLiveChatView @key="workspaceKey" />
        }
    </ChildContent>
</KnHubShell>
}

@code {
    private bool isCheckingAuth = true;
    private bool isAuthenticated;
    private string activeTab = "overview";
    private int workspaceEpoch;

    private string workspaceKey => $"{SupportApi.TenantId}:{workspaceEpoch}";

    private string HubShellClass => activeTab == "chat" ? "kn-hub--live-chat" : "";

    private string HubBodyClass => activeTab == "chat" ? "kn-hub__body--live-chat" : "kn-hub__body--scroll";

    protected override async Task OnInitializedAsync()
    {
        var (user, session) = await AuthService.GetAuthenticatedAdminAsync();
        if (user == null || session == null)
        {
            isAuthenticated = false;
            isCheckingAuth = false;
            Navigation.NavigateTo("/admin/login");
            return;
        }

        isAuthenticated = true;
        isCheckingAuth = false;
        ApplyTabFromQuery();
        Navigation.LocationChanged += OnLocationChanged;
        SupportApi.TenantChanged += OnTenantChanged;

        try
        {
            await SupportApi.EnsureAgentTokenAsync();
        }
        catch
        {
            // OpsShell also exchanges; page views will surface errors.
        }
    }

    private void OnTenantChanged()
    {
        workspaceEpoch++;
        _ = InvokeAsync(StateHasChanged);
    }

    private Task SelectTenantAsync(SupportTenantDto tenant)
    {
        SupportApi.SetTenant(tenant.TenantId, tenant.PublicKey, tenant.DisplayName, tenant.PublicHelpCenterUrl);
        workspaceEpoch++;
        return Task.CompletedTask;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(() =>
        {
            ApplyTabFromQuery();
            StateHasChanged();
        });

    private void ApplyTabFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrEmpty(query))
        {
            activeTab = "overview";
            return;
        }

        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length != 2) continue;
            if (!string.Equals(Uri.UnescapeDataString(pair[0]), "tab", StringComparison.OrdinalIgnoreCase))
                continue;

            var tab = Uri.UnescapeDataString(pair[1]);
            if (tab is "overview" or "chat" or "live" or "tickets" or "incidents" or "kb" or "internal" or "settings")
                activeTab = tab == "live" ? "chat" : tab;
            return;
        }
    }

    private Task SetTab(string tab)
    {
        activeTab = tab;
        var url = tab == "overview" ? "/admin/support" : $"/admin/support?tab={tab}";
        Navigation.NavigateTo(url, replace: true);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        SupportApi.TenantChanged -= OnTenantChanged;
    }
}
