@page "/admin"
@layout Components.Layout.AdminLayout
@using SominnercoreNew.Services
@using SominnercoreNew.Models
@inject SupabaseAuthService AuthService
@inject SoftwareProductService ProductService
@inject NavigationManager Navigation

<PageTitle>Admin Dashboard - Sominnercore</PageTitle>

@if (isCheckingAuth)
{
    <div class="loading-container">
        <p>Loading...</p>
    </div>
}
else if (!isAuthenticated)
{
    <div class="loading-container">
        <p>Redirecting to login...</p>
    </div>
}
else
{
<div class="admin-dashboard">
    <!-- Sidebar -->
    <aside class="sidebar @(isSidebarOpen ? "open" : "")">
        <div class="sidebar-header">
            <div class="brand">
                <div class="brand-dot"></div>
                <span>Sominnercore</span>
            </div>
            <p class="brand-subtitle">Admin Dashboard</p>
        </div>

        <nav class="sidebar-nav">
            <a href="#" class="nav-item @(activeTab == "overview" ? "active" : "")" @onclick="@(() => SetActiveTab("overview"))" @onclick:preventDefault>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="7" height="9" x="3" y="3" rx="1"/>
                    <rect width="7" height="5" x="14" y="3" rx="1"/>
                    <rect width="7" height="9" x="14" y="12" rx="1"/>
                    <rect width="7" height="5" x="3" y="16" rx="1"/>
                </svg>
                <span>Overview</span>
            </a>
            <a href="#" class="nav-item @(activeTab == "products" ? "active" : "")" @onclick="@(() => SetActiveTab("products"))" @onclick:preventDefault>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                </svg>
                <span>Software Products</span>
            </a>
            <a href="#" class="nav-item @(activeTab == "chat" ? "active" : "")" @onclick="@(() => SetActiveTab("chat"))" @onclick:preventDefault>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <span>Customer Chat</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="user-info">
                <div class="user-avatar">
                    <span>@GetUserInitials()</span>
                </div>
                <div class="user-details">
                    <p class="user-name">@GetUserDisplayName()</p>
                    <p class="user-email">@currentUserEmail</p>
                </div>
            </div>
            <a href="#" class="settings-link" @onclick:preventDefault>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
                    <circle cx="12" cy="12" r="3"/>
                </svg>
                <span>Settings</span>
            </a>
            <button class="logout-button" @onclick="HandleLogout">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" x2="9" y1="12" y2="12"/>
                </svg>
                <span>Logout</span>
            </button>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <header class="dashboard-header">
            <button class="menu-toggle" @onclick="ToggleSidebar">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" x2="20" y1="12" y2="12"/>
                    <line x1="4" x2="20" y1="6" y2="6"/>
                    <line x1="4" x2="20" y1="18" y2="18"/>
                </svg>
            </button>
            <div class="header-content">
                <div>
                    <h1>@GetTabTitle()</h1>
                    <p class="header-subtitle">@GetTabSubtitle()</p>
                </div>
                <button class="admin-access-btn" @onclick="NavigateHome">Admin Access</button>
            </div>
        </header>

        <div class="dashboard-content">
            @if (activeTab == "overview")
            {
                <!-- Stats Cards -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-header">
                            <p class="stat-label">Total Active Users</p>
                            <div class="stat-icon users">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                    <circle cx="9" cy="7" r="4"/>
                                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                </svg>
                            </div>
                        </div>
                        <p class="stat-value">290,000</p>
                        <p class="stat-change positive">↑ 8.5% from last month</p>
                    </div>

                    <div class="stat-card">
                        <div class="stat-header">
                            <p class="stat-label">Total Downloads</p>
                            <div class="stat-icon downloads">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                    <polyline points="7 10 12 15 17 10"/>
                                    <line x1="12" x2="12" y1="15" y2="3"/>
                                </svg>
                            </div>
                        </div>
                        <p class="stat-value">290,000+</p>
                        <p class="stat-change positive">↑ 12% from last month</p>
                    </div>

                    <div class="stat-card">
                        <div class="stat-header">
                            <p class="stat-label">Active Products</p>
                            <div class="stat-icon products">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                                </svg>
                            </div>
                        </div>
                        <p class="stat-value">6</p>
                        <p class="stat-change neutral">6 software solutions</p>
                    </div>

                    <div class="stat-card">
                        <div class="stat-header">
                            <p class="stat-label">Average Growth</p>
                            <div class="stat-icon growth">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
                                    <polyline points="16 7 22 7 22 13"/>
                                </svg>
                            </div>
                        </div>
                        <p class="stat-value">+16.3%</p>
                        <p class="stat-change positive">↑ Across all products</p>
                    </div>
                </div>

                <!-- Charts Row -->
                <div class="charts-row">
                    <!-- Bar Chart -->
                    <div class="chart-card">
                        <div class="chart-header">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                            <span>Active Users by Product</span>
                        </div>
                        <div class="bar-chart-wrapper">
                            <div class="bar-y-axis">
                                <span>120000</span>
                                <span>90000</span>
                                <span>60000</span>
                                <span>30000</span>
                                <span>0</span>
                            </div>
                            <div class="bar-chart-main">
                                <div class="bar-chart-area">
                                    <!-- Grid lines -->
                                    <div class="bar-grid-line" style="bottom: 100%"></div>
                                    <div class="bar-grid-line" style="bottom: 75%"></div>
                                    <div class="bar-grid-line" style="bottom: 50%"></div>
                                    <div class="bar-grid-line" style="bottom: 25%"></div>
                                    <div class="bar-grid-line" style="bottom: 0%"></div>
                                    @foreach (var product in usersChartData)
                                    {
                                        <div class="bar-item">
                                            <div class="bar" style="height: @(product.Height)%"></div>
                                        </div>
                                    }
                                </div>
                                <div class="bar-x-axis">
                                    @foreach (var product in usersChartData)
                                    {
                                        <span>@product.Name</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Pie Chart -->
                    <div class="chart-card">
                        <div class="chart-header">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                            </svg>
                            <span>Product Categories</span>
                        </div>
                        <div class="pie-chart-container">
                            <div class="pie-chart">
                                <svg viewBox="0 0 100 100">
                                    <!-- Data & Analytics - Blue -->
                                    <circle cx="50" cy="50" r="40" fill="transparent" stroke="#3b82f6" stroke-width="20" stroke-dasharray="41.89 209.44" stroke-dashoffset="0" transform="rotate(-90 50 50)"/>
                                    <!-- Communication - Purple -->
                                    <circle cx="50" cy="50" r="40" fill="transparent" stroke="#8b5cf6" stroke-width="20" stroke-dasharray="41.89 209.44" stroke-dashoffset="-41.89" transform="rotate(-90 50 50)"/>
                                    <!-- Project - Green -->
                                    <circle cx="50" cy="50" r="40" fill="transparent" stroke="#10b981" stroke-width="20" stroke-dasharray="41.89 209.44" stroke-dashoffset="-83.78" transform="rotate(-90 50 50)"/>
                                    <!-- Document - Orange -->
                                    <circle cx="50" cy="50" r="40" fill="transparent" stroke="#f97316" stroke-width="20" stroke-dasharray="41.89 209.44" stroke-dashoffset="-125.67" transform="rotate(-90 50 50)"/>
                                    <!-- Collaboration - Indigo -->
                                    <circle cx="50" cy="50" r="40" fill="transparent" stroke="#6366f1" stroke-width="20" stroke-dasharray="41.89 209.44" stroke-dashoffset="-167.56" transform="rotate(-90 50 50)"/>
                                    <!-- Cloud - Cyan -->
                                    <circle cx="50" cy="50" r="40" fill="transparent" stroke="#0ea5e9" stroke-width="20" stroke-dasharray="41.89 209.44" stroke-dashoffset="-209.44" transform="rotate(-90 50 50)"/>
                                </svg>
                            </div>
                            <div class="pie-legend">
                                <div class="legend-item"><span class="legend-color" style="background: #10b981"></span>Communication</div>
                                <div class="legend-item"><span class="legend-color" style="background: #3b82f6"></span>Data</div>
                                <div class="legend-item"><span class="legend-color" style="background: #8b5cf6"></span>Project</div>
                                <div class="legend-item"><span class="legend-color" style="background: #0ea5e9"></span>Cloud</div>
                                <div class="legend-item"><span class="legend-color" style="background: #f97316"></span>Document</div>
                                <div class="legend-item"><span class="legend-color" style="background: #6366f1"></span>Collaboration</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Line Chart -->
                <div class="chart-card full-width">
                    <div class="chart-header">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
                            <polyline points="16 7 22 7 22 13"/>
                        </svg>
                        <span>Total Users Growth (Last 6 Months)</span>
                    </div>
                    <div class="line-chart-wrapper">
                        <div class="line-chart-y-axis">
                            <span>300000</span>
                            <span>225000</span>
                            <span>150000</span>
                            <span>75000</span>
                            <span>0</span>
                        </div>
                        <div class="line-chart-main">
                            <div class="line-chart-area" @onmouseleave="() => hoveredPointIndex = -1">
                                <svg viewBox="0 0 500 200" preserveAspectRatio="none">
                                    <!-- Grid lines -->
                                    <line x1="0" y1="40" x2="500" y2="40" stroke="#2a3441" stroke-dasharray="3 3"/>
                                    <line x1="0" y1="80" x2="500" y2="80" stroke="#2a3441" stroke-dasharray="3 3"/>
                                    <line x1="0" y1="120" x2="500" y2="120" stroke="#2a3441" stroke-dasharray="3 3"/>
                                    <line x1="0" y1="160" x2="500" y2="160" stroke="#2a3441" stroke-dasharray="3 3"/>
                                    <!-- Area fill -->
                                    <path d="M0,50 L100,43 L200,37 L300,27 L400,17 L500,7 L500,200 L0,200 Z" fill="rgba(19,127,236,0.08)"/>
                                    <!-- Line -->
                                    <polyline points="0,50 100,43 200,37 300,27 400,17 500,7" fill="none" stroke="#137fec" stroke-width="3"/>
                                    <!-- Data points and hover areas -->
                                    @for (int i = 0; i < lineChartPoints.Count; i++)
                                    {
                                        var point = lineChartPoints[i];
                                        var idx = i;
                                        @if (hoveredPointIndex == idx)
                                        {
                                            <!-- Vertical dashed line -->
                                            <line x1="@point.X" y1="0" x2="@point.X" y2="200" stroke="#5a6d7f" stroke-width="1" stroke-dasharray="4 3"/>
                                            <!-- Outer ring -->
                                            <circle cx="@point.X" cy="@point.Y" r="8" fill="#101922" stroke="#137fec" stroke-width="2"/>
                                        }
                                        <circle cx="@point.X" cy="@point.Y" r="5" fill="#137fec"/>
                                        <!-- Invisible larger hit area -->
                                        <circle cx="@point.X" cy="@point.Y" r="20" fill="transparent" @onmouseenter="() => hoveredPointIndex = idx" style="cursor: pointer"/>
                                    }
                                </svg>
                                @if (hoveredPointIndex >= 0 && hoveredPointIndex < lineChartPoints.Count)
                                {
                                    var hp = lineChartPoints[hoveredPointIndex];
                                    <div class="chart-tooltip" style="left: @(hp.X / 5.0)%; top: @(hp.Y / 2.0 + 15)%;">
                                        <span class="tooltip-label">@hp.Month</span>
                                        <span class="tooltip-value">users : @hp.Users.ToString("N0")</span>
                                    </div>
                                }
                            </div>
                            <div class="line-chart-x-axis">
                                <span>Aug</span>
                                <span>Sep</span>
                                <span>Oct</span>
                                <span>Nov</span>
                                <span>Dec</span>
                                <span>Jan</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (activeTab == "products")
            {
                <!-- Search and Add Button -->
                <div class="products-toolbar">
                    <div class="search-bar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.3-4.3"/>
                        </svg>
                        <input type="text" placeholder="Search software..." @bind="searchQuery" @bind:event="oninput" />
                    </div>
                    <button class="add-product-btn" @onclick="OpenAddModal">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" x2="12" y1="5" y2="19"/>
                            <line x1="5" x2="19" y1="12" y2="12"/>
                        </svg>
                        <span>Add Product</span>
                    </button>
                </div>

                <!-- Products Grid -->
                @if (isLoadingProducts)
                {
                    <div class="loading-products">
                        <p>Loading products...</p>
                    </div>
                }
                else if (!softwareProducts.Any())
                {
                    <div class="empty-products">
                        <p>No products yet. Click "Add Product" to create one.</p>
                    </div>
                }
                else
                {
                    <div class="products-grid">
                        @foreach (var product in FilteredSoftwareProducts)
                        {
                            <div class="product-card">
                                <div class="product-header">
                                    <div class="product-icon" style="background: @product.IconColor">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                                        </svg>
                                    </div>
                                    <div class="product-title">
                                        <h3>@product.Name</h3>
                                        <p>@product.Category</p>
                                    </div>
                                    <span class="product-status @product.Status">@product.Status</span>
                                </div>
                                <div class="product-stats">
                                    <div class="product-stat">
                                        <span class="stat-label">Version</span>
                                        <span class="stat-value">@product.Version</span>
                                    </div>
                                    <div class="product-stat">
                                        <span class="stat-label">Release Date</span>
                                        <span class="stat-value">@FormatReleaseDate(product.ReleaseDate)</span>
                                    </div>
                                </div>
                                <div class="product-stats">
                                    <div class="product-stat">
                                        <span class="stat-label">Active Users</span>
                                        <span class="stat-value">@product.ActiveUsers.ToString("N0")</span>
                                    </div>
                                    <div class="product-stat">
                                        <span class="stat-label">Total Downloads</span>
                                        <span class="stat-value">@product.TotalDownloads.ToString("N0")</span>
                                    </div>
                                </div>
                                <div class="product-footer">
                                    <span class="last-update">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                                            <line x1="16" x2="16" y1="2" y2="6"/>
                                            <line x1="8" x2="8" y1="2" y2="6"/>
                                            <line x1="3" x2="21" y1="10" y2="10"/>
                                        </svg>
                                        @FormatTimeAgo(product.UpdatedAt)
                                    </span>
                                    <div class="product-actions">
                                        <button class="action-btn edit" @onclick="() => OpenEditModal(product)" title="Edit">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                                <path d="m15 5 4 4"/>
                                            </svg>
                                        </button>
                                        <button class="action-btn delete" @onclick="() => ConfirmDelete(product)" title="Delete">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 6h18"/>
                                                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(productError))
                {
                    <div class="product-error">@productError</div>
                }

                <!-- Add/Edit Product Modal -->
                @if (showProductModal)
                {
                    <div class="modal-overlay" @onclick="CloseProductModal">
                        <div class="modal-card" @onclick:stopPropagation>
                            <div class="modal-header">
                                <h2>@(isEditingProduct ? "Edit Product" : "Add Product")</h2>
                                <button class="modal-close" @onclick="CloseProductModal">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" x2="6" y1="6" y2="18"/>
                                        <line x1="6" x2="18" y1="6" y2="18"/>
                                    </svg>
                                </button>
                            </div>
                            <div class="modal-body">
                                <div class="form-row">
                                    <div class="form-field">
                                        <label>Name *</label>
                                        <input type="text" @bind="formName" placeholder="Product name" />
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-field">
                                        <label>Short Description</label>
                                        <input type="text" @bind="formShortDesc" placeholder="Brief description" />
                                    </div>
                                </div>
                                <div class="form-row two-col">
                                    <div class="form-field">
                                        <label>Category</label>
                                        <input type="text" @bind="formCategory" placeholder="e.g. Data & Analytics" />
                                    </div>
                                    <div class="form-field">
                                        <label>Version</label>
                                        <input type="text" @bind="formVersion" placeholder="e.g. v1.0.0" />
                                    </div>
                                </div>
                                <div class="form-row two-col">
                                    <div class="form-field">
                                        <label>Status</label>
                                        <select @bind="formStatus">
                                            <option value="active">Active</option>
                                            <option value="upcoming">Upcoming</option>
                                            <option value="deprecated">Deprecated</option>
                                        </select>
                                    </div>
                                    <div class="form-field">
                                        <label>Visibility</label>
                                        <select @bind="formVisibility">
                                            <option value="public">Public</option>
                                            <option value="hidden">Hidden</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-row two-col">
                                    <div class="form-field">
                                        <label>Release Date</label>
                                        <input type="text" @bind="formReleaseDate" placeholder="e.g. 2026-01-15" />
                                    </div>
                                    <div class="form-field">
                                        <label>Icon Color</label>
                                        <div class="color-picker">
                                            @foreach (var color in colorOptions)
                                            {
                                                <button type="button"
                                                        class="color-option @(formIconColor == color ? "selected" : "")"
                                                        style="background: @color"
                                                        @onclick="() => formIconColor = color">
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row two-col">
                                    <div class="form-field">
                                        <label>Active Users</label>
                                        <input type="number" @bind="formActiveUsers" placeholder="0" />
                                    </div>
                                    <div class="form-field">
                                        <label>Total Downloads</label>
                                        <input type="number" @bind="formTotalDownloads" placeholder="0" />
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-field">
                                        <label>Full Description</label>
                                        <textarea @bind="formFullDesc" placeholder="Detailed product description..." rows="3"></textarea>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button class="modal-btn cancel" @onclick="CloseProductModal">Cancel</button>
                                <button class="modal-btn save" @onclick="SaveProduct" disabled="@isSavingProduct">
                                    @if (isSavingProduct)
                                    {
                                        <span>Saving...</span>
                                    }
                                    else
                                    {
                                        <span>@(isEditingProduct ? "Update" : "Add Product")</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <!-- Delete Confirmation Modal -->
                @if (showDeleteConfirm)
                {
                    <div class="modal-overlay" @onclick="() => showDeleteConfirm = false">
                        <div class="confirm-dialog" @onclick:stopPropagation>
                            <div class="confirm-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 6h18"/>
                                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                </svg>
                            </div>
                            <h3>Delete Product</h3>
                            <p>Are you sure you want to delete <strong>@deletingProduct?.Name</strong>? This action cannot be undone.</p>
                            <div class="confirm-actions">
                                <button class="modal-btn cancel" @onclick="() => showDeleteConfirm = false">Cancel</button>
                                <button class="modal-btn delete" @onclick="DeleteProduct" disabled="@isDeletingProduct">
                                    @(isDeletingProduct ? "Deleting..." : "Delete")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (activeTab == "chat")
            {
                <!-- Chat Header -->
                <div class="chat-section-header">
                    <h2 class="chat-title">Customer Support Chat</h2>
                    <p class="chat-subtitle">Respond to customer inquiries in real-time</p>
                    <span class="unread-badge">@conversations.Sum(c => c.UnreadCount) Unread</span>
                </div>

                <div class="chat-container">
                    <!-- Conversations List -->
                    <div class="conversations-panel">
                        <h3>Conversations</h3>
                        <div class="search-bar small">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"/>
                                <path d="m21 21-4.3-4.3"/>
                            </svg>
                            <input type="text" placeholder="Search conversations..." />
                        </div>
                        <div class="conversations-list">
                            @foreach (var conv in conversations)
                            {
                                <div class="conversation-item @(selectedConversation?.Id == conv.Id ? "active" : "")" @onclick="@(() => SelectConversation(conv))">
                                    <div class="conv-avatar" style="background: @conv.AvatarColor">@conv.Initials</div>
                                    <div class="conv-info">
                                        <div class="conv-header">
                                            <span class="conv-name">@conv.Name</span>
                                            <span class="conv-time">@conv.LastMessageTime</span>
                                        </div>
                                        <p class="conv-email">@conv.Email</p>
                                        <p class="conv-preview">@conv.LastMessage</p>
                                        <span class="conv-status @conv.Status">@conv.Status</span>
                                    </div>
                                    @if (conv.UnreadCount > 0)
                                    {
                                        <span class="unread-count">@conv.UnreadCount</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Chat Panel -->
                    <div class="chat-panel">
                        @if (selectedConversation != null)
                        {
                            <div class="chat-header">
                                <div class="chat-user">
                                    <div class="chat-avatar" style="background: @selectedConversation.AvatarColor">@selectedConversation.Initials</div>
                                    <div class="chat-user-info">
                                        <span class="chat-user-name">@selectedConversation.Name</span>
                                        <span class="chat-user-email">@selectedConversation.Email</span>
                                    </div>
                                </div>
                                <div class="chat-actions">
                                    <button class="chat-action-btn">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                                        </svg>
                                    </button>
                                    <button class="chat-action-btn">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/>
                                            <rect x="2" y="6" width="14" height="12" rx="2"/>
                                        </svg>
                                    </button>
                                    <button class="chat-action-btn">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="1"/>
                                            <circle cx="19" cy="12" r="1"/>
                                            <circle cx="5" cy="12" r="1"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                            <div class="chat-messages">
                                <div class="message-date">@selectedConversation.LastMessageTime</div>
                                @foreach (var msg in GetMessagesForConversation(selectedConversation.Id))
                                {
                                    <div class="message @(msg.IsFromCustomer ? "customer" : "agent")">
                                        @if (msg.IsFromCustomer)
                                        {
                                            <span class="message-sender">@selectedConversation.Name</span>
                                        }
                                        <div class="message-bubble">@msg.Text</div>
                                        <span class="message-time">@msg.Time</span>
                                    </div>
                                }
                            </div>
                            <div class="chat-input">
                                <button class="input-action">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                                    </svg>
                                </button>
                                <button class="input-action">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"/>
                                        <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                                        <line x1="9" x2="9.01" y1="9" y2="9"/>
                                        <line x1="15" x2="15.01" y1="9" y2="9"/>
                                    </svg>
                                </button>
                                <input type="text" placeholder="Type your message..." @bind="newMessage" />
                                <button class="send-btn" @onclick="SendMessage">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="m22 2-7 20-4-9-9-4Z"/>
                                        <path d="M22 2 11 13"/>
                                    </svg>
                                </button>
                            </div>
                            <div class="responding-as">
                                Responding as <strong>Admin User</strong> (Admin)
                            </div>
                        }
                        else
                        {
                            <div class="no-conversation">
                                <p>Select a conversation to start chatting</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </main>
</div>
}

@code {
    private bool isSidebarOpen = false;
    private string activeTab = "overview";
    private string searchQuery = "";
    private string newMessage = "";
    private Conversation? selectedConversation;
    private bool isCheckingAuth = true;
    private bool isAuthenticated = false;
    private string currentUserEmail = "";
    private int hoveredPointIndex = -1;

    // Line Chart Data Points
