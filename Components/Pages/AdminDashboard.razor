    // Excel export
    private async Task ExportBackup()
    {
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("<?xml version=\"1.0\" encoding=\"UTF-8\"?>");
            sb.AppendLine("<?mso-application progid=\"Excel.Sheet\"?>");
            sb.AppendLine("<Workbook xmlns=\"urn:schemas-microsoft-com:office:spreadsheet\"");
            sb.AppendLine(" xmlns:ss=\"urn:schemas-microsoft-com:office:spreadsheet\">");
            sb.AppendLine("<Styles>");
            sb.AppendLine("<Style ss:ID=\"header\"><Font ss:Bold=\"1\" ss:Size=\"11\"/><Interior ss:Color=\"#D9E2F3\" ss:Pattern=\"Solid\"/></Style>");
            sb.AppendLine("</Styles>");
            sb.AppendLine("<Worksheet ss:Name=\"Products\">");
            sb.AppendLine("<Table>");

            // Header row
            sb.AppendLine("<Row>");
            foreach (var h in new[] { "Name", "Category", "Version", "Status", "Visibility", "Active Users", "Total Downloads", "Release Date", "Short Description", "Full Description", "Created At", "Updated At" })
            {
                sb.AppendLine($"<Cell ss:StyleID=\"header\"><Data ss:Type=\"String\">{EscapeXml(h)}</Data></Cell>");
            }
            sb.AppendLine("</Row>");

            // Data rows
            foreach (var p in softwareProducts)
            {
                sb.AppendLine("<Row>");
                sb.AppendLine($"<Cell><Data ss:Type=\"String\">{EscapeXml(p.Name)}</Data></Cell>");
                sb.AppendLine($"<Cell><Data ss:Type=\"String\">{EscapeXml(p.Category ?? "")}</Data></Cell>");
                sb.AppendLine($"<Cell><Data ss:Type=\"String\">{EscapeXml(p.Version)}</Data></Cell>");
                sb.AppendLine($"<Cell><Data ss:Type=\"String\">{EscapeXml(p.Status)}</Data></Cell>");
                sb.AppendLine($"<Cell><Data ss:Type=\"String\">{EscapeXml(p.Visibility)}</Data></Cell>");
                sb.AppendLine($"<Cell><Data ss:Type=\"Number\">{p.ActiveUsers}</Data></Cell>");
                sb.AppendLine($"<Cell><Data ss:Type=\"Number\">{p.TotalDownloads}</Data></Cell>");
                sb.AppendLine($"<Cell><Data ss:Type=\"String\">{EscapeXml(p.ReleaseDate ?? "")}</Data></Cell>");
                sb.AppendLine($"<Cell><Data ss:Type=\"String\">{EscapeXml(p.ShortDescription ?? "")}</Data></Cell>");
                sb.AppendLine($"<Cell><Data ss:Type=\"String\">{EscapeXml(p.FullDescription ?? "")}</Data></Cell>");
                sb.AppendLine($"<Cell><Data ss:Type=\"String\">{EscapeXml(p.CreatedAt ?? "")}</Data></Cell>");
                sb.AppendLine($"<Cell><Data ss:Type=\"String\">{EscapeXml(p.UpdatedAt ?? "")}</Data></Cell>");
                sb.AppendLine("</Row>");
            }

            sb.AppendLine("</Table>");
            sb.AppendLine("</Worksheet>");
            sb.AppendLine("</Workbook>");

            var fileName = $"sominnercore-products-{DateTime.UtcNow:yyyy-MM-dd}.xls";
            var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(sb.ToString()));
            await JS.InvokeVoidAsync("downloadBase64File", base64, fileName, "application/vnd.ms-excel");
            ShowToast($"Excel exported: {fileName}");
        }
        catch (Exception ex)
        {
            ShowToast($"Export failed: {ex.Message}", "error");
        }
    }

    private static string EscapeXml(string text)
    {
        return text.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;").Replace("\"", "&quot;").Replace("'", "&apos;");
    }

