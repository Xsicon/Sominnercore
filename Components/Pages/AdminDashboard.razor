        new ChartData { Name = "CloudVault", Users = 103500, Height = 86 }
    };

    // Software Products (from Supabase)
    private List<Software> softwareProducts = new();
    private bool isLoadingProducts = true;
    private string? productError;

    // Product Modal State
    private bool showProductModal = false;
    private bool isEditingProduct = false;
    private bool isSavingProduct = false;
    private string? editingProductId;

    // Delete Confirmation State
    private bool showDeleteConfirm = false;
    private bool isDeletingProduct = false;
    private Software? deletingProduct;

    // Form Fields
    private string formName = "";
    private string formShortDesc = "";
    private string formFullDesc = "";
    private string formVersion = "";
    private string formCategory = "";
    private string formStatus = "active";
    private string formVisibility = "public";
    private string formReleaseDate = "";
    private string formIconColor = "#3b82f6";
    private int formActiveUsers = 0;
    private int formTotalDownloads = 0;

    // Color Options
    private string[] colorOptions = new[] { "#3b82f6", "#8b5cf6", "#10b981", "#f97316", "#6366f1", "#0ea5e9", "#ef4444", "#ec4899" };

    // Conversations Data
    private List<Conversation> conversations = new()
    {
        new Conversation { Id = 1, Name = "Alex Thompson", Email = "alex.t@company.com", Initials = "AT", AvatarColor = "#3b82f6", LastMessage = "Thanks for the quick response!", LastMessageTime = "Nov 7", Status = "Active", UnreadCount = 2 },
        new Conversation { Id = 2, Name = "Maria Garcia", Email = "maria.g@startup.io", Initials = "MG", AvatarColor = "#8b5cf6", LastMessage = "When can we schedule a call?", LastMessageTime = "Nov 7", Status = "Waiting", UnreadCount = 1 },
        new Conversation { Id = 3, Name = "Robert Kim", Email = "robert.k@enterprise.com", Initials = "RK", AvatarColor = "#10b981", LastMessage = "Perfect, thank you for your help!", LastMessageTime = "Nov 6", Status = "Resolved", UnreadCount = 0 },
        new Conversation { Id = 4, Name = "Jennifer Lee", Email = "jennifer.l@design.co", Initials = "JL", AvatarColor = "#f97316", LastMessage = "Can you share your portfolio?", LastMessageTime = "Nov 7", Status = "Waiting", UnreadCount = 3 }
    };

    // Messages Data
    private Dictionary<int, List<ChatMessage>> messagesData = new()
    {
        { 1, new List<ChatMessage>
            {
                new ChatMessage { Text = "Hi, I'm interested in your web development services. Can you help me build an e-commerce platform?", IsFromCustomer = true, Time = "09:15 PM" },
                new ChatMessage { Text = "Hello Alex! Absolutely, we'd be happy to help. We have extensive experience building scalable e-commerce platforms. Could you tell me more about your requirements?", IsFromCustomer = false, Time = "09:18 PM" },
                new ChatMessage { Text = "I need a platform that can handle around 5,000 products with payment integration, inventory management, and customer reviews.", IsFromCustomer = true, Time = "09:25 PM" },
                new ChatMessage { Text = "Thanks for the quick response!", IsFromCustomer = true, Time = "09:30 PM" }
            }
        },
        { 2, new List<ChatMessage>
            {
                new ChatMessage { Text = "Hello, I'm looking for mobile app development services.", IsFromCustomer = true, Time = "10:00 AM" },
                new ChatMessage { Text = "Hi Maria! We'd love to help. What kind of app are you looking to build?", IsFromCustomer = false, Time = "10:05 AM" },
                new ChatMessage { Text = "When can we schedule a call?", IsFromCustomer = true, Time = "10:15 AM" }
            }
        },
        { 3, new List<ChatMessage>
            {
                new ChatMessage { Text = "We need cloud migration services for our enterprise.", IsFromCustomer = true, Time = "02:00 PM" },
                new ChatMessage { Text = "Perfect, thank you for your help!", IsFromCustomer = true, Time = "04:30 PM" }
            }
        },
        { 4, new List<ChatMessage>
            {
                new ChatMessage { Text = "I'm interested in UI/UX design services.", IsFromCustomer = true, Time = "11:00 AM" },
                new ChatMessage { Text = "Can you share your portfolio?", IsFromCustomer = true, Time = "11:30 AM" }
            }
        }
    };

    private IEnumerable<Software> FilteredSoftwareProducts =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? softwareProducts
            : softwareProducts.Where(p => p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                          (p.Category ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        selectedConversation = conversations.FirstOrDefault();

        // Check if user is authenticated
        var user = AuthService.GetCurrentUser();
        var session = AuthService.GetCurrentSession();

        if (user == null || session == null)
        {
            isAuthenticated = false;
            isCheckingAuth = false;
            Navigation.NavigateTo("/admin/login");
            return;
        }

        currentUserEmail = user.Email ?? "";
        isAuthenticated = true;
        isCheckingAuth = false;

        // Load products from Supabase
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        try
        {
            isLoadingProducts = true;
            productError = null;
            softwareProducts = await ProductService.GetAllAsync();
        }
        catch (Exception ex)
        {
            productError = "Failed to load products. Please try again.";
            Console.WriteLine($"Error loading products: {ex.Message}");
        }
        finally
        {
            isLoadingProducts = false;
            StateHasChanged();
        }
    }

    private string GetUserInitials()
    {
        if (string.IsNullOrEmpty(currentUserEmail)) return "?";

        var name = currentUserEmail.Split('@')[0];
        if (name.Length >= 2)
        {
            return (name[0].ToString() + name[1].ToString()).ToUpper();
        }
        return name.ToUpper();
    }

    private string GetUserDisplayName()
    {
        if (string.IsNullOrEmpty(currentUserEmail)) return "User";

        var name = currentUserEmail.Split('@')[0];
        // Capitalize first letter
        if (name.Length > 0)
        {
            return char.ToUpper(name[0]) + name.Substring(1);
        }
        return name;
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        isSidebarOpen = false;
    }

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private async Task HandleLogout()
    {
        await AuthService.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    private void NavigateHome()
    {
        Navigation.NavigateTo("/");
    }

    private string GetTabTitle() => activeTab switch
    {
        "overview" => "Overview",
        "products" => "Software Products",
        "chat" => "Customer Chat",
        _ => "Dashboard"
    };

    private string GetTabSubtitle() => activeTab switch
    {
        "overview" => "Dashboard analytics and insights",
        "products" => "Manage your software products",
        "chat" => "Customer support and communications",
        _ => ""
    };

    // Product CRUD Methods
    private void OpenAddModal()
    {
        isEditingProduct = false;
        editingProductId = null;
        ResetForm();
        showProductModal = true;
    }

    private void OpenEditModal(Software product)
    {
        isEditingProduct = true;
        editingProductId = product.Id;
        formName = product.Name;
        formShortDesc = product.ShortDescription ?? "";
        formFullDesc = product.FullDescription ?? "";
        formVersion = product.Version;
        formCategory = product.Category ?? "";
        formStatus = product.Status;
        formVisibility = product.Visibility;
        formReleaseDate = product.ReleaseDate ?? "";
        formIconColor = product.IconColor;
        formActiveUsers = product.ActiveUsers;
        formTotalDownloads = product.TotalDownloads;
        showProductModal = true;
    }

    private void CloseProductModal()
    {
        showProductModal = false;
        ResetForm();
    }

    private void ResetForm()
    {
        formName = "";
        formShortDesc = "";
        formFullDesc = "";
        formVersion = "";
        formCategory = "";
        formStatus = "active";
        formVisibility = "public";
        formReleaseDate = "";
        formIconColor = "#3b82f6";
        formActiveUsers = 0;
        formTotalDownloads = 0;
    }

    private async Task SaveProduct()
    {
        if (string.IsNullOrWhiteSpace(formName))
        {
            productError = "Product name is required.";
            return;
        }

        isSavingProduct = true;
        productError = null;
        StateHasChanged();

        try
        {
            if (isEditingProduct && editingProductId != null)
            {
                var software = new Software
                {
                    Id = editingProductId,
                    Name = formName,
                    ShortDescription = formShortDesc,
                    FullDescription = formFullDesc,
                    Version = formVersion,
                    Category = formCategory,
                    Status = formStatus,
                    Visibility = formVisibility,
                    ReleaseDate = formReleaseDate,
                    IconColor = formIconColor,
                    ActiveUsers = formActiveUsers,
                    TotalDownloads = formTotalDownloads
                };
                await ProductService.UpdateAsync(software);
            }
            else
            {
                var software = new Software
                {
                    Name = formName,
                    ShortDescription = formShortDesc,
                    FullDescription = formFullDesc,
                    Version = formVersion,
                    Category = formCategory,
                    Status = formStatus,
                    Visibility = formVisibility,
                    ReleaseDate = formReleaseDate,
                    IconColor = formIconColor,
                    ActiveUsers = formActiveUsers,
                    TotalDownloads = formTotalDownloads
                };
                await ProductService.CreateAsync(software);
            }

            showProductModal = false;
            ResetForm();
            await LoadProducts();
        }
        catch (Exception ex)
        {
            productError = $"Failed to save product: {ex.Message}";
        }
        finally
        {
            isSavingProduct = false;
            StateHasChanged();
        }
    }

    private void ConfirmDelete(Software product)
    {
        deletingProduct = product;
        showDeleteConfirm = true;
    }

    private async Task DeleteProduct()
    {
        if (deletingProduct == null) return;

        isDeletingProduct = true;
        productError = null;
        StateHasChanged();

        try
        {
            await ProductService.DeleteAsync(deletingProduct.Id);
            showDeleteConfirm = false;
            deletingProduct = null;
            await LoadProducts();
        }
        catch (Exception ex)
        {
            productError = $"Failed to delete product: {ex.Message}";
        }
        finally
        {
            isDeletingProduct = false;
            StateHasChanged();
        }
    }

    // Helper Methods
    private string FormatReleaseDate(string? dateStr)
    {
        if (string.IsNullOrEmpty(dateStr)) return "N/A";
        if (DateTime.TryParse(dateStr, out var date))
        {
            return date.ToString("MMMM d, yyyy");
        }
        return dateStr;
    }

    private string FormatTimeAgo(string? dateStr)
    {
        if (string.IsNullOrEmpty(dateStr)) return "Unknown";
        if (DateTime.TryParse(dateStr, out var date))
        {
            var diff = DateTime.UtcNow - date;
            if (diff.TotalMinutes < 60) return "Updated just now";
            if (diff.TotalHours < 24) return $"Updated {(int)diff.TotalHours}h ago";
            if (diff.TotalDays < 7) return $"Updated {(int)diff.TotalDays}d ago";
            return $"Updated {date:MMM d, yyyy}";
        }
        return "Unknown";
    }

    private void SelectConversation(Conversation conv)
    {
        selectedConversation = conv;
    }

    private List<ChatMessage> GetMessagesForConversation(int convId)
    {
        return messagesData.ContainsKey(convId) ? messagesData[convId] : new List<ChatMessage>();
    }

    private void SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(newMessage) && selectedConversation != null)
        {
            if (!messagesData.ContainsKey(selectedConversation.Id))
            {
                messagesData[selectedConversation.Id] = new List<ChatMessage>();
            }
            messagesData[selectedConversation.Id].Add(new ChatMessage
            {
                Text = newMessage,
                IsFromCustomer = false,
                Time = DateTime.Now.ToString("hh:mm tt")
            });
            newMessage = "";
        }
    }

    // Data Models
    private class ChartData
    {
        public string Name { get; set; } = "";
        public int Users { get; set; }
        public int Height { get; set; }
    }

    private class Conversation
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Initials { get; set; } = "";
        public string AvatarColor { get; set; } = "";
        public string LastMessage { get; set; } = "";
        public string LastMessageTime { get; set; } = "";
        public string Status { get; set; } = "";
        public int UnreadCount { get; set; }
    }

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsFromCustomer { get; set; }
        public string Time { get; set; } = "";
    }

    private class LineChartPoint
    {
        public string Month { get; set; } = "";
        public int Users { get; set; }
        public int X { get; set; }
        public int Y { get; set; }
    }
}
