@page "/admin"
@layout Components.Layout.AdminLayout
@using KobNeti.Services
@using KobNeti.Services.Support
@using KobNeti.Models
@implements IDisposable
@inject SupabaseAuthService AuthService
@inject SoftwareProductService ProductService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject PageContentService PageContentService
@inject SupportApiClient SupportApi

<PageTitle>Admin Dashboard - KobNeti</PageTitle>

@if (isCheckingAuth)
{
    <div class="kn-hub-loading"><p>Loading...</p></div>
}
else if (!isAuthenticated)
{
    <div class="kn-hub-loading"><p>Redirecting to login...</p></div>
}
else
{
<KnHubShell>
    <Tabs>
        <button type="button" class="kn-hub-subnav__item @(activeTab == "overview" ? "is-active" : "")" @onclick="@(() => SetActiveTab("overview"))">Overview</button>
        <button type="button" class="kn-hub-subnav__item @(activeTab == "products" ? "is-active" : "")" @onclick="@(() => SetActiveTab("products"))">Projects</button>
        <button type="button" class="kn-hub-subnav__item @(activeTab == "pages" ? "is-active" : "")" @onclick="@(() => SetActiveTab("pages"))">Content Pages</button>
        <a href="/admin/support" class="kn-hub-subnav__item">Support Hub</a>
    </Tabs>
    <ChildContent>
            @if (activeTab == "overview")
            {
                <div class="kn-s3-page">
                    <div class="kn-s3-status">
                        <div class="kn-s3-status__left">
                            <span class="kn-s3-status__dot" aria-hidden="true"></span>
                            <div>
                                <strong>All systems operational</strong>
                                <p style="margin:0.25rem 0 0;font-size:0.85rem;color:var(--kn-text-muted);">
                                    @SupportApi.DisplayName desk is connected to KobNetiApi.
                                </p>
                            </div>
                        </div>
                        <div class="kn-s3-status__metrics">
                            <span><strong>@(softwareProducts.Count(p => p.Status == "active"))</strong>Active products</span>
                            <span><strong>@(overview?.ActiveChats ?? 0)</strong>Live chats</span>
                            <span><strong>@(overview?.OpenIncidents ?? 0)</strong>Open incidents</span>
                        </div>
                    </div>

                    <div class="kn-s3-grid-2 kn-s3-grid-60-40">
                        <div class="kn-s3-panel">
                            <h3>Operations snapshot</h3>
                            <div class="kn-s3-list-row"><span>Engineering in progress</span><strong>@(overview?.EngTasksInProgress ?? 0)</strong></div>
                            <div class="kn-s3-list-row"><span>Pending approvals</span><strong>@(overview?.PendingApprovals ?? 0)</strong></div>
                            <div class="kn-s3-list-row"><span>Unread alerts</span><strong>@(overview?.UnreadNotifications ?? 0)</strong></div>
                            <div class="kn-s3-list-row"><span>Open tickets</span><strong>@(overview?.OpenTickets ?? 0)</strong></div>
                        </div>
                        <div class="kn-s3-panel">
                            <h3>Quick actions</h3>
                            <div class="kn-s3-actions">
                                <a class="kn-btn kn-btn--primary kn-btn--sm" href="/admin/support">Support Hub</a>
                                <a class="kn-btn kn-btn--outline kn-btn--sm" href="/admin/engineering">Engineering</a>
                                <a class="kn-btn kn-btn--outline kn-btn--sm" href="/admin/insights">Insights</a>
                                <a class="kn-btn kn-btn--outline kn-btn--sm" href="/admin/platform">Platform</a>
                            </div>
                        </div>
                    </div>

                    <div class="kn-s3-panel">
                        <h3>Product registry</h3>
                        @if (isLoadingProducts)
                        {
                            <p class="kn-s3-empty">Loading products…</p>
                        }
                        else if (softwareProducts.Count == 0)
                        {
                            <p class="kn-s3-empty">No products in catalog yet.</p>
                        }
                        else
                        {
                            <div class="kn-s3-table-wrap">
                                <table class="kn-s3-table">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th>Category</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var product in softwareProducts.Take(8))
                                        {
                                            <tr>
                                                <td class="kn-s3-table__subject">@product.Name</td>
                                                <td>@product.Category</td>
                                                <td>@(string.Equals(product.Status, "active", StringComparison.OrdinalIgnoreCase) ? "Active" : product.Status)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (activeTab == "products")
            {
                <div class="kn-s3-page">
                    <div class="kn-s3-toolbar">
                        <div class="kn-s3-search">
                            <span class="material-symbols-outlined">search</span>
                            <input type="text" placeholder="Search software…" @bind="searchQuery" @bind:event="oninput" />
                        </div>
                        <div class="kn-s3-actions">
                            <button type="button" class="kn-btn kn-btn--outline kn-btn--sm" @onclick="ExportBackup">Export</button>
                            <button type="button" class="kn-btn kn-btn--primary kn-btn--sm" @onclick="OpenAddModal">Add Project</button>
                        </div>
                    </div>

                    @if (isLoadingProducts)
                    {
                        <p class="kn-s3-empty">Loading projects…</p>
                    }
                    else if (!softwareProducts.Any())
                    {
                        <p class="kn-s3-empty">No projects yet. Click Add Project to create one.</p>
                    }
                    else
                    {
                        <div class="kn-s3-table-wrap">
                            <table class="kn-s3-table">
                                <thead>
                                    <tr>
                                        <th>Project</th>
                                        <th>Category</th>
                                        <th>Status</th>
                                        <th>Version</th>
                                        <th>Users</th>
                                        <th>Downloads</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in FilteredSoftwareProducts)
                                    {
                                        <tr>
                                            <td class="kn-s3-table__subject">@product.Name</td>
                                            <td>@product.Category</td>
                                            <td>@product.Status</td>
                                            <td>@product.Version</td>
                                            <td>@product.ActiveUsers.ToString("N0")</td>
                                            <td>@product.TotalDownloads.ToString("N0")</td>
                                            <td>
                                                <div class="kn-s3-actions">
                                                    <button type="button" class="kn-btn kn-btn--outline kn-btn--sm" @onclick="() => OpenEditModal(product)">Edit</button>
                                                    <button type="button" class="kn-btn kn-btn--outline kn-btn--sm" @onclick="() => ConfirmDelete(product)">Delete</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(productError))
                    {
                        <p class="kn-s3-empty" style="color:var(--kn-danger);">@productError</p>
                    }
                </div>

                @* Modals below — same @code handlers *@
                @if (showProductModal)
                {
                    <div class="kn-modal-backdrop" @onclick="CloseProductModal">
                        <div class="kn-modal" @onclick:stopPropagation>
                            <div class="kn-modal__head">
                                <h2>@(isEditingProduct ? "Edit Project" : "Add Project")</h2>
                                <button class="kn-modal__close" @onclick="CloseProductModal">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" x2="6" y1="6" y2="18"/>
                                        <line x1="6" x2="18" y1="6" y2="18"/>
                                    </svg>
                                </button>
                            </div>
                            <div class="kn-modal__body">
                                <div class="kn-form-row">
                                    <div class="kn-field">
                                        <label>Name *</label>
                                        <input type="text" @bind="formName" placeholder="Product name" />
                                    </div>
                                </div>
                                <div class="kn-form-row">
                                    <div class="kn-field">
                                        <label>Short Description</label>
                                        <input type="text" @bind="formShortDesc" placeholder="Brief description" />
                                    </div>
                                </div>
                                <div class="kn-kn-form-row kn-kn-form-row--2">
                                    <div class="kn-field">
                                        <label>Category</label>
                                        <input type="text" @bind="formCategory" placeholder="e.g. Data & Analytics" />
                                    </div>
                                    <div class="kn-field">
                                        <label>Version</label>
                                        <input type="text" @bind="formVersion" placeholder="e.g. v1.0.0" />
                                    </div>
                                </div>
                                <div class="kn-kn-form-row kn-kn-form-row--2">
                                    <div class="kn-field">
                                        <label>Status</label>
                                        <select @bind="formStatus">
                                            <option value="active">Active</option>
                                            <option value="upcoming">Upcoming</option>
                                            <option value="deprecated">Deprecated</option>
                                        </select>
                                    </div>
                                    <div class="kn-field">
                                        <label>Visibility</label>
                                        <select @bind="formVisibility">
                                            <option value="public">Public</option>
                                            <option value="hidden">Hidden</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="kn-kn-form-row kn-kn-form-row--2">
                                    <div class="kn-field">
                                        <label>Release Date</label>
                                        <input type="date" value="@formReleaseDate" @onchange="@(e => formReleaseDate = e.Value?.ToString() ?? "")" />
                                    </div>
                                    <div class="kn-field">
                                        <label>Icon Color</label>
                                        <div class="kn-color-picker">
                                            @foreach (var color in colorOptions)
                                            {
                                                <button type="button"
                                                        class="kn-color-option @(formIconColor == color ? "is-selected" : "")"
                                                        style="background: @color"
                                                        @onclick="() => formIconColor = color">
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="kn-kn-form-row kn-kn-form-row--2">
                                    <div class="kn-field">
                                        <label>Active Users</label>
                                        <input type="number" @bind="formActiveUsers" placeholder="0" />
                                    </div>
                                    <div class="kn-field">
                                        <label>Total Downloads</label>
                                        <input type="number" @bind="formTotalDownloads" placeholder="0" />
                                    </div>
                                </div>
                                <div class="kn-form-row">
                                    <div class="kn-field">
                                        <label>Full Description</label>
                                        <textarea @bind="formFullDesc" placeholder="Detailed product description..." rows="3"></textarea>
                                    </div>
                                </div>
                            </div>
                            <div class="kn-modal__foot">
                                <button class="kn-btn kn-btn--outline" @onclick="CloseProductModal">Cancel</button>
                                <button class="kn-btn kn-btn--primary" @onclick="SaveProduct" disabled="@isSavingProduct">
                                    @if (isSavingProduct)
                                    {
                                        <span>Saving...</span>
                                    }
                                    else
                                    {
                                        <span>@(isEditingProduct ? "Update" : "Add Project")</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <!-- Delete Confirmation Modal -->
                @if (showDeleteConfirm)
                {
                    <div class="kn-modal-backdrop" @onclick="() => showDeleteConfirm = false">
                        <div class="kn-modal kn-modal--sm" @onclick:stopPropagation>
                            <div class="confirm-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 6h18"/>
                                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                </svg>
                            </div>
                            <h3>Delete Product</h3>
                            <p>Are you sure you want to delete <strong>@deletingProduct?.Name</strong>? This action cannot be undone.</p>
                            <div class="kn-modal__foot">
                                <button class="kn-btn kn-btn--outline" @onclick="() => showDeleteConfirm = false">Cancel</button>
                                <button class="kn-btn kn-btn--danger" @onclick="DeleteProduct" disabled="@isDeletingProduct">
                                    @(isDeletingProduct ? "Deleting..." : "Delete")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (activeTab == "pages")
            {
                <div class="kn-s3-page">
                    <div class="kn-s3-toolbar">
                        <div class="kn-s3-search">
                            <span class="material-symbols-outlined">search</span>
                            <input type="text" placeholder="Search pages…" @bind="pageSearchQuery" @bind:event="oninput" />
                        </div>
                        <div class="kn-s3-actions">
                            <button type="button" class="kn-btn kn-btn--primary kn-btn--sm" @onclick="OpenAddPageModal">Add Page</button>
                        </div>
                    </div>

                    @if (isLoadingPages)
                    {
                        <p class="kn-s3-empty">Loading pages…</p>
                    }
                    else if (!contentPages.Any())
                    {
                        <p class="kn-s3-empty">No content pages yet. Click Add Page to create one.</p>
                    }
                    else
                    {
                        <div class="kn-s3-table-wrap">
                            <table class="kn-s3-table">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Slug</th>
                                        <th>Updated</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var contentPage in FilteredContentPages)
                                    {
                                        <tr>
                                            <td class="kn-s3-table__subject">@contentPage.Title</td>
                                            <td>/page/@contentPage.Slug</td>
                                            <td>@FormatTimeAgo(contentPage.UpdatedAt)</td>
                                            <td>
                                                <div class="kn-s3-actions">
                                                    <button type="button" class="kn-btn kn-btn--outline kn-btn--sm" @onclick="() => OpenEditPageModal(contentPage)">Edit</button>
                                                    <button type="button" class="kn-btn kn-btn--outline kn-btn--sm" @onclick="() => ConfirmDeletePage(contentPage)">Delete</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(pageError))
                    {
                        <p class="kn-s3-empty" style="color:var(--kn-danger);">@pageError</p>
                    }
                </div>

                @if (showPageModal)
                {
                    <div class="kn-modal-backdrop" @onclick="ClosePageModal">
                        <div class="kn-modal" @onclick:stopPropagation>
                            <div class="kn-modal__head">
                                <h2>@(isEditingPage ? "Edit Page" : "Add Page")</h2>
                                <button class="kn-modal__close" @onclick="ClosePageModal">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" x2="6" y1="6" y2="18"/>
                                        <line x1="6" x2="18" y1="6" y2="18"/>
                                    </svg>
                                </button>
                            </div>
                            <div class="kn-modal__body">
                                <div class="kn-form-row">
                                    <div class="kn-field">
                                        <label>Title *</label>
                                        <input type="text" @bind="pageFormTitle" placeholder="e.g. Terms of Service" />
                                    </div>
                                </div>
                                <div class="kn-form-row">
                                    <div class="kn-field">
                                        <label>Slug *</label>
                                        <input type="text" @bind="pageFormSlug" placeholder="e.g. terms-of-service" disabled="@isEditingPage" />
                                    </div>
                                </div>
                                <div class="kn-form-row">
                                    <div class="kn-field">
                                        <label>Content *</label>
                                        <textarea @bind="pageFormContent" placeholder="Write the page content here..." rows="12"></textarea>
                                    </div>
                                </div>
                            </div>
                            <div class="kn-modal__foot">
                                <button class="kn-btn kn-btn--outline" @onclick="ClosePageModal">Cancel</button>
                                <button class="kn-btn kn-btn--primary" @onclick="SavePage" disabled="@isSavingPage">
                                    @if (isSavingPage)
                                    {
                                        <span>Saving...</span>
                                    }
                                    else
                                    {
                                        <span>@(isEditingPage ? "Update" : "Add Page")</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <!-- Delete Page Confirmation -->
                @if (showDeletePageConfirm)
                {
                    <div class="kn-modal-backdrop" @onclick="() => showDeletePageConfirm = false">
                        <div class="kn-modal kn-modal--sm" @onclick:stopPropagation>
                            <div class="confirm-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 6h18"/>
                                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                </svg>
                            </div>
                            <h3>Delete Page</h3>
                            <p>Are you sure you want to delete <strong>@deletingPage?.Title</strong>? This action cannot be undone.</p>
                            <div class="kn-modal__foot">
                                <button class="kn-btn kn-btn--outline" @onclick="() => showDeletePageConfirm = false">Cancel</button>
                                <button class="kn-btn kn-btn--danger" @onclick="DeletePage" disabled="@isDeletingPage">
                                    @(isDeletingPage ? "Deleting..." : "Delete")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (activeTab == "chat")
            {
                <div class="kn-s3-panel kn-s3-empty">
                    <p>Live chat lives in Support Hub.</p>
                    <a class="kn-btn kn-btn--primary kn-btn--sm" href="/admin/support?tab=chat">Open Support Hub</a>
                </div>
            }
    </ChildContent>
</KnHubShell>

<!-- Toast Notification -->
@if (showToast)
{
    <div class="kn-toast-wrap">
        <div class="kn-toast kn-toast--@toastType">
            @if (toastType == "success")
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            }
            <span>@toastMessage</span>
        </div>
    </div>
}
}

@code {
    private bool isSidebarOpen = false;
    private string activeTab = "overview";
    private string searchQuery = "";
    private string chatSearchQuery = "";
    private string newMessage = "";
    private Conversation? selectedConversation;
    private bool isCheckingAuth = true;
    private bool isAuthenticated = false;
    private string currentUserEmail = "";

    private OverviewDto? overview;

    // Toast notification state
    private bool showToast = false;
    private string toastMessage = "";
    private string toastType = "success"; // "success" or "error"
    private System.Threading.Timer? _toastTimer;

    // Software Products (from Supabase)
    private List<Software> softwareProducts = new();
    private bool isLoadingProducts = true;
    private string? productError;

    // Product Modal State
    private bool showProductModal = false;
    private bool isEditingProduct = false;
    private bool isSavingProduct = false;
    private string? editingProductId;

    // Delete Confirmation State
    private bool showDeleteConfirm = false;
    private bool isDeletingProduct = false;
    private Software? deletingProduct;

    // Form Fields
    private string formName = "";
    private string formShortDesc = "";
    private string formFullDesc = "";
    private string formVersion = "";
    private string formCategory = "";
    private string formStatus = "active";
    private string formVisibility = "public";
    private string formReleaseDate = "";
    private string formIconColor = "#3b82f6";
    private int formActiveUsers = 0;
    private int formTotalDownloads = 0;

    // Color Options
    private string[] colorOptions = new[] { "#3b82f6", "#8b5cf6", "#10b981", "#f97316", "#6366f1", "#0ea5e9", "#ef4444", "#ec4899" };

    // Conversations Data
    private List<Conversation> conversations = new()
    {
        new Conversation { Id = 1, Name = "Alex Thompson", Email = "alex.t@company.com", Initials = "AT", AvatarColor = "#3b82f6", LastMessage = "Thanks for the quick response!", LastMessageTime = "Nov 7", Status = "Active", UnreadCount = 2 },
        new Conversation { Id = 2, Name = "Maria Garcia", Email = "maria.g@startup.io", Initials = "MG", AvatarColor = "#8b5cf6", LastMessage = "When can we schedule a call?", LastMessageTime = "Nov 7", Status = "Waiting", UnreadCount = 1 },
        new Conversation { Id = 3, Name = "Robert Kim", Email = "robert.k@enterprise.com", Initials = "RK", AvatarColor = "#10b981", LastMessage = "Perfect, thank you for your help!", LastMessageTime = "Nov 6", Status = "Resolved", UnreadCount = 0 },
        new Conversation { Id = 4, Name = "Jennifer Lee", Email = "jennifer.l@design.co", Initials = "JL", AvatarColor = "#f97316", LastMessage = "Can you share your portfolio?", LastMessageTime = "Nov 7", Status = "Waiting", UnreadCount = 3 }
    };

    // Messages Data
    private Dictionary<int, List<ChatMessage>> messagesData = new()
    {
        { 1, new List<ChatMessage>
            {
                new ChatMessage { Text = "Hi, I'm interested in your web development services. Can you help me build an e-commerce platform?", IsFromCustomer = true, Time = "09:15 PM" },
                new ChatMessage { Text = "Hello Alex! Absolutely, we'd be happy to help. We have extensive experience building scalable e-commerce platforms. Could you tell me more about your requirements?", IsFromCustomer = false, Time = "09:18 PM" },
                new ChatMessage { Text = "I need a platform that can handle around 5,000 products with payment integration, inventory management, and customer reviews.", IsFromCustomer = true, Time = "09:25 PM" },
                new ChatMessage { Text = "Thanks for the quick response!", IsFromCustomer = true, Time = "09:30 PM" }
            }
        },
        { 2, new List<ChatMessage>
            {
                new ChatMessage { Text = "Hello, I'm looking for mobile app development services.", IsFromCustomer = true, Time = "10:00 AM" },
                new ChatMessage { Text = "Hi Maria! We'd love to help. What kind of app are you looking to build?", IsFromCustomer = false, Time = "10:05 AM" },
                new ChatMessage { Text = "When can we schedule a call?", IsFromCustomer = true, Time = "10:15 AM" }
            }
        },
        { 3, new List<ChatMessage>
            {
                new ChatMessage { Text = "We need cloud migration services for our enterprise.", IsFromCustomer = true, Time = "02:00 PM" },
                new ChatMessage { Text = "Perfect, thank you for your help!", IsFromCustomer = true, Time = "04:30 PM" }
            }
        },
        { 4, new List<ChatMessage>
            {
                new ChatMessage { Text = "I'm interested in UI/UX design services.", IsFromCustomer = true, Time = "11:00 AM" },
                new ChatMessage { Text = "Can you share your portfolio?", IsFromCustomer = true, Time = "11:30 AM" }
            }
        }
    };

    private IEnumerable<Software> FilteredSoftwareProducts =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? softwareProducts
            : softwareProducts.Where(p => p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                          (p.Category ?? "").Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<Conversation> FilteredConversations =>
        string.IsNullOrWhiteSpace(chatSearchQuery)
            ? conversations
            : conversations.Where(c => c.Name.Contains(chatSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                                       c.Email.Contains(chatSearchQuery, StringComparison.OrdinalIgnoreCase) ||
                                       c.LastMessage.Contains(chatSearchQuery, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        selectedConversation = conversations.FirstOrDefault();
        ApplyTabFromQuery();

        // Restore persisted session, then require an admin user
        var (user, session) = await AuthService.GetAuthenticatedAdminAsync();

        if (user == null || session == null)
        {
            isAuthenticated = false;
            isCheckingAuth = false;
            Navigation.NavigateTo("/admin/login");
            return;
        }

        currentUserEmail = user.Email ?? "";
        isAuthenticated = true;
        isCheckingAuth = false;

        try
        {
            await SupportApi.EnsureAgentTokenAsync();
            var ov = await SupportApi.GetOverviewAsync();
            if (ov.Success)
                overview = ov.Data;
        }
        catch
        {
            // Overview metrics optional on dashboard load
        }

        await LoadProducts();
        await LoadPages();
    }

    private void ApplyTabFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrEmpty(query))
            return;

        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length != 2)
                continue;

            if (!string.Equals(Uri.UnescapeDataString(pair[0]), "tab", StringComparison.OrdinalIgnoreCase))
                continue;

            var tab = Uri.UnescapeDataString(pair[1]);
            if (tab is "overview" or "products" or "pages" or "chat")
                activeTab = tab;
            break;
        }
    }

