@page "/admin"
@layout Components.Layout.AdminLayout
@using KobNeti.Services
@using KobNeti.Services.Support
@using KobNeti.Models
@implements IDisposable
@inject SupabaseAuthService AuthService
@inject SoftwareProductService ProductService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject PageContentService PageContentService
@inject SupportApiClient SupportApi

<PageTitle>Admin Dashboard - KobNeti</PageTitle>

@if (isCheckingAuth)
{
    <div class="loading-container">
        <p>Loading...</p>
    </div>
}
else if (!isAuthenticated)
{
    <div class="loading-container">
        <p>Redirecting to login...</p>
    </div>
}
else
{
<div class="admin-dashboard admin-dashboard--embedded">
    <!-- Main Content -->
    <main class="main-content">
        <header class="dashboard-header">
            <div class="header-content">
                <div>
                    <h1>@GetTabTitle()</h1>
                    <p class="header-subtitle">@GetTabSubtitle()</p>
                </div>
                <button class="admin-access-btn" @onclick="NavigateHome">Admin Access</button>
            </div>
        </header>

        <nav class="ops-subnav">
            <button type="button" class="ops-subnav__item @(activeTab == "overview" ? "active" : "")" @onclick="@(() => SetActiveTab("overview"))">Overview</button>
            <button type="button" class="ops-subnav__item @(activeTab == "products" ? "active" : "")" @onclick="@(() => SetActiveTab("products"))">Projects</button>
            <button type="button" class="ops-subnav__item @(activeTab == "pages" ? "active" : "")" @onclick="@(() => SetActiveTab("pages"))">Content Pages</button>
            <a href="/admin/support" class="ops-subnav__item">Support Hub</a>
        </nav>

        <div class="dashboard-content">
            @if (activeTab == "overview")
            {
                <KnPageHeader Title="Overview" Subtitle="@($"Live ops for {SupportApi.DisplayName}")" />
                <div class="kn-metric-grid" style="margin-bottom:1.5rem;">
                    <KnMetric Label="Active chats" Value="@($"{overview?.ActiveChats ?? 0}")" />
                    <KnMetric Label="Open tickets" Value="@($"{overview?.OpenTickets ?? 0}")" />
                    <KnMetric Label="Open incidents" Value="@($"{overview?.OpenIncidents ?? 0}")" />
                    <KnMetric Label="Eng in progress" Value="@($"{overview?.EngTasksInProgress ?? 0}")" />
                    <KnMetric Label="Pending approvals" Value="@($"{overview?.PendingApprovals ?? 0}")" />
                    <KnMetric Label="Unread alerts" Value="@($"{overview?.UnreadNotifications ?? 0}")" />
                </div>
                <div class="kn-s3-page" style="margin-top:0.5rem;">
                    <div class="kn-s3-status">
                        <div class="kn-s3-status__left">
                            <span class="kn-s3-status__dot" aria-hidden="true"></span>
                            <div>
                                <strong>All systems operational</strong>
                                <p style="margin:0.25rem 0 0;font-size:0.85rem;color:var(--kn-text-muted);">
                                    @SupportApi.DisplayName desk is connected to KobNetiApi.
                                </p>
                            </div>
                        </div>
                        <div class="kn-s3-status__metrics">
                            <span><strong>@(softwareProducts.Count(p => p.Status == "active"))</strong>Active products</span>
                            <span><strong>@(overview?.ActiveChats ?? 0)</strong>Live chats</span>
                            <span><strong>@(overview?.OpenIncidents ?? 0)</strong>Open incidents</span>
                        </div>
                    </div>

                    <div class="kn-s3-grid-2 kn-s3-grid-60-40">
                        <div class="kn-s3-panel">
                            <h3>Operations snapshot</h3>
                            <div class="kn-s3-list-row"><span>Engineering in progress</span><strong>@(overview?.EngTasksInProgress ?? 0)</strong></div>
                            <div class="kn-s3-list-row"><span>Pending approvals</span><strong>@(overview?.PendingApprovals ?? 0)</strong></div>
                            <div class="kn-s3-list-row"><span>Unread alerts</span><strong>@(overview?.UnreadNotifications ?? 0)</strong></div>
                            <div class="kn-s3-list-row"><span>Open tickets</span><strong>@(overview?.OpenTickets ?? 0)</strong></div>
                        </div>
                        <div class="kn-s3-panel">
                            <h3>Quick actions</h3>
                            <div class="kn-s3-actions">
                                <a class="kn-btn kn-btn--primary kn-btn--sm" href="/admin/support">Support Hub</a>
                                <a class="kn-btn kn-btn--outline kn-btn--sm" href="/admin/engineering">Engineering</a>
                                <a class="kn-btn kn-btn--outline kn-btn--sm" href="/admin/insights">Insights</a>
                                <a class="kn-btn kn-btn--outline kn-btn--sm" href="/admin/platform">Platform</a>
                            </div>
                        </div>
                    </div>

                    <div class="kn-s3-panel">
                        <h3>Product registry</h3>
                        @if (isLoadingProducts)
                        {
                            <p class="kn-s3-empty">Loading products…</p>
                        }
                        else if (softwareProducts.Count == 0)
                        {
                            <p class="kn-s3-empty">No products in catalog yet.</p>
                        }
                        else
                        {
                            <div class="kn-s3-table-wrap">
                                <table class="kn-s3-table">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th>Category</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var product in softwareProducts.Take(8))
                                        {
                                            <tr>
                                                <td class="kn-s3-table__subject">@product.Name</td>
                                                <td>@product.Category</td>
                                                <td>@(string.Equals(product.Status, "active", StringComparison.OrdinalIgnoreCase) ? "Active" : product.Status)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (activeTab == "products")
            {
                <!-- Search and Add Button -->
                <div class="products-toolbar">
                    <div class="search-bar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.3-4.3"/>
                        </svg>
                        <input type="text" placeholder="Search software..." @bind="searchQuery" @bind:event="oninput" />
                    </div>
                    <button class="export-btn" @onclick="ExportBackup" title="Export products as JSON backup">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" x2="12" y1="15" y2="3"/>
                        </svg>
                        <span>Export</span>
                    </button>
                    <button class="add-product-btn" @onclick="OpenAddModal">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" x2="12" y1="5" y2="19"/>
                            <line x1="5" x2="19" y1="12" y2="12"/>
                        </svg>
                        <span>Add Project</span>
                    </button>
                </div>

                <!-- Products Grid -->
                @if (isLoadingProducts)
                {
                    <div class="loading-products">
                        <p>Loading products...</p>
                    </div>
                }
                else if (!softwareProducts.Any())
                {
                    <div class="empty-products">
                        <p>No projects yet. Click "Add Project" to create one.</p>
                    </div>
                }
                else
                {
                    <div class="products-grid">
                        @foreach (var product in FilteredSoftwareProducts)
                        {
                            <div class="product-card">
                                <div class="product-header">
                                    <div class="product-icon" style="background: @product.IconColor">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                                        </svg>
                                    </div>
                                    <div class="product-title">
                                        <h3>@product.Name</h3>
                                        <p>@product.Category</p>
                                    </div>
                                    <span class="product-status @product.Status">@product.Status</span>
                                </div>
                                <div class="product-stats">
                                    <div class="product-stat">
                                        <span class="stat-label">Version</span>
                                        <span class="stat-value">@product.Version</span>
                                    </div>
                                    <div class="product-stat">
                                        <span class="stat-label">Release Date</span>
                                        <span class="stat-value">@FormatReleaseDate(product.ReleaseDate)</span>
                                    </div>
                                </div>
                                <div class="product-stats">
                                    <div class="product-stat">
                                        <span class="stat-label">Active Users</span>
                                        <span class="stat-value">@product.ActiveUsers.ToString("N0")</span>
                                    </div>
                                    <div class="product-stat">
                                        <span class="stat-label">Total Downloads</span>
                                        <span class="stat-value">@product.TotalDownloads.ToString("N0")</span>
                                    </div>
                                </div>
                                <div class="product-footer">
                                    <span class="last-update">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                                            <line x1="16" x2="16" y1="2" y2="6"/>
                                            <line x1="8" x2="8" y1="2" y2="6"/>
                                            <line x1="3" x2="21" y1="10" y2="10"/>
                                        </svg>
                                        @FormatTimeAgo(product.UpdatedAt)
                                    </span>
                                    <div class="product-actions">
                                        <button class="action-btn edit" @onclick="() => OpenEditModal(product)" title="Edit">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                                <path d="m15 5 4 4"/>
                                            </svg>
                                        </button>
                                        <button class="action-btn delete" @onclick="() => ConfirmDelete(product)" title="Delete">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 6h18"/>
                                                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(productError))
                {
                    <div class="product-error">@productError</div>
                }

                <!-- Add/Edit Product Modal -->
                @if (showProductModal)
                {
                    <div class="modal-overlay" @onclick="CloseProductModal">
                        <div class="modal-card" @onclick:stopPropagation>
                            <div class="modal-header">
                                <h2>@(isEditingProduct ? "Edit Project" : "Add Project")</h2>
                                <button class="modal-close" @onclick="CloseProductModal">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" x2="6" y1="6" y2="18"/>
                                        <line x1="6" x2="18" y1="6" y2="18"/>
                                    </svg>
                                </button>
                            </div>
                            <div class="modal-body">
                                <div class="form-row">
                                    <div class="form-field">
                                        <label>Name *</label>
                                        <input type="text" @bind="formName" placeholder="Product name" />
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-field">
                                        <label>Short Description</label>
                                        <input type="text" @bind="formShortDesc" placeholder="Brief description" />
                                    </div>
                                </div>
                                <div class="form-row two-col">
                                    <div class="form-field">
                                        <label>Category</label>
                                        <input type="text" @bind="formCategory" placeholder="e.g. Data & Analytics" />
                                    </div>
                                    <div class="form-field">
                                        <label>Version</label>
                                        <input type="text" @bind="formVersion" placeholder="e.g. v1.0.0" />
                                    </div>
                                </div>
                                <div class="form-row two-col">
                                    <div class="form-field">
                                        <label>Status</label>
                                        <select @bind="formStatus">
                                            <option value="active">Active</option>
                                            <option value="upcoming">Upcoming</option>
                                            <option value="deprecated">Deprecated</option>
                                        </select>
                                    </div>
                                    <div class="form-field">
                                        <label>Visibility</label>
                                        <select @bind="formVisibility">
                                            <option value="public">Public</option>
                                            <option value="hidden">Hidden</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-row two-col">
                                    <div class="form-field">
                                        <label>Release Date</label>
                                        <input type="date" value="@formReleaseDate" @onchange="@(e => formReleaseDate = e.Value?.ToString() ?? "")" />
                                    </div>
                                    <div class="form-field">
                                        <label>Icon Color</label>
                                        <div class="color-picker">
                                            @foreach (var color in colorOptions)
                                            {
                                                <button type="button"
                                                        class="color-option @(formIconColor == color ? "selected" : "")"
                                                        style="background: @color"
                                                        @onclick="() => formIconColor = color">
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row two-col">
                                    <div class="form-field">
                                        <label>Active Users</label>
                                        <input type="number" @bind="formActiveUsers" placeholder="0" />
                                    </div>
                                    <div class="form-field">
                                        <label>Total Downloads</label>
                                        <input type="number" @bind="formTotalDownloads" placeholder="0" />
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-field">
                                        <label>Full Description</label>
                                        <textarea @bind="formFullDesc" placeholder="Detailed product description..." rows="3"></textarea>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button class="modal-btn cancel" @onclick="CloseProductModal">Cancel</button>
                                <button class="modal-btn save" @onclick="SaveProduct" disabled="@isSavingProduct">
                                    @if (isSavingProduct)
                                    {
                                        <span>Saving...</span>
                                    }
                                    else
                                    {
                                        <span>@(isEditingProduct ? "Update" : "Add Project")</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <!-- Delete Confirmation Modal -->
                @if (showDeleteConfirm)
                {
                    <div class="modal-overlay" @onclick="() => showDeleteConfirm = false">
                        <div class="confirm-dialog" @onclick:stopPropagation>
                            <div class="confirm-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 6h18"/>
                                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                </svg>
                            </div>
                            <h3>Delete Product</h3>
                            <p>Are you sure you want to delete <strong>@deletingProduct?.Name</strong>? This action cannot be undone.</p>
                            <div class="confirm-actions">
                                <button class="modal-btn cancel" @onclick="() => showDeleteConfirm = false">Cancel</button>
                                <button class="modal-btn delete" @onclick="DeleteProduct" disabled="@isDeletingProduct">
                                    @(isDeletingProduct ? "Deleting..." : "Delete")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (activeTab == "pages")
            {
                <!-- Content Pages Management -->
                <div class="products-toolbar">
                    <div class="search-bar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.3-4.3"/>
                        </svg>
                        <input type="text" placeholder="Search pages..." @bind="pageSearchQuery" @bind:event="oninput" />
                    </div>
                    <button class="add-product-btn" @onclick="OpenAddPageModal">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" x2="12" y1="5" y2="19"/>
                            <line x1="5" x2="19" y1="12" y2="12"/>
                        </svg>
                        <span>Add Page</span>
                    </button>
                </div>

                @if (isLoadingPages)
                {
                    <div class="loading-products">
                        <p>Loading pages...</p>
                    </div>
                }
                else if (!contentPages.Any())
                {
                    <div class="empty-products">
                        <p>No content pages yet. Click "Add Page" to create one.</p>
                    </div>
                }
                else
                {
                    <div class="products-grid pages-grid">
                        @foreach (var page in FilteredContentPages)
                        {
                            <div class="product-card">
                                <div class="product-header">
                                    <div class="product-icon" style="background: #6366f1">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                                            <polyline points="14 2 14 8 20 8"/>
                                        </svg>
                                    </div>
                                    <div class="product-title">
                                        <h3>@(page.Title)</h3>
                                        <p>/@(page.Slug)</p>
                                    </div>
                                </div>
                                <div class="product-stats">
                                    <div class="product-stat">
                                        <span class="stat-label">URL</span>
                                        <span class="stat-value">/page/@(page.Slug)</span>
                                    </div>
                                    <div class="product-stat">
                                        <span class="stat-label">Updated</span>
                                        <span class="stat-value">@FormatTimeAgo(page.UpdatedAt)</span>
                                    </div>
                                </div>
                                <div class="product-footer">
                                    <span class="last-update">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                                            <polyline points="14 2 14 8 20 8"/>
                                        </svg>
                                        @(page.Content.Length > 50 ? page.Content.Substring(0, 50) + "..." : page.Content)
                                    </span>
                                    <div class="product-actions">
                                        <button class="action-btn edit" @onclick="() => OpenEditPageModal(page)" title="Edit">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                                <path d="m15 5 4 4"/>
                                            </svg>
                                        </button>
                                        <button class="action-btn delete" @onclick="() => ConfirmDeletePage(page)" title="Delete">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 6h18"/>
                                                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(pageError))
                {
                    <div class="product-error">@pageError</div>
                }

                <!-- Add/Edit Page Modal -->
                @if (showPageModal)
                {
                    <div class="modal-overlay" @onclick="ClosePageModal">
                        <div class="modal-card" @onclick:stopPropagation>
                            <div class="modal-header">
                                <h2>@(isEditingPage ? "Edit Page" : "Add Page")</h2>
                                <button class="modal-close" @onclick="ClosePageModal">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" x2="6" y1="6" y2="18"/>
                                        <line x1="6" x2="18" y1="6" y2="18"/>
                                    </svg>
                                </button>
                            </div>
                            <div class="modal-body">
                                <div class="form-row">
                                    <div class="form-field">
                                        <label>Title *</label>
                                        <input type="text" @bind="pageFormTitle" placeholder="e.g. Terms of Service" />
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-field">
                                        <label>Slug *</label>
                                        <input type="text" @bind="pageFormSlug" placeholder="e.g. terms-of-service" disabled="@isEditingPage" />
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-field">
                                        <label>Content *</label>
                                        <textarea @bind="pageFormContent" placeholder="Write the page content here..." rows="12"></textarea>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button class="modal-btn cancel" @onclick="ClosePageModal">Cancel</button>
                                <button class="modal-btn save" @onclick="SavePage" disabled="@isSavingPage">
                                    @if (isSavingPage)
                                    {
                                        <span>Saving...</span>
                                    }
                                    else
                                    {
                                        <span>@(isEditingPage ? "Update" : "Add Page")</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <!-- Delete Page Confirmation -->
                @if (showDeletePageConfirm)
                {
                    <div class="modal-overlay" @onclick="() => showDeletePageConfirm = false">
                        <div class="confirm-dialog" @onclick:stopPropagation>
                            <div class="confirm-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 6h18"/>
                                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                                </svg>
                            </div>
                            <h3>Delete Page</h3>
                            <p>Are you sure you want to delete <strong>@deletingPage?.Title</strong>? This action cannot be undone.</p>
                            <div class="confirm-actions">
                                <button class="modal-btn cancel" @onclick="() => showDeletePageConfirm = false">Cancel</button>
