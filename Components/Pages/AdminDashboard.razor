    private async Task SaveProduct()
    {
        // Client-side validation
        if (string.IsNullOrWhiteSpace(formName))
        {
            productError = "Product name is required.";
            return;
        }
        if (formName.Trim().Length > 100)
        {
            productError = "Product name must be 100 characters or less.";
            return;
        }
        if (string.IsNullOrWhiteSpace(formVersion))
        {
            productError = "Version is required.";
            return;
        }
        if (formVersion.Trim().Length > 20)
        {
            productError = "Version must be 20 characters or less.";
            return;
        }
        if (formShortDesc?.Length > 200)
        {
            productError = "Short description must be 200 characters or less.";
            return;
        }
        if (formFullDesc?.Length > 2000)
        {
            productError = "Full description must be 2000 characters or less.";
            return;
        }
        if (formActiveUsers < 0 || formTotalDownloads < 0)
        {
            productError = "Active users and downloads cannot be negative.";
            return;
        }

        isSavingProduct = true;
        productError = null;
        StateHasChanged();

        try
        {
            if (isEditingProduct && editingProductId != null)
            {
                var existingProduct = softwareProducts.FirstOrDefault(p => p.Id == editingProductId);
                var software = new Software
                {
                    Id = editingProductId,
                    Name = formName,
                    ShortDescription = formShortDesc,
                    FullDescription = formFullDesc,
                    Version = formVersion,
                    Category = formCategory,
                    Status = formStatus,
                    Visibility = formVisibility,
                    ReleaseDate = formReleaseDate,
                    IconColor = formIconColor,
                    ActiveUsers = formActiveUsers,
                    TotalDownloads = formTotalDownloads,
                    CreatedAt = existingProduct?.CreatedAt
                };
                await ProductService.UpdateAsync(software);
            }
            else
            {
                var software = new Software
                {
                    Name = formName,
                    ShortDescription = formShortDesc,
                    FullDescription = formFullDesc,
                    Version = formVersion,
                    Category = formCategory,
                    Status = formStatus,
                    Visibility = formVisibility,
                    ReleaseDate = formReleaseDate,
                    IconColor = formIconColor,
                    ActiveUsers = formActiveUsers,
                    TotalDownloads = formTotalDownloads
                };
                await ProductService.CreateAsync(software);
            }

            showProductModal = false;
            ResetForm();
            await LoadProducts();
            ShowToast(isEditingProduct ? "Product updated successfully" : "Product created successfully");
        }
        catch (Exception ex)
        {
            productError = $"Failed to save product: {ex.Message}";
            ShowToast($"Failed to save product: {ex.Message}", "error");
        }
        finally
        {
            isSavingProduct = false;
            StateHasChanged();
        }
    }

