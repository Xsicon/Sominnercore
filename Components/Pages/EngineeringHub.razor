@page "/admin/engineering"
@layout Components.Layout.AdminLayout
@using KobNeti.Services
@using KobNeti.Services.Support
@using KobNeti.Components.Engineering
@inject SupabaseAuthService AuthService
@inject SupportApiClient SupportApi
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Engineering - KobNeti</PageTitle>

@if (isCheckingAuth)
{
    <div class="kn-hub-loading"><p>Loading...</p></div>
}
else if (!isAuthenticated)
{
    <div class="kn-hub-loading"><p>Redirecting to login...</p></div>
}
else
{
<KnHubShell BodyClass="kn-hub__body--scroll">
    <Tabs>
        <button type="button" class="kn-hub-subnav__item @(activeTab == "board" ? "is-active" : "")" @onclick="@(() => SetTab("board"))">Board</button>
        <button type="button" class="kn-hub-subnav__item @(activeTab == "milestones" ? "is-active" : "")" @onclick="@(() => SetTab("milestones"))">Milestones</button>
        <button type="button" class="kn-hub-subnav__item @(activeTab == "github" ? "is-active" : "")" @onclick="@(() => SetTab("github"))">GitHub</button>
    </Tabs>
    <ChildContent>
        @if (activeTab == "milestones")
        {
            <EngineeringMilestonesView @key="workspaceKey" />
        }
        else if (activeTab == "github")
        {
            <EngineeringGithubView @key="workspaceKey" />
        }
        else
        {
            <EngineeringBoardView @key="workspaceKey" />
        }
    </ChildContent>
</KnHubShell>
}

@code {
    private bool isCheckingAuth = true;
    private bool isAuthenticated;
    private string activeTab = "board";
    private int workspaceEpoch;
    private string workspaceKey => $"{SupportApi.TenantId}:{workspaceEpoch}";

    protected override async Task OnInitializedAsync()
    {
        var (user, session) = await AuthService.GetAuthenticatedAdminAsync();
        if (user == null || session == null)
        {
            isAuthenticated = false;
            isCheckingAuth = false;
            Navigation.NavigateTo("/admin/login");
            return;
        }

        isAuthenticated = true;
        isCheckingAuth = false;
        ApplyTabFromQuery();
        Navigation.LocationChanged += OnLocationChanged;
        SupportApi.TenantChanged += OnTenantChanged;
        try { await SupportApi.EnsureAgentTokenAsync(); } catch { /* shell handles */ }
    }

    private void OnTenantChanged()
    {
        workspaceEpoch++;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(() =>
        {
            ApplyTabFromQuery();
            StateHasChanged();
        });

    private void ApplyTabFromQuery()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrEmpty(query))
        {
            activeTab = "board";
            return;
        }
        foreach (var part in query.Split('&'))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && kv[0] == "tab")
            {
                var tab = Uri.UnescapeDataString(kv[1]);
                if (tab is "board" or "milestones" or "github")
                    activeTab = tab;
                return;
            }
        }
    }

    private Task SetTab(string tab)
    {
        activeTab = tab;
        Navigation.NavigateTo(tab == "board" ? "/admin/engineering" : $"/admin/engineering?tab={tab}", replace: true);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        SupportApi.TenantChanged -= OnTenantChanged;
    }
}
