@page "/admin/reset-password"
@layout Components.Layout.AdminLayout
@using KobNeti.Services
@inject SupabaseAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Reset password - KobNeti</PageTitle>

<div class="kn-login">
    <div class="kn-login__wrap">
        <div class="kn-login__card">
            <div class="kn-login__brand">
                <div class="kn-login__mark">K</div>
                <span class="kn-login__wordmark">KobNeti</span>
            </div>
            <div class="kn-login__caption">Operations Platform</div>
            <h1 class="kn-login__title">Choose a new password</h1>
            <p class="kn-login__sub">Enter a new password for your KobNeti account.</p>

            @if (done)
            {
                <div class="kn-login-modal__success" style="margin-top:1.25rem;">
                    <span class="material-symbols-outlined" style="font-size:2rem;color:#059669;">check_circle</span>
                    <p class="kn-login-modal__success-title">Password updated</p>
                    <p class="kn-login-modal__success-body">You can sign in with your new password.</p>
                    <a class="kn-login__submit kn-login__submit--sm" href="/admin/login" style="text-decoration:none;">Back to Sign In</a>
                </div>
            }
            else if (linkInvalid)
            {
                <div class="kn-login__error" style="margin-top:1.25rem;" role="alert">
                    @errorMessage
                </div>
                <a class="kn-login__submit" href="/admin/login" style="text-decoration:none;margin-top:1rem;">Request a new link</a>
            }
            else
            {
                <EditForm Model="model" OnValidSubmit="HandleSubmit" class="kn-login__form">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="kn-login__error" role="alert">@errorMessage</div>
                    }
                    <label class="kn-login__label" for="new-password">New password</label>
                    <input id="new-password" class="kn-login__input" type="password" autocomplete="new-password" required minlength="8"
                           @bind="model.Password" disabled="@busy" />
                    <label class="kn-login__label" for="confirm-password">Confirm password</label>
                    <input id="confirm-password" class="kn-login__input" type="password" autocomplete="new-password" required minlength="8"
                           @bind="model.Confirm" disabled="@busy" />
                    <button type="submit" class="kn-login__submit" disabled="@busy">
                        @(busy ? "Saving…" : "Update password")
                    </button>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    private readonly ResetModel model = new();
    private string? accessToken;
    private string? refreshToken;
    private bool busy;
    private bool done;
    private bool linkInvalid;
    private string? errorMessage;

    private class ResetModel
    {
        public string Password { get; set; } = "";
        public string Confirm { get; set; } = "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || accessToken != null || linkInvalid || done) return;

        try
        {
            // Supabase recovery redirects put tokens in the URL hash.
            var hash = await JS.InvokeAsync<string>("eval", "window.location.hash || ''");
            ParseTokens(hash);
            if (string.IsNullOrWhiteSpace(accessToken))
                ParseTokens("?" + new Uri(Navigation.Uri).Query.TrimStart('?'));

            if (string.IsNullOrWhiteSpace(accessToken) || string.IsNullOrWhiteSpace(refreshToken))
            {
                linkInvalid = true;
                errorMessage = "This reset link is missing or expired. Request a new one from the sign-in page.";
            }
        }
        catch
        {
            linkInvalid = true;
            errorMessage = "Could not read the reset link. Request a new one from the sign-in page.";
        }

        StateHasChanged();
    }

    private void ParseTokens(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return;
        var q = raw.TrimStart('#', '?');
        foreach (var part in q.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length != 2) continue;
            var key = Uri.UnescapeDataString(kv[0]);
            var val = Uri.UnescapeDataString(kv[1]);
            if (key.Equals("access_token", StringComparison.OrdinalIgnoreCase)) accessToken = val;
            if (key.Equals("refresh_token", StringComparison.OrdinalIgnoreCase)) refreshToken = val;
        }
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;
        if (model.Password != model.Confirm)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        busy = true;
        StateHasChanged();
        try
        {
            var (ok, err) = await AuthService.CompletePasswordResetAsync(
                accessToken ?? "", refreshToken ?? "", model.Password);
            if (!ok)
            {
                errorMessage = err ?? "Could not update password.";
                return;
            }

            done = true;
            try { await JS.InvokeVoidAsync("eval", "history.replaceState(null,'',window.location.pathname)"); } catch { /* ignore */ }
        }
        finally
        {
            busy = false;
        }
    }
}
