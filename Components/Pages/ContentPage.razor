@page "/page/{Slug}"
@using KobNeti.Services
@using KobNeti.Models
@inject PageContentService PageContentService

<PageTitle>@(pageContent?.Title ?? "Loading...") - KobNeti</PageTitle>

<section class="content-page-section">
    <div class="content-page-container">
        @if (isLoading)
        {
            <div class="content-loading">
                <p>Loading...</p>
            </div>
        }
        else if (pageContent == null)
        {
            <div class="content-not-found">
                <h1>Page Not Found</h1>
                <p>The requested page could not be found.</p>
                <a href="/" class="btn-back">Back to Home</a>
            </div>
        }
        else
        {
            <article class="content-article">
                <h1>@pageContent.Title</h1>
                @if (!string.IsNullOrEmpty(pageContent.UpdatedAt))
                {
                    <p class="content-updated">Last updated: @FormatDate(pageContent.UpdatedAt)</p>
                }
                <div class="content-body">
                    @((MarkupString)FormatContent(pageContent.Content))
                </div>
            </article>
        }
    </div>
</section>

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private PageContent? pageContent;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        try
        {
            pageContent = await PageContentService.GetBySlugAsync(Slug);
        }
        catch
        {
            pageContent = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatDate(string? dateStr)
    {
        if (string.IsNullOrEmpty(dateStr)) return "";
        if (DateTime.TryParse(dateStr, out var date))
            return date.ToString("MMMM d, yyyy");
        return dateStr;
    }

    private static string FormatContent(string content)
    {
        // Convert plain text line breaks to HTML paragraphs
        if (string.IsNullOrWhiteSpace(content)) return "";
        var lines = content.Split('\n');
        var result = new System.Text.StringBuilder();
        foreach (var line in lines)
        {
            var trimmed = line.Trim();
            if (string.IsNullOrEmpty(trimmed))
            {
                continue;
            }
            result.AppendLine($"<p>{System.Net.WebUtility.HtmlEncode(trimmed)}</p>");
        }
        return result.ToString();
    }
}
