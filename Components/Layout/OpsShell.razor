@using System.Text.Json
@using Microsoft.JSInterop
@using KobNeti.Services
@using KobNeti.Services.Support
@inject SupabaseAuthService AuthService
@inject SupportApiClient SupportApi
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

@* S2 — Studio Sidebar + Header structural port *@
<div class="ops-shell @(sidebarCollapsed ? "is-collapsed" : "") @(mobileOpen ? "is-sidebar-open" : "")">
    <aside class="ops-sidebar" id="main-sidebar" aria-label="Operations navigation">
        <div class="ops-sidebar__top">
            @if (!sidebarCollapsed)
            {
                <div>
                    <div class="ops-sidebar__name">KobNeti</div>
                    <p class="ops-sidebar__subtitle">Operations Platform</p>
                </div>
            }
            else
            {
                <div class="ops-sidebar__mark ops-sidebar__mark--solo">K</div>
            }
        </div>

        <div class="ops-sidebar__user-wrap">
            @if (!sidebarCollapsed)
            {
                <div class="ops-sidebar__user-card">
                    <div class="ops-sidebar__avatar ops-sidebar__avatar--lg">@GetUserInitials()</div>
                    <div class="ops-sidebar__user-meta">
                        <div class="ops-sidebar__user-line">
                            <span class="ops-sidebar__user-name">@GetUserDisplayName()</span>
                            <span class="ops-sidebar__online">Online</span>
                        </div>
                        <div class="ops-sidebar__user-role">@(string.IsNullOrWhiteSpace(agentRole) ? "Staff" : agentRole)</div>
                    </div>
                </div>
            }
            else
            {
                <div class="ops-sidebar__avatar ops-sidebar__avatar--lg ops-sidebar__avatar--center" title="@GetUserDisplayName()">@GetUserInitials()</div>
            }
        </div>

        <nav class="ops-sidebar__nav kn-scrollbar">
            <a href="/admin" class="ops-nav-link @(IsExactAdmin() ? "is-active" : "")" title="Overview">
                <span class="material-symbols-outlined">dashboard</span>
                @if (!sidebarCollapsed) { <span>Overview</span> }
            </a>

            @foreach (var cat in Categories)
            {
                if (cat.PlatformAdminOnly && !isPlatformAdmin)
                    continue;

                var catActive = cat.Items.Any(i => IsActive(i.Match));
                <div class="ops-nav-cat">
                    <button type="button" class="ops-nav-cat__btn @(catActive ? "is-active" : "")"
                            title="@cat.Label"
                            @onclick="() => OnCategoryClick(cat)">
                        <span class="ops-nav-cat__left">
                            <span class="material-symbols-outlined">@cat.Icon</span>
                            @if (!sidebarCollapsed) { <span>@cat.Label</span> }
                        </span>
                        @if (!sidebarCollapsed)
                        {
                            <span class="ops-nav-cat__right">
                                @if (!string.IsNullOrEmpty(cat.Badge))
                                {
                                    <span class="ops-badge ops-badge--@cat.BadgeTone">@cat.Badge</span>
                                }
                                <span class="material-symbols-outlined" style="font-size:1rem;opacity:0.7;">
                                    @(expanded.Contains(cat.Id) ? "expand_more" : "chevron_right")
                                </span>
                            </span>
                        }
                    </button>
                    @if (!sidebarCollapsed && expanded.Contains(cat.Id))
                    {
                        <div class="ops-nav-cat__subs">
                            @foreach (var item in cat.Items)
                            {
                                <a href="@item.Href" class="ops-nav-link ops-nav-link--sub @(IsNavLinkActive(item) ? "is-active" : "")">
                                    <span>@item.Label</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            }
        </nav>

        <div class="ops-sidebar__status">
            @if (!sidebarCollapsed)
            {
                <div class="ops-sidebar__status-row">
                    <span class="ops-pulse"></span>
                    <span>System Status: Online</span>
                </div>
                <span class="material-symbols-outlined" style="font-size:1rem;color:#34D399;">verified_user</span>
            }
            else
            {
                <span class="ops-pulse" title="System Status: Online"></span>
            }
        </div>
    </aside>

    @if (mobileOpen)
    {
        <div class="ops-overlay" @onclick="() => mobileOpen = false"></div>
    }

    <div class="ops-shell__main">
        <header class="ops-topbar">
            <div class="ops-topbar__left">
                <button type="button" class="ops-icon-btn ops-topbar__menu" @onclick="() => mobileOpen = !mobileOpen" aria-label="Toggle menu">
                    <span class="material-symbols-outlined">menu</span>
                </button>
                <button type="button" class="ops-icon-btn ops-topbar__collapse-desk" @onclick="ToggleCollapse" aria-label="Collapse sidebar">
                    <span class="material-symbols-outlined">menu</span>
                </button>
                <div class="ops-search" title="Search coming soon">
                    <span class="material-symbols-outlined">search</span>
                    <input type="text" placeholder="Search tickets, tasks, users, products..." readonly disabled />
                    <kbd>⌘K</kbd>
                </div>
            </div>

            <div class="ops-topbar__right">
                <div class="ops-product-menu">
                    <button type="button" class="ops-product-menu__btn" @onclick="ToggleProductMenu" aria-expanded="@showProductMenu">
                        <span class="material-symbols-outlined">layers</span>
                        <span>@SupportApi.DisplayName</span>
                        <span class="material-symbols-outlined" style="font-size:1rem;">expand_more</span>
                    </button>
                    @if (showProductMenu)
                    {
                        <div class="ops-dropdown ops-dropdown--product">
                            <div class="ops-dropdown__head"><strong>Switch product</strong></div>
                            @if (tenantsLoading)
                            {
                                <p class="ops-dropdown__empty">Loading desks…</p>
                            }
                            else if (!string.IsNullOrEmpty(tenantsError))
                            {
                                <p class="ops-dropdown__empty" style="color:#DC2626;">@tenantsError</p>
                            }
                            else
                            {
                                @foreach (var t in tenants)
                                {
                                    var active = string.Equals(t.TenantId, SupportApi.TenantId, StringComparison.OrdinalIgnoreCase);
                                    <button type="button"
                                            class="ops-dropdown__item @(active ? "is-active" : "")"
                                            @onclick="() => SelectTenantAsync(t)">
                                        <span>@t.DisplayName</span>
                                        @if (active)
                                        {
                                            <span class="material-symbols-outlined" style="font-size:1rem;">check</span>
                                        }
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
                <a class="ops-public-link" href="/" target="_blank" rel="noopener">
                    <span class="material-symbols-outlined">public</span>
                    <span>Public Website</span>
                </a>
                <button type="button" class="ops-icon-btn" title="Toggle theme" @onclick="ToggleTheme">
                    <span class="material-symbols-outlined">@(isDark ? "light_mode" : "dark_mode")</span>
                </button>
                <button type="button" class="ops-icon-btn ops-icon-btn--badge" title="Notifications" @onclick="ToggleNotifs">
                    <span class="material-symbols-outlined">notifications</span>
                    <span class="ops-dot">3</span>
                </button>
                @if (showNotifs)
                {
                    <div class="ops-dropdown ops-dropdown--wide">
                        <div class="ops-dropdown__head">
                            <strong>Notifications</strong>
                            <span class="ops-chip">3 New</span>
                        </div>
                        <p class="ops-dropdown__empty">Live notifications wire up in a later wave. Check Support Hub for open work.</p>
                        <a class="ops-dropdown__link" href="/admin/support">Open Support Hub</a>
                    </div>
                }
                <button type="button" class="ops-icon-btn ops-icon-btn--badge" title="Messages" @onclick="ToggleMsgs">
                    <span class="material-symbols-outlined">mail</span>
                    <span class="ops-dot">2</span>
                </button>
                @if (showMsgs)
                {
                    <div class="ops-dropdown">
                        <div class="ops-dropdown__head"><strong>Direct Messages</strong></div>
                        <p class="ops-dropdown__empty">Internal chat is available in Support → Internal Chat.</p>
                        <a class="ops-dropdown__link" href="/admin/support?tab=internal">Open Internal Chat</a>
                    </div>
                }
                <div class="ops-user-menu">
                    <button type="button" class="ops-user-menu__btn" @onclick="ToggleUserMenu">
                        <span class="ops-sidebar__avatar">@GetUserInitials()</span>
                        <span class="ops-user-menu__name">@GetUserDisplayName()</span>
                        <span class="material-symbols-outlined" style="font-size:1rem;">expand_more</span>
                    </button>
                    @if (showUserMenu)
                    {
                        <div class="ops-dropdown ops-dropdown--user">
                            <div class="ops-dropdown__profile">
                                <p class="ops-sidebar__user-name">@GetUserDisplayName()</p>
                                <p class="ops-sidebar__user-email">@currentUserEmail</p>
                                <span class="ops-access-pill">@(string.IsNullOrWhiteSpace(agentRole) ? "Staff" : agentRole)</span>
                            </div>
                            <button type="button" class="ops-dropdown__item" @onclick="OpenHelp">
                                <span class="material-symbols-outlined">help</span> Platform help
                            </button>
                            <button type="button" class="ops-dropdown__item ops-dropdown__item--danger" @onclick="HandleLogout">
                                <span class="material-symbols-outlined">logout</span> Sign Out
                            </button>
                        </div>
                    }
                </div>
            </div>
        </header>

        @if (helpOpen)
        {
            <div class="ops-help-panel" role="dialog" aria-label="Platform help">
                <div class="ops-help-panel__header">
                    <strong>Platform help</strong>
                    <KnButton Variant="outline" Size="sm" OnClick="CloseHelp">Close</KnButton>
                </div>
                @if (helpLoading)
                {
                    <KnEmpty Title="Loading…" />
                }
                else if (!string.IsNullOrEmpty(helpError))
                {
                    <KnEmpty Title="@helpError" />
                }
                else
                {
                    @foreach (var a in helpArticles)
                    {
                        <details style="padding:0.4rem 0;border-bottom:1px solid var(--kn-border);">
                            <summary>@a.Title</summary>
                            <p style="margin:0.4rem 0 0;font-size:0.9rem;opacity:0.9;">@a.Body</p>
                        </details>
                    }
                    <p style="margin-top:0.75rem;"><a href="/admin/insights">Open Insights → Help</a></p>
                }
            </div>
        }

        <div class="ops-content">
            <div class="ops-page-context">
                <h1 class="ops-page-context__title">@PageTitle</h1>
                <p class="ops-page-context__product">@SupportApi.DisplayName</p>
            </div>
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool sidebarCollapsed;
    private bool mobileOpen;
    private bool tenantsLoading = true;
    private string? tenantsError;
    private List<SupportTenantDto> tenants = [];
    private string currentUserEmail = "";
    private string agentRole = "";
    private bool isPlatformAdmin;
    private bool helpOpen;
    private bool helpLoading;
    private string? helpError;
    private List<PlatformHelpArticleDto> helpArticles = [];
    private HashSet<string> expanded = new(StringComparer.OrdinalIgnoreCase) { "tickets-support", "engineering" };
    private bool showNotifs;
    private bool showMsgs;
    private bool showUserMenu;
    private bool showProductMenu;
    private bool isDark;

    private sealed record NavLink(string Label, string Href, string Match);
    private sealed record NavCategory(
        string Id, string Label, string Icon, List<NavLink> Items,
        bool PlatformAdminOnly = false, string? Badge = null, string BadgeTone = "primary");

    private static readonly List<NavCategory> Categories =
    [
        new("tickets-support", "Tickets & Support", "confirmation_number",
        [
            new("Support Tickets", "/admin/support?tab=tickets", "/admin/support"),
            new("Live Chat", "/admin/support?tab=live", "/admin/support"),
            new("Escalations", "/admin/support?tab=incidents", "/admin/support"),
            new("Knowledge Base", "/admin/support?tab=kb", "/admin/support"),
            new("Internal Chat", "/admin/support?tab=internal", "/admin/support"),
        ], Badge: null),
        new("engineering", "Engineering", "code",
        [
            new("Task Board", "/admin/engineering?tab=board", "/admin/engineering"),
            new("Milestones", "/admin/engineering?tab=milestones", "/admin/engineering"),
            new("GitHub Activity", "/admin/engineering?tab=github", "/admin/engineering"),
        ]),
        new("time-payroll", "Time & Payroll", "schedule",
        [
            new("Time Tracking", "/admin/time", "/admin/time"),
            new("Approvals", "/admin/time?tab=approvals", "/admin/time"),
            new("Payroll Runs", "/admin/people", "/admin/people"),
        ]),
        new("people-teams", "People & Teams", "group",
        [
            new("Users", "/admin/staff", "/admin/staff"),
            new("Teams", "/admin/teams", "/admin/teams"),
        ], PlatformAdminOnly: true),
        new("products", "Products", "inventory_2",
        [
            new("Product Registry", "/admin", "/admin"),
            new("Linked Repositories", "/admin/engineering?tab=github", "/admin/engineering"),
        ]),
        new("communication", "Communication", "forum",
        [
            new("Calendar", "/admin/calendar", "/admin/calendar"),
            new("Notifications", "/admin/platform?tab=notifications", "/admin/platform"),
        ]),
        new("resources-files", "Resources & Files", "folder",
        [
            new("File Management", "/admin/platform?tab=files", "/admin/platform"),
            new("Assets", "/admin/insights?tab=assets", "/admin/insights"),
            new("Help Center", "/admin/insights?tab=help", "/admin/insights"),
        ]),
        new("system-analytics", "System & Analytics", "analytics",
        [
            new("Audit Logs", "/admin/platform?tab=audit", "/admin/platform"),
            new("Analytics & Reports", "/admin/insights", "/admin/insights"),
            new("Integrations", "/admin/platform?tab=integrations", "/admin/platform"),
        ]),
    ];

    private string PageTitle
    {
        get
        {
            var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
            if (path.Equals("/admin", StringComparison.OrdinalIgnoreCase)) return "Overview";
            if (path.StartsWith("/admin/support", StringComparison.OrdinalIgnoreCase)) return "Support Hub";
            if (path.StartsWith("/admin/engineering", StringComparison.OrdinalIgnoreCase)) return "Engineering";
            if (path.StartsWith("/admin/time", StringComparison.OrdinalIgnoreCase)) return "Time & Approvals";
            if (path.StartsWith("/admin/people", StringComparison.OrdinalIgnoreCase)) return "People Ops";
            if (path.StartsWith("/admin/calendar", StringComparison.OrdinalIgnoreCase)) return "Calendar";
            if (path.StartsWith("/admin/platform", StringComparison.OrdinalIgnoreCase)) return "Platform";
            if (path.StartsWith("/admin/insights", StringComparison.OrdinalIgnoreCase)) return "Insights";
            if (path.StartsWith("/admin/staff", StringComparison.OrdinalIgnoreCase)) return "Users";
            if (path.StartsWith("/admin/teams", StringComparison.OrdinalIgnoreCase)) return "Teams";
            return "KobNeti";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var (user, session) = await AuthService.GetAuthenticatedAdminAsync();
        if (user == null || session == null)
        {
            Navigation.NavigateTo("/admin/login");
            return;
        }

        currentUserEmail = user.Email ?? "";
        SupportApi.TenantChanged += OnTenantChanged;
        Navigation.LocationChanged += OnLocationChanged;

        try
        {
            await RestoreSelectedTenantAsync();
            await SupportApi.EnsureAgentTokenAsync();
            agentRole = SupportApi.AgentRole;
            isPlatformAdmin = SupportApi.IsPlatformAdmin;

            var result = await SupportApi.GetTenantsAsync();
            if (!result.Success)
            {
                tenantsError = result.Message;
                tenants = [];
            }
            else
            {
                tenants = result.Data ?? [];
                ApplyTenantIfMissingFromList();
            }

            ExpandForCurrentRoute();
        }
        catch (Exception ex)
        {
            tenantsError = ex.Message;
        }
        finally
        {
            tenantsLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            isDark = await JS.InvokeAsync<bool>("eval", "document.documentElement.classList.contains('dark')");
            var collapsed = await JS.InvokeAsync<string?>("eval", "localStorage.getItem('kobneti-ops-sidebar-collapsed')");
            sidebarCollapsed = collapsed == "1";
            StateHasChanged();
        }
        catch { /* ignore */ }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        ExpandForCurrentRoute();
        showNotifs = showMsgs = showUserMenu = showProductMenu = false;
        mobileOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ExpandForCurrentRoute()
    {
        foreach (var cat in Categories)
        {
            if (cat.Items.Any(i => IsActive(i.Match)))
                expanded.Add(cat.Id);
        }
    }

    private void OnCategoryClick(NavCategory cat)
    {
        if (sidebarCollapsed)
        {
            sidebarCollapsed = false;
            expanded.Add(cat.Id);
            _ = PersistCollapsedAsync();
            return;
        }

        if (!expanded.Add(cat.Id))
            expanded.Remove(cat.Id);
    }

    private void ToggleCollapse()
    {
        sidebarCollapsed = !sidebarCollapsed;
        _ = PersistCollapsedAsync();
    }

    private async Task PersistCollapsedAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval",
                $"localStorage.setItem('kobneti-ops-sidebar-collapsed','{(sidebarCollapsed ? "1" : "0")}')");
        }
        catch { /* ignore */ }
    }

    private void ToggleProductMenu()
    {
        showProductMenu = !showProductMenu;
        if (showProductMenu)
        {
            showNotifs = showMsgs = showUserMenu = false;
        }
    }

    private void ToggleNotifs()
    {
        showNotifs = !showNotifs;
        showMsgs = showUserMenu = showProductMenu = false;
    }

    private void ToggleMsgs()
    {
        showMsgs = !showMsgs;
        showNotifs = showUserMenu = showProductMenu = false;
    }

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
        showNotifs = showMsgs = showProductMenu = false;
    }

    private async Task ToggleTheme()
    {
        try
        {
            const string script =
                "(function(){var KEY='sominnercore-ui-theme';var cur=localStorage.getItem(KEY)||'light';var next=cur==='dark'?'light':'dark';localStorage.setItem(KEY,next);document.documentElement.classList.toggle('dark', next==='dark');})();";
            await JS.InvokeVoidAsync("eval", script);
            isDark = !isDark;
        }
        catch { /* ignore */ }
    }

    private Task CloseHelp()
    {
        helpOpen = false;
        return Task.CompletedTask;
    }

    private async Task OpenHelp()
    {
        showUserMenu = false;
        helpOpen = true;
        helpLoading = true;
        helpError = null;
        try
        {
            var r = await SupportApi.GetPlatformHelpAsync();
            helpArticles = r.Data ?? [];
            if (!r.Success) helpError = r.Message;
        }
        catch (Exception ex)
        {
            helpError = ex.Message;
        }
        finally
        {
            helpLoading = false;
        }
    }

    private void OnTenantChanged() => InvokeAsync(StateHasChanged);

    private bool IsExactAdmin()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        return string.Equals(relative, "admin", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsActive(string path)
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        var target = path.Trim('/');
        if (string.Equals(target, "admin", StringComparison.OrdinalIgnoreCase))
            return string.Equals(relative, "admin", StringComparison.OrdinalIgnoreCase);
        return relative.StartsWith(target, StringComparison.OrdinalIgnoreCase);
    }

    private bool IsNavLinkActive(NavLink item)
    {
        if (!IsActive(item.Match))
            return false;

        var current = Navigation.ToAbsoluteUri(Navigation.Uri);
        var target = Navigation.ToAbsoluteUri(item.Href);
        if (string.IsNullOrEmpty(target.Query))
            return string.IsNullOrEmpty(current.Query);

        var targetTab = GetTabQueryValue(target.Query);
        var currentTab = GetTabQueryValue(current.Query);
        if (string.IsNullOrEmpty(targetTab))
            return string.IsNullOrEmpty(currentTab);

        if (string.Equals(targetTab, currentTab, StringComparison.OrdinalIgnoreCase))
            return true;

        return (targetTab is "live" or "chat") && (currentTab is "live" or "chat");
    }

    private static string? GetTabQueryValue(string query)
    {
        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length != 2)
                continue;
            if (string.Equals(Uri.UnescapeDataString(pair[0]), "tab", StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(pair[1]);
        }

        return null;
    }

    private void ApplyTenantIfMissingFromList()
    {
        if (tenants.Count == 0) return;
        var current = tenants.FirstOrDefault(t =>
            string.Equals(t.TenantId, SupportApi.TenantId, StringComparison.OrdinalIgnoreCase));
        if (current != null)
        {
            SupportApi.SetTenant(current.TenantId, current.PublicKey, current.DisplayName, current.PublicHelpCenterUrl);
            return;
        }

        var first = tenants[0];
        SupportApi.SetTenant(first.TenantId, first.PublicKey, first.DisplayName, first.PublicHelpCenterUrl);
        _ = PersistSelectedTenantAsync(first);
    }

    private async Task RestoreSelectedTenantAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", SupportApiClient.SelectedTenantStorageKey);
            if (string.IsNullOrWhiteSpace(json)) return;
            var saved = JsonSerializer.Deserialize<SupportTenantDto>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (saved == null || string.IsNullOrWhiteSpace(saved.TenantId) || string.IsNullOrWhiteSpace(saved.PublicKey))
                return;
            SupportApi.SetTenant(saved.TenantId, saved.PublicKey, saved.DisplayName, saved.PublicHelpCenterUrl);
        }
        catch { /* keep default */ }
    }

    private async Task PersistSelectedTenantAsync(SupportTenantDto tenant)
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", SupportApiClient.SelectedTenantStorageKey, JsonSerializer.Serialize(tenant));
        }
        catch { /* non-fatal */ }
    }

    private async Task SelectTenantAsync(SupportTenantDto tenant)
    {
        SupportApi.SetTenant(tenant.TenantId, tenant.PublicKey, tenant.DisplayName, tenant.PublicHelpCenterUrl);
        await PersistSelectedTenantAsync(tenant);
        showProductMenu = false;
        mobileOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogout()
    {
        await AuthService.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    private string GetUserInitials()
    {
        if (string.IsNullOrEmpty(currentUserEmail)) return "?";
        var name = currentUserEmail.Split('@')[0];
        return name.Length >= 2 ? (name[0].ToString() + name[1]).ToUpperInvariant() : name.ToUpperInvariant();
    }

    private string GetUserDisplayName()
    {
        if (string.IsNullOrEmpty(currentUserEmail)) return "User";
        var name = currentUserEmail.Split('@')[0];
        return name.Length == 0 ? "User" : char.ToUpperInvariant(name[0]) + name[1..];
    }

    private string GetProductInitial()
    {
        var n = SupportApi.DisplayName;
        return string.IsNullOrWhiteSpace(n) ? "P" : n.Trim()[0].ToString().ToUpperInvariant();
    }

    public void Dispose()
    {
        SupportApi.TenantChanged -= OnTenantChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
