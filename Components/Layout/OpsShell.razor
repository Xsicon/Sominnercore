@using System.Text.Json
@using Microsoft.JSInterop
@using KobNeti.Services
@using KobNeti.Services.Support
@inject SupabaseAuthService AuthService
@inject SupportApiClient SupportApi
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

@* S0 minimal ops chrome — full Studio Sidebar/Header port is S2 *@
<div class="ops-shell @(sidebarOpen ? "is-sidebar-open" : "")">
    <aside class="ops-sidebar" aria-label="Operations navigation">
        <div class="ops-sidebar__header">
            <div class="ops-sidebar__brand">
                <div class="ops-sidebar__mark">K</div>
                <div>
                    <div class="ops-sidebar__name">KobNeti</div>
                    <p class="ops-sidebar__subtitle">Operations Platform</p>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(agentRole))
            {
                <span class="ops-sidebar__role">@agentRole</span>
            }
        </div>

        <div class="ops-product">
            <p class="ops-product__label">Product</p>
            @if (tenantsLoading)
            {
                <p class="ops-product__hint">Loading…</p>
            }
            else if (!string.IsNullOrEmpty(tenantsError))
            {
                <p class="ops-product__hint" style="color:#FCA5A5;">@tenantsError</p>
            }
            else
            {
                <div class="ops-product__list" role="list">
                    @foreach (var t in tenants)
                    {
                        var active = string.Equals(t.TenantId, SupportApi.TenantId, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                role="listitem"
                                class="ops-product__chip @(active ? "is-active" : "")"
                                @onclick="() => SelectTenantAsync(t)">
                            @t.DisplayName
                        </button>
                    }
                </div>
            }
        </div>

        <nav class="ops-sidebar__nav kn-scrollbar">
            <a href="/admin" class="ops-nav-link @(IsExactAdmin() ? "is-active" : "")">
                <span class="material-symbols-outlined">dashboard</span>
                <span>Overview</span>
            </a>

            @foreach (var cat in Categories)
            {
                if (cat.PlatformAdminOnly && !isPlatformAdmin)
                    continue;

                <div class="ops-nav-cat">
                    <button type="button" class="ops-nav-cat__btn" @onclick="() => ToggleCat(cat.Id)">
                        <span class="ops-nav-cat__left">
                            <span class="material-symbols-outlined">@cat.Icon</span>
                            <span>@cat.Label</span>
                        </span>
                        <span class="material-symbols-outlined" style="font-size:1rem;opacity:0.7;">
                            @(expanded.Contains(cat.Id) ? "expand_less" : "expand_more")
                        </span>
                    </button>
                    @if (expanded.Contains(cat.Id))
                    {
                        <div class="ops-nav-cat__subs">
                            @foreach (var item in cat.Items)
                            {
                                <a href="@item.Href" class="ops-nav-link @(IsActive(item.Match) ? "is-active" : "")">
                                    <span>@item.Label</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            }
        </nav>

        <div class="ops-sidebar__footer">
            <button type="button" class="ops-sidebar__help" @onclick="OpenHelp" title="Platform help">?</button>
            <div class="ops-sidebar__user">
                <div class="ops-sidebar__avatar"><span>@GetUserInitials()</span></div>
                <div>
                    <p class="ops-sidebar__user-name">@GetUserDisplayName()</p>
                    <p class="ops-sidebar__user-email">@currentUserEmail</p>
                </div>
            </div>
            <button class="ops-sidebar__logout" @onclick="HandleLogout" type="button">Logout</button>
        </div>
    </aside>

    @if (helpOpen)
    {
        <div class="ops-help-panel" role="dialog" aria-label="Platform help">
            <div class="ops-help-panel__header">
                <strong>Platform help</strong>
                <KnButton Variant="outline" Size="sm" OnClick="CloseHelp">Close</KnButton>
            </div>
            @if (helpLoading)
            {
                <KnEmpty Title="Loading…" />
            }
            else if (!string.IsNullOrEmpty(helpError))
            {
                <KnEmpty Title="@helpError" />
            }
            else
            {
                @foreach (var a in helpArticles)
                {
                    <details style="padding:0.4rem 0;border-bottom:1px solid var(--kn-border);">
                        <summary>@a.Title</summary>
                        <p style="margin:0.4rem 0 0;font-size:0.9rem;opacity:0.9;">@a.Body</p>
                    </details>
                }
                <p style="margin-top:0.75rem;"><a href="/admin/insights">Open Insights → Help</a></p>
            }
        </div>
    }

    @if (sidebarOpen)
    {
        <div class="ops-overlay" @onclick="ToggleSidebar"></div>
    }

    <div class="ops-shell__main">
        <header class="ops-topbar">
            <div class="ops-topbar__left">
                <button class="ops-topbar__menu kn-btn kn-btn--ghost kn-btn--sm" @onclick="ToggleSidebar" type="button" aria-label="Toggle menu">
                    <span class="material-symbols-outlined">menu</span>
                </button>
                <div>
                    <p class="ops-topbar__title">@PageTitle</p>
                    <div class="ops-topbar__product">@SupportApi.DisplayName</div>
                </div>
            </div>
            <div class="ops-topbar__right">
                <input class="kn-field kn-search" placeholder="Search…" disabled title="Coming soon" />
                <KnButton Variant="outline" Size="sm" OnClick="OpenHelp">Help</KnButton>
            </div>
        </header>
        <div class="ops-content">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool sidebarOpen;
    private bool tenantsLoading = true;
    private string? tenantsError;
    private List<SupportTenantDto> tenants = [];
    private string currentUserEmail = "";
    private string agentRole = "";
    private bool isPlatformAdmin;
    private bool helpOpen;
    private bool helpLoading;
    private string? helpError;
    private List<PlatformHelpArticleDto> helpArticles = [];
    private HashSet<string> expanded = new(StringComparer.OrdinalIgnoreCase) { "tickets-support", "engineering" };

    private sealed record NavLink(string Label, string Href, string Match);
    private sealed record NavCategory(string Id, string Label, string Icon, List<NavLink> Items, bool PlatformAdminOnly = false);

    private static readonly List<NavCategory> Categories =
    [
        new("tickets-support", "Tickets & Support", "confirmation_number",
        [
            new("Support Tickets", "/admin/support?tab=tickets", "/admin/support"),
            new("Live Chat", "/admin/support?tab=live", "/admin/support"),
            new("Escalations", "/admin/support?tab=incidents", "/admin/support"),
            new("Knowledge Base", "/admin/support?tab=kb", "/admin/support"),
            new("Internal Chat", "/admin/support?tab=internal", "/admin/support"),
        ]),
        new("engineering", "Engineering", "code",
        [
            new("Task Board", "/admin/engineering?tab=board", "/admin/engineering"),
            new("Milestones", "/admin/engineering?tab=milestones", "/admin/engineering"),
            new("GitHub Activity", "/admin/engineering?tab=github", "/admin/engineering"),
        ]),
        new("time-payroll", "Time & Payroll", "schedule",
        [
            new("Time Tracking", "/admin/time", "/admin/time"),
            new("Approvals", "/admin/time?tab=approvals", "/admin/time"),
            new("Payroll Runs", "/admin/people", "/admin/people"),
        ]),
        new("people-teams", "People & Teams", "group",
        [
            new("Users", "/admin/staff", "/admin/staff"),
            new("Teams", "/admin/teams", "/admin/teams"),
        ], PlatformAdminOnly: true),
        new("products", "Products", "inventory_2",
        [
            new("Product Registry", "/admin", "/admin"),
            new("Linked Repositories", "/admin/engineering?tab=github", "/admin/engineering"),
        ]),
        new("communication", "Communication", "forum",
        [
            new("Calendar", "/admin/calendar", "/admin/calendar"),
            new("Notifications", "/admin/platform?tab=notifications", "/admin/platform"),
        ]),
        new("resources-files", "Resources & Files", "folder",
        [
            new("File Management", "/admin/platform?tab=files", "/admin/platform"),
            new("Assets", "/admin/insights?tab=assets", "/admin/insights"),
            new("Help Center", "/admin/insights?tab=help", "/admin/insights"),
        ]),
        new("system-analytics", "System & Analytics", "analytics",
        [
            new("Audit Logs", "/admin/platform?tab=audit", "/admin/platform"),
            new("Analytics & Reports", "/admin/insights", "/admin/insights"),
            new("Integrations", "/admin/platform?tab=integrations", "/admin/platform"),
        ]),
    ];

    private string PageTitle
    {
        get
        {
            var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
            if (path.Equals("/admin", StringComparison.OrdinalIgnoreCase)) return "Overview";
            if (path.StartsWith("/admin/support", StringComparison.OrdinalIgnoreCase)) return "Support Hub";
            if (path.StartsWith("/admin/engineering", StringComparison.OrdinalIgnoreCase)) return "Engineering";
            if (path.StartsWith("/admin/time", StringComparison.OrdinalIgnoreCase)) return "Time & Approvals";
            if (path.StartsWith("/admin/people", StringComparison.OrdinalIgnoreCase)) return "People Ops";
            if (path.StartsWith("/admin/calendar", StringComparison.OrdinalIgnoreCase)) return "Calendar";
            if (path.StartsWith("/admin/platform", StringComparison.OrdinalIgnoreCase)) return "Platform";
            if (path.StartsWith("/admin/insights", StringComparison.OrdinalIgnoreCase)) return "Insights";
            if (path.StartsWith("/admin/staff", StringComparison.OrdinalIgnoreCase)) return "Users";
            if (path.StartsWith("/admin/teams", StringComparison.OrdinalIgnoreCase)) return "Teams";
            return "KobNeti";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var (user, session) = await AuthService.GetAuthenticatedAdminAsync();
        if (user == null || session == null)
        {
            Navigation.NavigateTo("/admin/login");
            return;
        }

        currentUserEmail = user.Email ?? "";
        SupportApi.TenantChanged += OnTenantChanged;
        Navigation.LocationChanged += OnLocationChanged;

        try
        {
            await RestoreSelectedTenantAsync();
            await SupportApi.EnsureAgentTokenAsync();
            agentRole = SupportApi.AgentRole;
            isPlatformAdmin = SupportApi.IsPlatformAdmin;

            var result = await SupportApi.GetTenantsAsync();
            if (!result.Success)
            {
                tenantsError = result.Message;
                tenants = [];
            }
            else
            {
                tenants = result.Data ?? [];
                ApplyTenantIfMissingFromList();
            }

            ExpandForCurrentRoute();
        }
        catch (Exception ex)
        {
            tenantsError = ex.Message;
        }
        finally
        {
            tenantsLoading = false;
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        ExpandForCurrentRoute();
        _ = InvokeAsync(StateHasChanged);
    }

    private void ExpandForCurrentRoute()
    {
        foreach (var cat in Categories)
        {
            if (cat.Items.Any(i => IsActive(i.Match)))
                expanded.Add(cat.Id);
        }
    }

    private void ToggleCat(string id)
    {
        if (!expanded.Add(id))
            expanded.Remove(id);
    }

    private Task CloseHelp()
    {
        helpOpen = false;
        return Task.CompletedTask;
    }

    private async Task OpenHelp()
    {
        helpOpen = true;
        helpLoading = true;
        helpError = null;
        try
        {
            var r = await SupportApi.GetPlatformHelpAsync();
            helpArticles = r.Data ?? [];
            if (!r.Success) helpError = r.Message;
        }
        catch (Exception ex)
        {
            helpError = ex.Message;
        }
        finally
        {
            helpLoading = false;
        }
    }

    private void OnTenantChanged() => InvokeAsync(StateHasChanged);

    private bool IsExactAdmin()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        return string.Equals(relative, "admin", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsActive(string path)
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        var target = path.Trim('/');
        if (string.Equals(target, "admin", StringComparison.OrdinalIgnoreCase))
            return string.Equals(relative, "admin", StringComparison.OrdinalIgnoreCase);
        return relative.StartsWith(target, StringComparison.OrdinalIgnoreCase);
    }

    private void ApplyTenantIfMissingFromList()
    {
        if (tenants.Count == 0) return;
        var current = tenants.FirstOrDefault(t =>
            string.Equals(t.TenantId, SupportApi.TenantId, StringComparison.OrdinalIgnoreCase));
        if (current != null)
        {
            SupportApi.SetTenant(current.TenantId, current.PublicKey, current.DisplayName, current.PublicHelpCenterUrl);
            return;
        }

        var first = tenants[0];
        SupportApi.SetTenant(first.TenantId, first.PublicKey, first.DisplayName, first.PublicHelpCenterUrl);
        _ = PersistSelectedTenantAsync(first);
    }

    private async Task RestoreSelectedTenantAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", SupportApiClient.SelectedTenantStorageKey);
            if (string.IsNullOrWhiteSpace(json)) return;
            var saved = JsonSerializer.Deserialize<SupportTenantDto>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (saved == null || string.IsNullOrWhiteSpace(saved.TenantId) || string.IsNullOrWhiteSpace(saved.PublicKey))
                return;
            SupportApi.SetTenant(saved.TenantId, saved.PublicKey, saved.DisplayName, saved.PublicHelpCenterUrl);
        }
        catch { /* keep default */ }
    }

    private async Task PersistSelectedTenantAsync(SupportTenantDto tenant)
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", SupportApiClient.SelectedTenantStorageKey, JsonSerializer.Serialize(tenant));
        }
        catch { /* non-fatal */ }
    }

    private async Task SelectTenantAsync(SupportTenantDto tenant)
    {
        SupportApi.SetTenant(tenant.TenantId, tenant.PublicKey, tenant.DisplayName, tenant.PublicHelpCenterUrl);
        await PersistSelectedTenantAsync(tenant);
        sidebarOpen = false;
    }

    private void ToggleSidebar() => sidebarOpen = !sidebarOpen;

    private async Task HandleLogout()
    {
        await AuthService.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    private string GetUserInitials()
    {
        if (string.IsNullOrEmpty(currentUserEmail)) return "?";
        var name = currentUserEmail.Split('@')[0];
        return name.Length >= 2 ? (name[0].ToString() + name[1]).ToUpperInvariant() : name.ToUpperInvariant();
    }

    private string GetUserDisplayName()
    {
        if (string.IsNullOrEmpty(currentUserEmail)) return "User";
        var name = currentUserEmail.Split('@')[0];
        return name.Length == 0 ? "User" : char.ToUpperInvariant(name[0]) + name[1..];
    }

    public void Dispose()
    {
        SupportApi.TenantChanged -= OnTenantChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
