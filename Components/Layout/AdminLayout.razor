@inherits LayoutComponentBase
@inject NavigationManager Navigation

@if (IsLoginRoute)
{
    @Body
}
else
{
    <OpsShell>
        @Body
    </OpsShell>
}

@code {
    private bool IsLoginRoute
    {
        get
        {
            var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
            return string.Equals(path, "/admin/login", StringComparison.OrdinalIgnoreCase);
        }
    }
}
