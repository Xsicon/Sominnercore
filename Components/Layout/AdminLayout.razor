@inherits LayoutComponentBase
@inject NavigationManager Navigation

@if (IsAuthShellRoute)
{
    @Body
}
else
{
    <OpsShell>
        @Body
    </OpsShell>
}

@code {
    private bool IsAuthShellRoute
    {
        get
        {
            var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
            return path.Equals("/admin/login", StringComparison.OrdinalIgnoreCase)
                   || path.Equals("/admin/reset-password", StringComparison.OrdinalIgnoreCase);
        }
    }
}
